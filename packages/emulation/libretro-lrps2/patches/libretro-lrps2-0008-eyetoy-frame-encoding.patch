From cb7c9bfa86408d929b34d508821c7f4668992e73 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Fri, 16 Oct 2026 11:39:23 +0100
Subject: [PATCH 3/3] EyeToy: fix colour and bitstream errors in camera frames

Four faults in turning camera frames into what the game decodes, all
visible once a real picture goes through them:

- RGB to YCbCr in jo_mpeg left out the chroma scale (B-Y and R-Y need
  dividing by 1.772 and 1.402). Saturated colours pushed Cb and Cr to
  about -70..326, the DC difference overflowed the nine-entry size table
  and the encoder read past it, so every JPEG camera frame with strong
  colour became an undecodable IPU stream.
- For YUYV input, chroma sample i went to CB[i/4], which packs a whole
  16-pixel row into four columns and puts every other row in the right
  half of the block. Colour landed in the wrong place horizontally.
- Escape-coded AC levels beyond +-127 kept the MPEG-1 prefix word in
  front of the MPEG-2 12-bit level, desyncing the bitstream.
- YUYV to RGB for JPEG mode treated limited-range video as full range
  and used 1.01 for the V to R gain, washing colours out and turning
  black grey.

Checked by decoding the output with ffmpeg's IPU decoder against test
patterns: 25-41 dB PSNR, where before testsrc2 managed 15.6 dB through
YUYV and testsrc did not decode at all through RGB.
---
 pcsx2/USB/usb-eyetoy/cam-linux.cpp | 17 +++++++++--------
 pcsx2/USB/usb-eyetoy/jo_mpeg.cpp   | 23 ++++++++++-------------
 2 files changed, 19 insertions(+), 21 deletions(-)

diff --git a/pcsx2/USB/usb-eyetoy/cam-linux.cpp b/pcsx2/USB/usb-eyetoy/cam-linux.cpp
index 9100ced68..cabced47c 100644
--- a/pcsx2/USB/usb-eyetoy/cam-linux.cpp
+++ b/pcsx2/USB/usb-eyetoy/cam-linux.cpp
@@ -109,21 +109,22 @@ namespace usb_eyetoy
 							const unsigned char* src = data + (y * frame_width + x) * 2;
 							unsigned char* dst = data2 + (y * frame_width + x) * bytesPerPixel;
 
-							int y1 = (int) src[0] << 8;
+							// BT.601 limited range
+							int y1 = 298 * ((int) src[0] - 16) + 128;
 							int u  = (int) src[1] - 128;
-							int y2 = (int) src[2] << 8;
+							int y2 = 298 * ((int) src[2] - 16) + 128;
 							int v  = (int) src[3] - 128;
 
-							int r  = (y1 + (259 * v) >> 8);
-							int g  = (y1 - (88 * u) - (183 * v)) >> 8;
-							int b  = (y1 + (454 * u)) >> 8;
+							int r  = (y1 + (409 * v)) >> 8;
+							int g  = (y1 - (100 * u) - (208 * v)) >> 8;
+							int b  = (y1 + (516 * u)) >> 8;
 							dst[0] = (r > 255) ? 255 : ((r < 0) ? 0 : r);
 							dst[1] = (g > 255) ? 255 : ((g < 0) ? 0 : g);
 							dst[2] = (b > 255) ? 255 : ((b < 0) ? 0 : b);
 
-							r = (y2 + (259 * v) >> 8);
-							g = (y2 - (88 * u) - (183 * v)) >> 8;
-							b = (y2 + (454 * u)) >> 8;
+							r = (y2 + (409 * v)) >> 8;
+							g = (y2 - (100 * u) - (208 * v)) >> 8;
+							b = (y2 + (516 * u)) >> 8;
 							dst[3] = (r > 255) ? 255 : ((r < 0) ? 0 : r);
 							dst[4] = (g > 255) ? 255 : ((g < 0) ? 0 : g);
 							dst[5] = (b > 255) ? 255 : ((b < 0) ? 0 : b);
diff --git a/pcsx2/USB/usb-eyetoy/jo_mpeg.cpp b/pcsx2/USB/usb-eyetoy/jo_mpeg.cpp
index 27231ed8e..1d2cf1597 100644
--- a/pcsx2/USB/usb-eyetoy/jo_mpeg.cpp
+++ b/pcsx2/USB/usb-eyetoy/jo_mpeg.cpp
@@ -162,11 +162,8 @@ static int jo_processDU(jo_bits_t *bits, float A[64], const unsigned char htdc[9
 		if(!size) {
 			jo_writeBits(bits, 1, 6);
 			jo_writeBits(bits, run, 6);
-			if (AC < -127) {
-				jo_writeBits(bits, 128, 12);
-			} else if (AC > 127) {
-				jo_writeBits(bits, 0, 12);
-			}
+			// MPEG-2 escape: one 12-bit signed level.
+			AC = AC < -2047 ? -2047 : AC > 2047 ? 2047 : AC;
 			code = AC & 0xFFF;
 			size = 12;
 		}
@@ -232,8 +229,8 @@ unsigned long jo_write_mpeg(unsigned char *mpeg_buf, const unsigned char *raw, i
 					float r, g, b;
 					r = c[0], g = c[1], b = c[2];
 					Y[i] = (0.299f*r + 0.587f*g + 0.114f*b) * (219.f/255) + 16;
-					CBx[i] = (-0.299f*r - 0.587f*g + 0.886f*b) * (224.f/255) + 128;
-					CRx[i] = (0.701f*r - 0.587f*g - 0.114f*b) * (224.f/255) + 128;
+					CBx[i] = (-0.168736f*r - 0.331264f*g + 0.5f*b) * (224.f/255) + 128;
+					CRx[i] = (0.5f*r - 0.418688f*g - 0.081312f*b) * (224.f/255) + 128;
 				}
 				// Downsample Cb,Cr (420 format)
 				for (int i=0; i<64; ++i) {
@@ -258,8 +255,8 @@ unsigned long jo_write_mpeg(unsigned char *mpeg_buf, const unsigned char *raw, i
 						r = c[0], g = c[1], b = c[2];
 					}
 					Y[i] = (0.299f*r + 0.587f*g + 0.114f*b) * (219.f/255) + 16;
-					CBx[i] = (-0.299f*r - 0.587f*g + 0.886f*b) * (224.f/255) + 128;
-					CRx[i] = (0.701f*r - 0.587f*g - 0.114f*b) * (224.f/255) + 128;
+					CBx[i] = (-0.168736f*r - 0.331264f*g + 0.5f*b) * (224.f/255) + 128;
+					CRx[i] = (0.5f*r - 0.418688f*g - 0.081312f*b) * (224.f/255) + 128;
 				}
 				// Downsample Cb,Cr (420 format)
 				for (int i=0; i<64; ++i) {
@@ -279,14 +276,14 @@ unsigned long jo_write_mpeg(unsigned char *mpeg_buf, const unsigned char *raw, i
 					const unsigned char *c = raw + y*width*2+x*2-2;
 					if (flipx) {
 						Y[i+1]  = c[0];
-						CB[i/4] = c[1];
+						CB[(i/32)*8 + (i&15)/2] = c[1];
 						Y[i]    = c[2];
-						CR[i/4] = c[3];
+						CR[(i/32)*8 + (i&15)/2] = c[3];
 					} else {
 						Y[i]    = c[2];
-						CB[i/4] = c[3];
+						CB[(i/32)*8 + (i&15)/2] = c[3];
 						Y[i+1]  = c[4];
-						CR[i/4] = c[5];
+						CR[(i/32)*8 + (i&15)/2] = c[5];
 					}
 				}
 			}
