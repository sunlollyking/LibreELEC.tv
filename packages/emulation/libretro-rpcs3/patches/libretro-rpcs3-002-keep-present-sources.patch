Keep present sources until flip is done with them

get_present_source disposes the images it makes for the display buffer,
an upload of a CPU-written buffer or a format conversion, as soon as they
exist, but flip still blits from them afterwards. A hard sync in between,
such as the libretro readback or a screenshot, completes the disposal,
and the blit then reads freed memory: heap corruption, and a crash on the
RSX thread. Dispose of them once flip has recorded its last use instead.

https://github.com/WizzardSK/rpcs3-libretro/pull/5

diff --git a/rpcs3/Emu/RSX/VK/VKGSRender.h b/rpcs3/Emu/RSX/VK/VKGSRender.h
index 1cdd033..06f936b 100644
--- a/rpcs3/Emu/RSX/VK/VKGSRender.h
+++ b/rpcs3/Emu/RSX/VK/VKGSRender.h
@@ -174,6 +174,10 @@ private:
 	vk::frame_context_t* m_current_frame = nullptr;
 	std::deque<vk::frame_context_t*> m_queued_frames;
 
+	// Present sources made for one flip, disposed once flip is done with them
+	std::vector<std::unique_ptr<vk::viewable_image>> m_present_source_conversions;
+	std::vector<std::unique_ptr<vk::viewable_image>> m_present_source_uploads;
+
 	VkViewport m_viewport {};
 	VkRect2D m_scissor {};
 
diff --git a/rpcs3/Emu/RSX/VK/VKPresent.cpp b/rpcs3/Emu/RSX/VK/VKPresent.cpp
index 9972e64..aa77481 100644
--- a/rpcs3/Emu/RSX/VK/VKPresent.cpp
+++ b/rpcs3/Emu/RSX/VK/VKPresent.cpp
@@ -465,7 +465,11 @@ vk::viewable_image* VKGSRender::get_present_source(/* inout */ vk::present_surfa
 		}
 
 		m_texture_cache.invalidate_range(*m_current_command_buffer, range, rsx::invalidation_cause::read);
-		image_to_flip = m_texture_cache.upload_image_simple(*m_current_command_buffer, expected_format, info->address, info->width, info->height, info->pitch);
+		if (auto upload = m_texture_cache.upload_image_simple(*m_current_command_buffer, expected_format, info->address, info->width, info->height, info->pitch))
+		{
+			image_to_flip = upload.get();
+			m_present_source_uploads.push_back(std::move(upload));
+		}
 	}
 	else if (image_to_flip->format() != expected_format)
 	{
@@ -490,8 +494,11 @@ vk::viewable_image* VKGSRender::get_present_source(/* inout */ vk::present_surfa
 				vk::copy_image_typeless(*m_current_command_buffer, image_to_flip, dst_img.get(), src_rect, dst_rect);
 			}
 
+			// Disposed at the end of flip, not here: a hard sync before the
+			// blit (a screenshot, or the libretro readback) would complete the
+			// disposal and free the image the blit still reads
 			image_to_flip = dst_img.get();
-			m_texture_cache.dispose_reusable_image(dst_img);
+			m_present_source_conversions.push_back(std::move(dst_img));
 		}
 	}
 
@@ -1229,6 +1236,18 @@ void VKGSRender::flip(const rsx::display_flip_info_t& info)
 		vk::change_image_layout(*m_current_command_buffer, target_image, target_layout, present_layout, subresource_range);
 	}
 
+	for (auto& image : m_present_source_conversions)
+	{
+		m_texture_cache.dispose_reusable_image(image);
+	}
+	m_present_source_conversions.clear();
+
+	for (auto& image : m_present_source_uploads)
+	{
+		vk::get_resource_manager()->dispose(image);
+	}
+	m_present_source_uploads.clear();
+
 	queue_swap_request();
 
 	m_frame_stats.flip_time = m_profiler.duration();
diff --git a/rpcs3/Emu/RSX/VK/VKTextureCache.cpp b/rpcs3/Emu/RSX/VK/VKTextureCache.cpp
index 0ecf55d..7fa7d2f 100644
--- a/rpcs3/Emu/RSX/VK/VKTextureCache.cpp
+++ b/rpcs3/Emu/RSX/VK/VKTextureCache.cpp
@@ -1614,7 +1614,7 @@ namespace vk
 		reset_frame_statistics();
 	}
 
-	vk::viewable_image* texture_cache::upload_image_simple(vk::command_buffer& cmd, VkFormat format, u32 address, u32 width, u32 height, u32 pitch)
+	std::unique_ptr<vk::viewable_image> texture_cache::upload_image_simple(vk::command_buffer& cmd, VkFormat format, u32 address, u32 width, u32 height, u32 pitch)
 	{
 		bool linear_format_supported = false;
 
@@ -1673,11 +1673,8 @@ namespace vk
 
 		vk::change_image_layout(cmd, image.get(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
 
-		// Fully dispose immediately. These immages aren't really reusable right now.
-		auto result = image.get();
-		vk::get_resource_manager()->dispose(image);
-
-		return result;
+		// Not reusable: the caller disposes of it once it has recorded its last use
+		return image;
 	}
 
 	bool texture_cache::blit(const rsx::blit_src_info& src, const rsx::blit_dst_info& dst, bool interpolate, vk::surface_cache& m_rtts, vk::command_buffer& cmd)
diff --git a/rpcs3/Emu/RSX/VK/VKTextureCache.h b/rpcs3/Emu/RSX/VK/VKTextureCache.h
index 597de75..025b24d 100644
--- a/rpcs3/Emu/RSX/VK/VKTextureCache.h
+++ b/rpcs3/Emu/RSX/VK/VKTextureCache.h
@@ -532,7 +532,7 @@ namespace vk
 
 		void on_frame_end() override;
 
-		vk::viewable_image* upload_image_simple(vk::command_buffer& cmd, VkFormat format, u32 address, u32 width, u32 height, u32 pitch);
+		std::unique_ptr<vk::viewable_image> upload_image_simple(vk::command_buffer& cmd, VkFormat format, u32 address, u32 width, u32 height, u32 pitch);
 
 		bool blit(const rsx::blit_src_info& src, const rsx::blit_dst_info& dst, bool interpolate, vk::surface_cache& m_rtts, vk::command_buffer& cmd);
 
