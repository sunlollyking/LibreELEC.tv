From 2101fd9113d00b3eb4d147f092202f43eeb44c90 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Thu, 15 Oct 2026 17:56:52 +0100
Subject: [PATCH] Mappers: keep Koei and ASCII8 SRAM writable after a state
 load

write() maps a bank switched to SRAM as writable, but loadState()
mapped it back read-only. After any state load, a frontend's run-ahead
included, the game could no longer write its SRAM, and Koei games then
report it as faulty when they start.
---
 Src/Memory/romMapperASCII8sram.c | 2 +-
 Src/Memory/romMapperKoei.c       | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Src/Memory/romMapperASCII8sram.c b/Src/Memory/romMapperASCII8sram.c
index 033d373..eab01dc 100644
--- a/Src/Memory/romMapperASCII8sram.c
+++ b/Src/Memory/romMapperASCII8sram.c
@@ -82,7 +82,7 @@ static void loadState(RomMapperASCII8sram* rm)
 
     for (i = 0; i < 4; i++) {   
         if (rm->sramEnabled & (1 << i)) {
-            slotMapPage(rm->slot, rm->sslot, rm->startPage + i, rm->sram, 1, 0);
+            slotMapPage(rm->slot, rm->sslot, rm->startPage + i, rm->sram, 1, i > 1);
         }
         else {
             slotMapPage(rm->slot, rm->sslot, rm->startPage + i, rm->romData + rm->romMapper[i] * 0x2000, 1, 0);
diff --git a/Src/Memory/romMapperKoei.c b/Src/Memory/romMapperKoei.c
index 19165a3..87f410d 100644
--- a/Src/Memory/romMapperKoei.c
+++ b/Src/Memory/romMapperKoei.c
@@ -112,7 +112,7 @@ static void loadState(RomMapperKoei* rm)
 
     for (i = 0; i < 4; i++) {   
         if (rm->sramEnabled & (1 << i)) {
-            slotMapPage(rm->slot, rm->sslot, rm->startPage + i, rm->sram + (rm->romMapper[i] & (SRAM_PAGES - 1)) * 0x2000, 1, 0);
+            slotMapPage(rm->slot, rm->sslot, rm->startPage + i, rm->sram + (rm->romMapper[i] & (SRAM_PAGES - 1)) * 0x2000, 1, i != 1);
         }
         else {
             slotMapPage(rm->slot, rm->sslot, rm->startPage + i, rm->romData + rm->romMapper[i] * 0x2000, 1, 0);
-- 
2.53.0

