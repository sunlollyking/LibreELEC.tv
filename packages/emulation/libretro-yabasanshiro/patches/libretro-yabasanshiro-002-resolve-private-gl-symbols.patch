From 24f18963ff577ae8a7fb495259fd570692c9b6ff Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Tue, 27 Oct 2026 16:25:06 +0000
Subject: [PATCH] libretro: resolve the core's own GL symbols

glsym_private.c declares the GL functions libretro-common's symbol maps
don't cover (glDispatchCompute, glBindImageTexture, glMemoryBarrier and
glPatchParameteri on GLES, glTextureBarrierNV on desktop GL), but
nothing resolved them, so they stayed NULL.

On GLES, turning on "RBG use compute shader" crashed on the first frame
with a rotation background: RBGGenerator::update() jumped to a NULL
function pointer. The calls guarded by a NULL check, such as the barrier
before drawing that reads the VDP1 framebuffer, were silently skipped.

Resolve them with the frontend's get_proc_address when the context is
reset, after glsm has resolved its own.
---
 yabause/src/libretro/glsym_private.c | 15 +++++++++++++++
 yabause/src/libretro/glsym_private.h |  2 ++
 yabause/src/libretro/libretro.c      |  6 ++++++
 3 files changed, 23 insertions(+)

diff --git a/yabause/src/libretro/glsym_private.c b/yabause/src/libretro/glsym_private.c
index a5f03cc..f7f56f2 100644
--- a/yabause/src/libretro/glsym_private.c
+++ b/yabause/src/libretro/glsym_private.c
@@ -1,3 +1,4 @@
+#include <stddef.h>
 #include "glsym/glsym.h"
 
 #if defined(_OGLES3_)
@@ -9,3 +10,17 @@ RGLSYMGLBINDIMAGETEXTUREPROC __rglgen_glBindImageTexture;
 #else
 RGLSYMGLTEXTUREBARRIERNVPROC __rglgen_glTextureBarrierNV;
 #endif
+
+#define SYM(x) { "gl" #x, &(gl##x) }
+const struct rglgen_sym_map rglgen_symbol_map_private[] = {
+#if defined(_OGLES3_)
+    SYM(MemoryBarrier),
+    SYM(BindFragDataLocation),
+    SYM(PatchParameteri),
+    SYM(DispatchCompute),
+    SYM(BindImageTexture),
+#else
+    SYM(TextureBarrierNV),
+#endif
+    { NULL, NULL },
+};
diff --git a/yabause/src/libretro/glsym_private.h b/yabause/src/libretro/glsym_private.h
index 10c5ff0..cdd78d8 100644
--- a/yabause/src/libretro/glsym_private.h
+++ b/yabause/src/libretro/glsym_private.h
@@ -45,6 +45,8 @@ typedef void (APIENTRYP RGLSYMGLTEXTUREBARRIERNVPROC) (void);
 extern RGLSYMGLTEXTUREBARRIERNVPROC __rglgen_glTextureBarrierNV;
 #endif
 
+extern const struct rglgen_sym_map rglgen_symbol_map_private[];
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/yabause/src/libretro/libretro.c b/yabause/src/libretro/libretro.c
index 52adda5..9aa9254 100644
--- a/yabause/src/libretro/libretro.c
+++ b/yabause/src/libretro/libretro.c
@@ -581,7 +581,13 @@ void YuiSwapBuffers(void)
 static void context_reset(void)
 {
 #if !defined(_USEGLEW_)
+   glsm_ctx_proc_address_t proc_info;
+
    glsm_ctl(GLSM_CTL_STATE_CONTEXT_RESET, NULL);
+   /* glsm only resolves libretro-common's map, not the core's own symbols */
+   if (glsm_ctl(GLSM_CTL_PROC_ADDRESS_GET, &proc_info))
+      rglgen_resolve_symbols_custom((rglgen_proc_address_t)proc_info.addr,
+            rglgen_symbol_map_private);
    glsm_ctl(GLSM_CTL_STATE_SETUP, NULL);
 #endif
    if (first_ctx_reset == 1)
-- 
