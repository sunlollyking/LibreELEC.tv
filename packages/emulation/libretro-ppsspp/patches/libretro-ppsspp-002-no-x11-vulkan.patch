From 53bcb587007d00b53c13f8bcfccb93e385e183c9 Mon Sep 17 00:00:00 2001
From: Chris <chris.dixon.78.burnbridge@gmail.com>
Date: Fri, 08 Aug 2026 18:35:00 +0100
Subject: [PATCH] build the Vulkan backend without X11

The unix platform defines VK_USE_PLATFORM_XLIB_KHR unconditionally, and
ext/vulkan/vulkan.h then includes <X11/Xlib.h>. A GBM or Wayland-only system has
no X11 headers, so the build stops at "X11/Xlib.h: No such file or directory".

Gate it behind NO_X11 so such systems can build. Default behaviour is unchanged.
---
diff --git a/libretro/Makefile.common b/libretro/Makefile.common
--- a/libretro/Makefile.common
+++ b/libretro/Makefile.common
@@ -619,7 +619,12 @@
 
 ifneq ($(PLATFORM_EXT), darwin)
 	ifeq ($(PLATFORM_EXT), unix)
-		COREFLAGS += -DVK_USE_PLATFORM_XLIB_KHR
+		# Only when there is an X server to talk to. A GBM or Wayland-only
+		# system has no X11/Xlib.h, and ext/vulkan/vulkan.h includes it
+		# unconditionally once this is defined.
+		ifneq ($(NO_X11), 1)
+			COREFLAGS += -DVK_USE_PLATFORM_XLIB_KHR
+		endif
 	endif
 endif
 
