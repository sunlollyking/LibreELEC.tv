From cc56f22281755054ba115dbc453de9f77fc5ce49 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Wed, 11 Nov 2026 16:12:44 +0000
Subject: [PATCH] Free the recompiler's memory when the title stops

PPCRecompiler_Shutdown freed the lookup table's blocks with
MemMapper::FreeMemory(..., true), which on Linux only takes access away,
and left the reservation and the recompiled code for the next title in
the same process to free. When the core is unloaded in between, the
pointers go with it, so every title leaks them: about 380 MB resident
plus the code with Twilight Princess HD, measured in Kodi, which keeps
running between games.
---
 .../Espresso/Recompiler/BackendX64/BackendX64.cpp   | 13 +++++++++++++
 .../HW/Espresso/Recompiler/BackendX64/BackendX64.h  |  1 +
 src/Cafe/HW/Espresso/Recompiler/PPCRecompiler.cpp   |  8 ++++++++
 src/Cafe/HW/MMU/MMU.cpp                             | 13 +++++++++++++
 src/Cafe/HW/MMU/MMU.h                               |  2 ++
 src/libretro/CemuLibretro.cpp                       |  5 +++++
 src/util/MemMapper/MemMapperUnix.cpp                |  5 +++++
 7 files changed, 47 insertions(+)

diff --git a/src/Cafe/HW/Espresso/Recompiler/BackendX64/BackendX64.cpp b/src/Cafe/HW/Espresso/Recompiler/BackendX64/BackendX64.cpp
index 4d1ae137..2db7f1eb 100644
--- a/src/Cafe/HW/Espresso/Recompiler/BackendX64/BackendX64.cpp
+++ b/src/Cafe/HW/Espresso/Recompiler/BackendX64/BackendX64.cpp
@@ -1340,6 +1340,7 @@ void PPCRecompilerX64Gen_imlInstruction_name_r(PPCRecFunction_t* PPCRecFunction,
 uint8* codeMemoryBlock = nullptr;
 sint32 codeMemoryBlockIndex = 0;
 sint32 codeMemoryBlockSize = 0;
+std::vector<std::pair<uint8*, sint32>> codeMemoryBlocks;
 
 std::mutex mtx_allocExecutableMemory;
 
@@ -1352,6 +1353,7 @@ uint8* PPCRecompilerX86_allocateExecutableMemory(sint32 size)
 		codeMemoryBlockSize = std::max(1024*1024*4, size+1024); // 4MB (or more if the function is larger than 4MB)
 		codeMemoryBlockIndex = 0;
 		codeMemoryBlock = (uint8*)MemMapper::AllocateMemory(nullptr, codeMemoryBlockSize, MemMapper::PAGE_PERMISSION::P_RWX);
+		codeMemoryBlocks.emplace_back(codeMemoryBlock, codeMemoryBlockSize);
 	}
 	uint8* codeMem = codeMemoryBlock + codeMemoryBlockIndex;
 	codeMemoryBlockIndex += size;
@@ -1364,6 +1366,17 @@ uint8* PPCRecompilerX86_allocateExecutableMemory(sint32 size)
 	return codeMem;
 }
 
+void PPCRecompilerX86_freeExecutableMemory()
+{
+	std::lock_guard<std::mutex> lck(mtx_allocExecutableMemory);
+	for (auto& [block, size] : codeMemoryBlocks)
+		MemMapper::FreeMemory(block, size, false);
+	codeMemoryBlocks.clear();
+	codeMemoryBlock = nullptr;
+	codeMemoryBlockIndex = 0;
+	codeMemoryBlockSize = 0;
+}
+
 bool PPCRecompiler_generateX64Code(PPCRecFunction_t* PPCRecFunction, ppcImlGenContext_t* ppcImlGenContext)
 {
 	x64GenContext_t x64GenContext{};
diff --git a/src/Cafe/HW/Espresso/Recompiler/BackendX64/BackendX64.h b/src/Cafe/HW/Espresso/Recompiler/BackendX64/BackendX64.h
index 8f58d2f4..aeaaede4 100644
--- a/src/Cafe/HW/Espresso/Recompiler/BackendX64/BackendX64.h
+++ b/src/Cafe/HW/Espresso/Recompiler/BackendX64/BackendX64.h
@@ -79,6 +79,7 @@ bool PPCRecompiler_generateX64Code(struct PPCRecFunction_t* PPCRecFunction, ppcI
 void PPCRecompilerX64Gen_redirectRelativeJump(x64GenContext_t* x64GenContext, sint32 jumpInstructionOffset, sint32 destinationOffset);
 
 void PPCRecompilerX64Gen_generateRecompilerInterfaceFunctions();
+void PPCRecompilerX86_freeExecutableMemory();
 
 void PPCRecompilerX64Gen_imlInstruction_fpr_r_name(PPCRecFunction_t* PPCRecFunction, ppcImlGenContext_t* ppcImlGenContext, x64GenContext_t* x64GenContext, IMLInstruction* imlInstruction);
 void PPCRecompilerX64Gen_imlInstruction_fpr_name_r(PPCRecFunction_t* PPCRecFunction, ppcImlGenContext_t* ppcImlGenContext, x64GenContext_t* x64GenContext, IMLInstruction* imlInstruction);
diff --git a/src/Cafe/HW/Espresso/Recompiler/PPCRecompiler.cpp b/src/Cafe/HW/Espresso/Recompiler/PPCRecompiler.cpp
index 139d2c8f..a61cf447 100644
--- a/src/Cafe/HW/Espresso/Recompiler/PPCRecompiler.cpp
+++ b/src/Cafe/HW/Espresso/Recompiler/PPCRecompiler.cpp
@@ -783,6 +783,14 @@ void PPCRecompiler_Shutdown()
         // mark as unmapped
         ppcRecompiler_reservedBlockMask[i] = false;
     }
+	// Freeing the blocks above only takes away access on Linux, and the
+	// pointers to the table and the code go when the core is unloaded, so
+	// without this each title run in the same process keeps its own.
+	MemMapper::FreeReservation(ppcRecompilerInstanceData, sizeof(PPCRecompilerInstanceData_t));
+	ppcRecompilerInstanceData = nullptr;
+#ifdef ARCH_X86_64
+	PPCRecompilerX86_freeExecutableMemory();
+#endif
 	s_ppcRecompilerState.recompilerEnableCount = 0;
 	s_ppcRecompilerState.initialized = false;
 }
diff --git a/src/Cafe/HW/MMU/MMU.cpp b/src/Cafe/HW/MMU/MMU.cpp
index 5b136b51..a90a8703 100644
--- a/src/Cafe/HW/MMU/MMU.cpp
+++ b/src/Cafe/HW/MMU/MMU.cpp
@@ -154,6 +154,19 @@ void memory_init()
 	}
 }
 
+void memory_release()
+{
+	if (!memory_base)
+		return;
+	for (auto& itr : g_mmuRanges)
+	{
+		if (itr->isMapped())
+			itr->unmapMem();
+	}
+	MemMapper::FreeReservation(memory_base, (size_t)0x100000000);
+	memory_base = nullptr;
+}
+
 void memory_mapForCurrentTitle()
 {
 	for (auto& itr : g_mmuRanges)
diff --git a/src/Cafe/HW/MMU/MMU.h b/src/Cafe/HW/MMU/MMU.h
index a3073ecc..4520ee16 100644
--- a/src/Cafe/HW/MMU/MMU.h
+++ b/src/Cafe/HW/MMU/MMU.h
@@ -1,6 +1,8 @@
 #pragma once
 
 void memory_init();
+// Frees the whole address space; nothing may access Wii U memory any more
+void memory_release();
 void memory_mapForCurrentTitle();
 void memory_unmapForCurrentTitle();
 void memory_logModifiedMemoryRanges();
diff --git a/src/libretro/CemuLibretro.cpp b/src/libretro/CemuLibretro.cpp
index 8f399e2f..c30a3355 100644
--- a/src/libretro/CemuLibretro.cpp
+++ b/src/libretro/CemuLibretro.cpp
@@ -6745,6 +6745,11 @@ RETRO_API void retro_deinit()
 	// handlers go back to the frontend's.
 	if (libretro_openssl_is_built_in())
 		OPENSSL_cleanup();
+	// The Wii U's address space is reserved once for every title this library
+	// runs, and what stays mapped in it between titles would outlive the
+	// library. With a GPU device still alive, something may still use it.
+	if (!s_emu_initialized && !s_gpu_context_created)
+		memory_release();
 	ExceptionHandler_Shutdown();
 
 	s_initialized = false;
diff --git a/src/util/MemMapper/MemMapperUnix.cpp b/src/util/MemMapper/MemMapperUnix.cpp
index 8e800e53..486d97fc 100644
--- a/src/util/MemMapper/MemMapperUnix.cpp
+++ b/src/util/MemMapper/MemMapperUnix.cpp
@@ -62,7 +62,12 @@ namespace MemMapper
 	void FreeMemory(void* baseAddr, size_t size, bool fromReservation)
 	{
 		if (fromReservation)
+		{
+			// As decommitting does on Windows, give the pages back: taking access
+			// away alone leaves them in memory
 			mprotect(baseAddr, size, PROT_NONE);
+			madvise(baseAddr, size, MADV_DONTNEED);
+		}
 		else
 			munmap(baseAddr, size);
 	}
-- 
