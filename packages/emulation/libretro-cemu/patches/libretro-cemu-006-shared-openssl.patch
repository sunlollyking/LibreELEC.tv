Leave a shared OpenSSL to the process

retro_deinit called OPENSSL_cleanup() for the OpenSSL built into the
core. Where the core uses the system's libcrypto, as on Linux distros,
that is the frontend's OpenSSL too, and it cannot be started again: the
frontend's HTTPS and any other core using OpenSSL failed until restart.
A later Switch core crashed decrypting its first file. Only clean up an
OpenSSL that is part of this library.

--- a/src/libretro/CemuLibretro.cpp
+++ b/src/libretro/CemuLibretro.cpp
@@ -318,6 +318,24 @@
 }
 #endif // ENABLE_OPENGL
 
+#ifndef _WIN32
+#include <dlfcn.h>
+#endif
+
+// A shared libcrypto belongs to the whole process: cleaning it up would break
+// OpenSSL for the frontend and every other core, as it cannot be started again.
+static bool libretro_openssl_is_built_in()
+{
+#ifdef _WIN32
+	return true;
+#else
+	Dl_info openssl{}, self{};
+	return dladdr(reinterpret_cast<void*>(&OPENSSL_cleanup), &openssl) &&
+		dladdr(reinterpret_cast<void*>(&libretro_openssl_is_built_in), &self) &&
+		openssl.dli_fbase == self.dli_fbase;
+#endif
+}
+
 // ============================================================================
 // CafeSystem implementation for libretro
 // ============================================================================
@@ -6719,7 +6737,8 @@
 	// no longer pins the library, and its cleanup runs here instead of at
 	// process exit, when the code would not be there any more. The crash
 	// handlers go back to the frontend's.
-	OPENSSL_cleanup();
+	if (libretro_openssl_is_built_in())
+		OPENSSL_cleanup();
 	ExceptionHandler_Shutdown();
 
 	s_initialized = false;
