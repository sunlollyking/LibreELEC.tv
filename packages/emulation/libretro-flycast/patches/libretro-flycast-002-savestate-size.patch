From 8e96b4ec2e9d0d9ed2351ada51308cf84578e3df Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Fri, 16 Oct 2026 13:55:13 +0100
Subject: [PATCH 1/2] libretro: keep savestates inside the size reported for
 them

retro_serialize_size measured the state as it stood: the TA context of
the frame in flight, and whichever Maple devices existed at that moment.
A busy frame later needed up to 8 MB more, and VMUs created just after
the first frame, when Kodi takes the size, another 130 KB each, so
retro_serialize wrote past the end of the frontend's buffer. Kodi sizes
its buffer once, as the libretro API allows, so autosaves corrupted
memory: the Counter-Strike: Condition Zero beta crashed within seconds.

When measuring, count the largest TA context, as upstream's dry run
does, and a VMU in every Maple slot; and refuse to serialize into a
buffer smaller than the state.
---
 core/hw/maple/maple_cfg.cpp |  7 +++++++
 core/hw/pvr/ta_ctx.cpp      |  6 ++++++
 core/libretro/libretro.cpp  | 12 ++++++++++--
 3 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/core/hw/maple/maple_cfg.cpp b/core/hw/maple/maple_cfg.cpp
index d22007c..61a9afc 100644
--- a/core/hw/maple/maple_cfg.cpp
+++ b/core/hw/maple/maple_cfg.cpp
@@ -337,6 +337,13 @@ void mcfg_DestroyDevice(int i, int j)
 
 void mcfg_SerializeDevices(void **data, unsigned int *total_size)
 {
+	if (*data == nullptr)
+	{
+		// Measuring: devices are created after the frontend takes the size, so leave room in
+		// every slot for the largest, a VMU (flash, LCD and decoded LCD)
+		*total_size += MAPLE_PORTS * 6 * (1 + 128 * 1024 + 192 + 48 * 32);
+		return;
+	}
 	for (int i = 0; i < MAPLE_PORTS; i++)
 		for (int j = 0; j < 6; j++)
 		{
diff --git a/core/hw/pvr/ta_ctx.cpp b/core/hw/pvr/ta_ctx.cpp
index 324be74..90b1b95 100644
--- a/core/hw/pvr/ta_ctx.cpp
+++ b/core/hw/pvr/ta_ctx.cpp
@@ -286,6 +286,12 @@ const u32 NULL_CONTEXT = ~0u;
 
 void SerializeTAContext(void **data, unsigned int *total_size)
 {
+	if (*data == nullptr)
+	{
+		// Measuring: the largest context, so the size reported for a savestate holds whatever is drawn later
+		*total_size += sizeof(u32) * 2 + TA_DATA_SIZE + sizeof(u32) * (1 + sizeof(tad_context::render_passes) / sizeof(tad_context::render_passes[0]));
+		return;
+	}
 	if (ta_ctx == nullptr)
 	{
 		LIBRETRO_S(NULL_CONTEXT);
diff --git a/core/libretro/libretro.cpp b/core/libretro/libretro.cpp
index 2efca4b..6c2514b 100644
--- a/core/libretro/libretro.cpp
+++ b/core/libretro/libretro.cpp
@@ -2168,8 +2168,16 @@ bool retro_serialize(void *data, size_t size)
     }
 #endif
 
-   result = dc_serialize(&data_ptr, &total_size) ;
-   performed_serialization = true ;
+   unsigned int needed = 0 ;
+   void *measure = NULL ;
+   dc_serialize(&measure, &needed) ;
+   if (needed > size)
+      WARN_LOG(COMMON, "Savestate needs %u bytes, the frontend's buffer holds %u", needed, (unsigned int)size) ;
+   else
+   {
+      result = dc_serialize(&data_ptr, &total_size) ;
+      performed_serialization = true ;
+   }
 
 #if !defined(TARGET_NO_THREADS)
     if (settings.rend.ThreadedRendering)
-- 
