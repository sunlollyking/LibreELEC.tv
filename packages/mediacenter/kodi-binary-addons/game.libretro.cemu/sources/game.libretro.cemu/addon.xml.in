<?xml version="1.0" encoding="UTF-8"?>
<addon id="game.libretro.cemu"
		name="Nintendo - Wii U (Cemu)"
		version="2.6.0.1"
		provider-name="Cemu Project, WizzardSK">
	<requires>
		<import addon="game.libretro" version="1.0.0"/>
		<import addon="game.controller.default" version="1.0.0"/>
	</requires>
	<extension point="kodi.gameclient"
			library_@PLATFORM@="@LIBRARY_FILENAME@">
		<platforms>Nintendo - Wii U</platforms>
		<extensions>wud|wux|wua|iso|rpx|elf|tmd</extensions>
		<supports_vfs>false</supports_vfs>
		<supports_standalone>false</supports_standalone>
		<supports_disc_control>false</supports_disc_control>
		<requires_opengl>true</requires_opengl>
		<libretro_core>cemu_libretro</libretro_core>
	</extension>
	<extension point="xbmc.addon.metadata">
		<license>MPL-2.0</license>
		<platform>@PLATFORM@</platform>
		<source>https://github.com/WizzardSK/cemu-libretro</source>
		<summary lang="en_GB">Nintendo - Wii U (Cemu)</summary>
		<description lang="en_GB">Cemu is a Nintendo Wii U emulator. This is the libretro port of it.[CR][CR]Encrypted disc images need keys.txt in the system folder's Cemu directory. It renders with OpenGL 4.5 and has no save states.</description>
	</extension>
</addon>
