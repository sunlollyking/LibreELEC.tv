<?xml version="1.0" encoding="UTF-8"?>
<addon id="game.libretro.rpcs3"
		name="Sony - PlayStation 3 (RPCS3)"
		version="0.0.43.1"
		provider-name="RPCS3 Team, WizzardSK">
	<requires>
		<import addon="game.libretro" version="1.0.0"/>
		<import addon="game.controller.ps.dualshock" version="1.0.0"/>
	</requires>
	<extension point="kodi.gameclient"
			library_@PLATFORM@="@LIBRARY_FILENAME@">
		<platforms>Sony - PlayStation 3</platforms>
		<extensions>sfb|sfo|iso|pkg</extensions>
		<supports_vfs>false</supports_vfs>
		<supports_standalone>false</supports_standalone>
		<supports_disc_control>false</supports_disc_control>
		<libretro_core>rpcs3_libretro</libretro_core>
		<savestate_features>null</savestate_features>
	</extension>
	<extension point="xbmc.addon.metadata">
		<license>GPL-2.0-only</license>
		<platform>@PLATFORM@</platform>
		<source>https://github.com/WizzardSK/rpcs3-libretro</source>
		<summary lang="en_GB">Sony - PlayStation 3 (RPCS3)</summary>
		<description lang="en_GB">RPCS3 is a Sony PlayStation 3 emulator. This is the libretro port of it.[CR][CR]It needs the PlayStation 3 firmware, PS3UPDAT.PUP, in the system folder's rpcs3 directory, and Vulkan. Games copied off a disc load from PS3_DISC.SFB. It has no save states.</description>
	</extension>
</addon>
