-
-    if (src->tex) {
-        pl_rect2df rect = {
-            .x0 = src->rect.x0,
-            .y0 = src->rect.y0,
-            .x1 = src->rect.x0 + src_w,
-            .y1 = src->rect.y0 + src_h,
