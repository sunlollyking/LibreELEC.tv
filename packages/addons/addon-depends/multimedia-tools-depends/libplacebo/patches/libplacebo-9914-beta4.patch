-                       src->rect.x0 == 0 &&
-                       src->rect.x1 == src->tex->params.w;
-        } else {
-            centered = src->new_h == src->tex->params.h &&
-                       src->rect.y0 == 0 &&
-                       src->rect.y1 == src->tex->params.h;
-        }
