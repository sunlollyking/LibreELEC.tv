-
-        *src_tex = sh_bind(sh, src->tex, src->address_mode, sample_mode,
-                           "src_tex", &rect, pos, pt);
-    } else {
-        if (pt) {
-            float sx = 1.0 / src->tex_w, sy = 1.0 / src->tex_h;
-            if (src->sampler == PL_SAMPLER_RECT)
-                sx = sy = 1.0;
-
-            *pt = sh_var(sh, (struct pl_shader_var) {
-                .var = pl_var_vec2("tex_pt"),
-                .data = &(float[2]) { sx, sy },
-            });
