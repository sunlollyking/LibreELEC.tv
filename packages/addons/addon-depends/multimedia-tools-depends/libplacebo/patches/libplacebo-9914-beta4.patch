+        if (comp->method[p] == 0 && comp->order[p] <= 2) {
+            for (int i = 0; i <= comp->order[p]; i++) coefficients[count++] = comp->poly[p][i];
+        } else if (comp->method[p] == 1 && component && comp->order[p] >= 1 && comp->order[p] <= 3) {
+            coefficients[count++] = comp->constant[p];
+            for (int o = 0; o < comp->order[p]; o++)
+                for (int t = 0; t < 7; t++) coefficients[count++] = comp->mmr[p][o][t];
+        } else {
+            return false;
+        }
+    }
+    ident_t coeff = wide_values(sh, "ref_coefficients", coefficients, count);
+    if (!coeff) return false;
+    bool narrow=true;
+    for (int i=0;i<count;i++)narrow &= coefficients[i]>=INT32_MIN && coefficients[i]<=INT32_MAX;
+    ident_t coefficient_mul=mul;
+    if (narrow) {
+        coefficient_mul=sh_fresh(sh,"ref_coefficient_mul");
+        GLSLH("uvec2 "$"(uvec2 a,uint b){int hi,lo;imulExtended(int(a.x),int(b),hi,lo);"
+              "return uvec2(uint(lo),uint(hi));}\n",coefficient_mul);
+    }
+    if (!has_color) GLSL("vec4 color;\n");
+    GLSL("{uvec3 s=clamp(uvec3(round("$"().rgb)),"$","$");uvec2 accumulator=uvec2(0u);\n", bl_signal, lower, upper);
+    bool identity=true;
+    for (int p=0;p+1<comp->num_pivots;p++)
+        identity &= comp->method[p]==0 && comp->order[p]==1 &&
+            comp->poly[p][0]==0 && comp->poly[p][1]==(INT64_C(1)<<data->denom);
+    if (identity)
+        GLSL("accumulator="$"(uvec2(s[%d],0u),%du);\n",shl,component,data->denom+20-data->bl_depth);
+    for (int p = 0; !identity && p + 1 < comp->num_pivots; p++) {
+        if (p + 2 == comp->num_pivots) GLSL(p ? "else {\n" : "{\n");
+        else GLSL("%sif(s[%d]<"$"[%d]){\n", p ? "else " : "", component, pivot, p + 1);
+        int offset = offsets[p];
+        if (comp->method[p] == 0) {
+            for (int i = 0; i <= comp->order[p]; i++) {
+                if (i == 0) GLSL("uint term0=1048576u;\n");
+                if (i == 1) GLSL("uint term1=s[%d]<<%du;\n", component, 20-data->bl_depth);
+                if (i == 2) GLSL("uint term2=(s[%d]*s[%d])<<%du;\n", component, component, 20-2*data->bl_depth);
+                GLSL("accumulator="$"(accumulator,"$"("$"[%d],term%d));\n", add, coefficient_mul, coeff, offset+i, i);
+            }
+        } else {
+            GLSL("uint t[7];t[0]=s.x<<%du;t[1]=s.y<<%du;t[2]=s.z<<%du;"
+                 "t[3]=(s.x*s.y)<<%du;t[4]=(s.x*s.z)<<%du;t[5]=(s.y*s.z)<<%du;t[6]="$"(t[3],t[2]);\n",
+                 20-data->bl_depth,20-data->bl_depth,20-data->bl_depth,
+                 20-2*data->bl_depth,20-2*data->bl_depth,20-2*data->bl_depth,qmul);
+            GLSL("accumulator="$"("$"[%d],1048576u);\n", coefficient_mul, coeff, offset);
+            GLSL("for(int j=0;j<7;j++)accumulator="$"(accumulator,"$"("$"[%d+j],t[j]));\n",add,coefficient_mul,coeff,offset+1);
+            if (comp->order[p] >= 2) {
+                GLSL("uint t2[7];for(int j=0;j<7;j++){t2[j]="$"(t[j],t[j]);"
+                     "accumulator="$"(accumulator,"$"("$"[%d+j],t2[j]));}\n",qmul,add,coefficient_mul,coeff,offset+8);
+            }
+            if (comp->order[p] >= 3)
+                GLSL("for(int j=0;j<7;j++)accumulator="$"(accumulator,"$"("$"[%d+j],"$"(t[j],t2[j])));\n",add,coefficient_mul,coeff,offset+15,qmul);
+        }
+        GLSL("}\n");
+    }
+    GLSL("if(int(accumulator.y)<0)accumulator=uvec2(0u);"
+         "uvec2 mapped="$"(accumulator,%du);uint prediction=mapped.y!=0u?65535u:min(mapped.x,65535u);int residual=0;\n",shr,4+data->denom);
+    if (data->residual) {
+        const uint64_t values[] = {data->nlq[component].slope,data->nlq[component].threshold,data->nlq[component].maximum};
+        int64_t raw[3]; memcpy(raw,values,sizeof(raw));
+        ident_t nlq = wide_values(sh,"ref_nlq",raw,3);
+        ident_t offset = sh_var_uint(sh,"ref_offset",data->nlq[component].offset,true);
+        int bits = (int)data->denom - 5 - data->el_depth;
+        uint64_t scale=UINT64_C(1)<<(11-data->el_depth);
+        uint64_t largest=UINT64_C(131071)<<(10-data->el_depth);
+        bool narrow_nlq=data->nlq[component].offset<=65535 &&
+            values[0]<=INT32_MAX/largest && values[1]<=(INT32_MAX-largest*values[0])/scale &&
+            values[2]<=(INT32_MAX>>(bits<0?-bits:0))/scale;
+        GLSL("int delta=int(round("$"().r))-int("$");if(delta!=0){int signbit=delta<0?-1:1;"
+             "int scaled=(2*delta-signbit)*%d;\n",el_signal,offset,1<<(10-data->el_depth));
+        if (narrow_nlq) {
+            GLSL("int dq=scaled*int("$"[0].x)+signbit*int("$"[1].x<<%du);"
+                 "int bound=int("$"[2].x<<%du);dq=clamp(dq,-bound,bound);"
+                 "residual=dq%s%d;}\n",nlq,nlq,11-data->el_depth,nlq,11-data->el_depth,
+                 bits>=0?">>":"<<",bits>=0?bits:-bits);
+        } else {
+            GLSL("uvec2 dq="$"("$"[0],uint(abs(scaled)));"
+                 "uvec2 threshold="$"("$"[1],%du);if(signbit<0){dq="$"(dq);threshold="$"(threshold);}"
+                 "dq="$"(dq,threshold);uvec2 bound="$"("$"[2],%du);uvec2 negative_bound="$"(bound);"
+                 "if("$"(dq,negative_bound))dq=negative_bound;else if("$"(bound,dq))dq=bound;\n",
+                 mul,nlq,shl,nlq,11-data->el_depth,
+                 neg,neg,add,shl,nlq,11-data->el_depth,neg,less,less);
+            GLSL("residual=int("$"(dq,%du).x);}\n",bits>=0?shr:shl,bits>=0?bits:-bits);
+        }
+    }
+    GLSL("int h=clamp((int(prediction)+residual+%d)>>%d,0,%d);color=vec4(float(h),float(h),float(h),1.0);}\n",
+         1<<(15-data->output_depth),16-data->output_depth,(1<<data->output_depth)-1);
+    sh_describe(sh,"integer Dolby Vision reference component");
+    return true;
+}
+
+bool pl_shader_dovi_reference_component(pl_shader sh, const struct pl_cb1_dovi_reference *data,
+                                      int component, pl_shader base, pl_shader enhancement)
+{
+    if (!base || !data || (data->residual && !enhancement)) return false;
+    ident_t bl = sh_subpass(sh,base), el = NULL_IDENT;
+    if (data->residual) el = sh_subpass(sh,enhancement);
+    return bl && (!data->residual || el) && reference_component(sh,data,component,bl,el,NULL);
+}
+
+/* Raw 4:2:0 grids, without normalization, interpolation or crop recentering. */
+static bool reference_planes(pl_shader sh, const struct pl_frame *frame,
+                             unsigned depth, ident_t raw[3])
+{
+    if (!frame || frame->num_planes < 2 || frame->num_planes > 3 ||
+        frame->field != PL_FIELD_NONE || frame->rotation || frame->crop.x0 || frame->crop.y0)
+        return false;
+    int width = frame->crop.x1, height = frame->crop.y1;
+    if (width <= 0 || height <= 0 || width % 2 || height % 2 ||
+        width != frame->crop.x1 || height != frame->crop.y1)
+        return false;
+    unsigned storage = frame->repr.bits.sample_depth;
+    unsigned shift = frame->repr.bits.bit_shift;
+    if (!storage) storage = depth;
+    if ((storage != 8 && storage != 16) || shift + depth > storage ||
+        (frame->repr.bits.color_depth && frame->repr.bits.color_depth != depth))
+        return false;
+    int chroma_phase=-1;
+    for (int p = 0; p < frame->num_planes; p++) {
+        const struct pl_plane *plane = &frame->planes[p];
+        pl_tex tex = plane->texture;
+        if (!tex || !tex->params.sampleable || tex->params.format->type != PL_FMT_UNORM)
+            return false;
+        ident_t sampler = sh_bind(sh, tex, PL_TEX_ADDRESS_CLAMP, PL_TEX_SAMPLE_NEAREST,
+                                  "ref_plane", NULL, NULL, NULL);
+        if (!sampler) return false;
+        for (int lane = 0; lane < plane->components; lane++) {
+            int c = plane->component_mapping[lane];
+            if (c < 0) continue;
+            int sw = c ? width / 2 : width, shgt = c ? height / 2 : height;
+            if (c > 2 || raw[c] || tex->params.w < sw || tex->params.h < shgt ||
+                plane->shift_x != (c ? -.5f : 0) ||
+                (plane->shift_y != 0 && (!c || plane->shift_y != -.5f)) ||
+                tex->params.format->component_depth[lane] != storage)
+                return false;
+            if(c){
+                int phase=plane->shift_y==-.5f;
+                if(chroma_phase>=0 && chroma_phase!=phase)return false;
+                chroma_phase=phase;
+            }
+            int channel = tex->params.format->sample_order[lane];
+            raw[c] = sh_fresh(sh, "ref_raw");
+            GLSLH("int "$"(ivec2 p){p=clamp(p,ivec2(0),ivec2(%d,%d));",
+                  raw[c], sw-1, shgt-1);
+            if (plane->flipped) GLSLH("p.y=%d-p.y;", shgt-1);
+            GLSLH("return int(round(texelFetch("$",p,0)[%d]*%u.0))>>%uu;}\n",
+                  sampler, channel, (1u<<storage)-1, shift);
+        }
+    }
+    return raw[0] && raw[1] && raw[2];
+}
+
+static ident_t reference_el_vertical(pl_shader sh, ident_t raw, bool chroma)
+{
+    ident_t vertical = sh_fresh(sh,"ref_el_vertical");
+    if (chroma) {
+        GLSLH("int "$"(ivec2 p){int y=p.y/2;int s=(p.y&1)==0?"
+              "64*"$"(ivec2(p.x,y-1))+192*"$"(ivec2(p.x,y)):"
+              "192*"$"(ivec2(p.x,y))+64*"$"(ivec2(p.x,y+1));"
+              "return clamp((s+128)>>8,0,65535);}\n",vertical,raw,raw,raw,raw);
+    } else {
+        GLSLH("int "$"(ivec2 p){int y=p.y/2;int s=(p.y&1)==0?"
+              "-3*"$"(ivec2(p.x,y-2))+29*"$"(ivec2(p.x,y-1))+111*"$"(ivec2(p.x,y))-9*"$"(ivec2(p.x,y+1)):"
+              "-9*"$"(ivec2(p.x,y-1))+111*"$"(ivec2(p.x,y))+29*"$"(ivec2(p.x,y+1))-3*"$"(ivec2(p.x,y+2));"
+              "return clamp((s+64)>>7,0,65535);}\n",vertical,raw,raw,raw,raw,raw,raw,raw,raw);
+    }
+    return vertical;
+}
+
+bool sh_dovi_reference_el_vertical(pl_shader sh, const struct pl_cb1_dovi_reference *data,
+                                   const struct pl_frame *image, bool chroma)
+{
+    if (!data || !data->residual || !image || !image->enhancement_layer ||
+        !sh_require(sh,PL_SHADER_SIG_NONE,0,0)) return false;
+    ident_t raw[3]={0};
+    if (!reference_planes(sh,image->enhancement_layer,data->el_depth,raw)) return false;
+    GLSL("vec4 color=vec4(0.0,0.0,0.0,1.0);\n");
+    for (int c=chroma?1:0;c<(chroma?3:1);c++) {
+        ident_t vertical=reference_el_vertical(sh,raw[c],chroma);
+        GLSL("color[%d]=float("$"(ivec2(gl_FragCoord.xy)));\n",chroma?c-1:0,vertical);
+    }
+    return true;
+}
+
+static ident_t reference_el_horizontal(pl_shader sh, pl_tex texture, ident_t sampler, int lane)
+{
+    ident_t vertical=sh_fresh(sh,"ref_el_cached");
+    GLSLH("int "$"(ivec2 p){p=clamp(p,ivec2(0),ivec2(%d,%d));"
+          "return int(texelFetch("$",p,0)[%d]);}\n",
+          vertical,texture->params.w-1,texture->params.h-1,sampler,lane);
+    ident_t horizontal = sh_fresh(sh,"ref_el_horizontal");
+    GLSLH("int "$"(ivec2 p){int x=p.x/2;if((p.x&1)==0)return "$"(ivec2(x,p.y));int s=0;\n",horizontal,vertical);
+    const int weights[8] = {22,94,-524,2456,2456,-524,94,22};
+    for (int t=0;t<8;t++)
+        GLSLH("s+=%d*"$"(ivec2(x+%d,p.y));\n",weights[t],vertical,t-3);
+    GLSLH("return clamp((s+2048)>>12,0,65535);}\n");
+    return horizontal;
+}
+
+bool sh_dovi_reference_grid(pl_shader sh, const struct pl_cb1_dovi_reference *data,
+                            const struct pl_frame *image, bool chroma, pl_tex vertical)
+{
+    if (!data || !image || !sh_require(sh,PL_SHADER_SIG_NONE,0,0)) return false;
+    GLSL("vec4 color;\n");
+    ident_t raw[3]={0}, el[3]={0};
+    if (!reference_planes(sh,image,data->bl_depth,raw)) return false;
+    if (data->residual) {
+        const struct pl_frame *enhancement=image->enhancement_layer;
+        if (!reference_planes(sh,enhancement,data->el_depth,el)) return false;
+        int phase[2]={-1,-1};
+        for(int f=0;f<2;f++){
+            const struct pl_frame *layer=f?enhancement:image;
+            for(int p=0;p<layer->num_planes;p++)
+                for(int c=0;c<layer->planes[p].components;c++)
+                    if(layer->planes[p].component_mapping[c]>0)
+                        phase[f]=layer->planes[p].shift_y==-.5f;
+        }
+        if(phase[0]!=phase[1])return false;
+        bool resize=enhancement->crop.x1*2==image->crop.x1 && enhancement->crop.y1*2==image->crop.y1;
+        if (!resize && (enhancement->crop.x1!=image->crop.x1 || enhancement->crop.y1!=image->crop.y1))
+            return false;
+        if (resize) {
+            if (!vertical) return false;
+            ident_t sampler=sh_bind(sh,vertical,PL_TEX_ADDRESS_CLAMP,PL_TEX_SAMPLE_NEAREST,
+                                    "ref_el_vertical",NULL,NULL,NULL);
+            if (!sampler) return false;
+            for (int c=chroma?1:0;c<(chroma?3:1);c++) {
+                el[c]=reference_el_horizontal(sh,vertical,sampler,chroma?c-1:0);
+            }
+        }
+    }
+    ident_t signal=sh_fresh(sh,"ref_bl_signal");
+    ident_t position=sh_attr_vec2(sh,"ref_grid_position",&(pl_rect2df){0,0,
+        image->crop.x1/(chroma?2:1),image->crop.y1/(chroma?2:1)});
+    if (!position) return false;
+    GLSLH("vec4 "$"(){ivec2 p=ivec2("$");",signal,position);
+    if (chroma) {
+        GLSLH("int a=("$"(ivec2(2*p.x-1,2*p.y))+2*"$"(ivec2(2*p.x,2*p.y))+"$"(ivec2(2*p.x+1,2*p.y))+2)>>2;"
+              "int b=("$"(ivec2(2*p.x-1,2*p.y+1))+2*"$"(ivec2(2*p.x,2*p.y+1))+"$"(ivec2(2*p.x+1,2*p.y+1))+2)>>2;"
+              "return vec4(float((a+b+1)>>1),float("$"(p)),float("$"(p)),1.0);}\n",
+              raw[0],raw[0],raw[0],raw[0],raw[0],raw[0],raw[1],raw[2]);
+    } else {
+        GLSLH("return vec4(float("$"(p)),float("$"(p/2)),float("$"(p/2)),1.0);}\n",raw[0],raw[1],raw[2]);
+    }
+    uint32_t lows[3],highs[3];
+    for (int c=0;c<3;c++) {
+        if (data->comp[c].num_pivots<2 || data->comp[c].num_pivots>9) return false;
+        lows[c]=data->comp[c].pivots[0];
+        highs[c]=data->comp[c].pivots[data->comp[c].num_pivots-1];
+    }
+    ident_t bounds[2]={
+        sh_var(sh,(struct pl_shader_var){.var=pl_var_uvec3("ref_low"),.data=lows,.dynamic=true}),
+        sh_var(sh,(struct pl_shader_var){.var=pl_var_uvec3("ref_high"),.data=highs,.dynamic=true})};
+    for (int c=chroma?1:0;c<(chroma?3:1);c++) {
+        ident_t esig=NULL_IDENT;
+        if (data->residual) {
+            esig=sh_fresh(sh,"ref_el_signal");
+            GLSLH("vec4 "$"(){return vec4(float("$"(ivec2("$"))));}\n",esig,el[c],position);
+        }
+        if (!reference_component(sh,data,c,signal,esig,bounds)) return false;
+        if (chroma && c==1) GLSL("float ref_cb=color.r;\n");
+    }
+    if (chroma) GLSL("color=vec4(ref_cb,color.r,0.0,1.0);\n");
+    return true;
+}
+
+bool sh_dovi_reference_chroma(pl_shader sh, pl_tex chroma, unsigned depth, bool top_left)
+{
+    if ((depth!=10 && depth!=12) || !sh_require(sh,PL_SHADER_SIG_NONE,0,0)) return false;
+    ident_t c=sh_bind(sh,chroma,PL_TEX_ADDRESS_CLAMP,PL_TEX_SAMPLE_NEAREST,"ref_c",NULL,NULL,NULL);
+    if (!c) return false;
+    ident_t fetch=sh_fresh(sh,"ref_chroma");
+    GLSLH("ivec2 "$"(ivec2 p){p=clamp(p,ivec2(0),ivec2(%d,%d));return ivec2(round(texelFetch("$",p,0).rg));}\n",
+          fetch,chroma->params.w-1,chroma->params.h-1,c);
+    GLSL("ivec2 p=ivec2(gl_FragCoord.xy);ivec2 uv=ivec2(0);\n");
+    const int weights[2][6]={{2,-12,65,222,-25,4},{4,-25,222,65,-12,2}};
+    const int half[8]={22,94,-524,2456,2456,-524,94,22};
+    for (int phase=0;phase<2;phase++) {
+        GLSL("%s((p.y&1)==%d){\n",phase?"else if":"if",phase);
+        int count=top_left?(phase?8:1):6;
+        for (int i=0;i<count;i++)
+            GLSL("uv+=%d*"$"(ivec2(p.x,p.y/2+%d));\n",
+                 top_left?(phase?half[i]:1):weights[phase][i],fetch,
+                 top_left?(phase?i-3:0):i-3+phase);
+        int bits=top_left?(phase?12:0):8;
+        if(bits)GLSL("uv=(uv+ivec2(%d))>>%d;\n",1<<(bits-1),bits);
+        GLSL("}\n");
+    }
+    GLSL("vec4 color=vec4(vec2(clamp(uv,ivec2(0),ivec2(%u))),0.0,1.0);\n",(1u<<depth)-1);
+    return true;
+}
+
+bool sh_dovi_reference_output(pl_shader sh, pl_shader luma, pl_tex chroma, unsigned depth, int w, int h)
+{
+    if ((depth!=10 && depth!=12) || !sh_require(sh,PL_SHADER_SIG_NONE,0,0)) return false;
+    ident_t y=sh_subpass(sh,luma);
+    ident_t c=sh_bind(sh,chroma,PL_TEX_ADDRESS_CLAMP,PL_TEX_SAMPLE_NEAREST,"ref_c",NULL,NULL,NULL);
+    if (!y || !c) return false;
+    ident_t position=sh_attr_vec2(sh,"ref_position",&(pl_rect2df){0,0,w,h});
+    if (!position) return false;
+    GLSL("ivec2 p=ivec2("$");vec4 color=vec4("$"().r,"
+         "texelFetch("$",ivec2(p.x/2,p.y),0).rg,%u.0)/%u.0;\n",
+         position,y,c,(1u<<depth)-1,(1u<<depth)-1);
+    return true;
+}
