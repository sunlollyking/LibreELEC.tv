+static void cb1_colour_dense_eotf(pl_shader sh)
+{
+    if (SH_PARAMS(sh).cb1_stable_pq) {
+        cb1_pq_eotf(sh,"color.rgb");
+    } else {
+        GLSL("color.rgb = pow(max(color.rgb, 0.0), vec3(1.0/%f));   \n"
+             "color.rgb = max(color.rgb - vec3(%f), 0.0)            \n"
+             "             / (vec3(%f) - vec3(%f) * color.rgb);     \n"
+             "color.rgb = pow(color.rgb, vec3(1.0/%f));             \n",
+             PQ_M2, PQ_C1, PQ_C2, PQ_C3, PQ_M1);
+    }
+}
+
+static bool cb1_colour_lookup(pl_shader sh, const struct pl_cb1_dovi_processing *p,
+                              bool encode)
+{
+    if (!p || !(p->groups & 8) || !p->pq_texture[encode]) return false;
+    ident_t lut=sh_bind(sh,p->pq_texture[encode],PL_TEX_ADDRESS_CLAMP,
+                       PL_TEX_SAMPLE_LINEAR,"cb1_colour_lut",NULL,NULL,NULL);
+    if (!encode) GLSL("vec3 cb1_pq_source=color.rgb;bool cb1_decode_coarse=false;\n");
+    /* Per-fragment refinement is bounded: out-of-domain values stay dense. */
+    GLSL("if (all(greaterThan(color.rgb, vec3("$"))) && "
+         "all(lessThan(color.rgb, vec3("$")))) {\n",
+         SH_FLOAT(encode ? 0.0000152587890625 : 0.02), SH_FLOAT(encode ? 0.95 : 0.98));
+    if (encode) GLSL("vec3 cb1_pos=sqrt(sqrt(color.rgb));\n");
+    else GLSL("cb1_decode_coarse=true;vec3 cb1_pos=color.rgb;\n");
+    GLSL("cb1_pos=(cb1_pos*4095.0+vec3(0.5))/4096.0;\n"
+         "color.rgb=vec3(texture("$",vec2(cb1_pos.r,0.5)).r,\n"
+         "texture("$",vec2(cb1_pos.g,0.5)).r,texture("$",vec2(cb1_pos.b,0.5)).r);\n"
+         "} else {\n",lut,lut,lut);
+    return true;
+}
