+    GLSL("ivec2 p=ivec2("$");int row=p.y/2;bool odd=(p.y&1)!=0;"
+         "vec2 a="$"(ivec2(p.x/2,row+(odd?-1:-2)));"
+         "vec2 d="$"(ivec2(p.x/2,row+(odd?-2:2)));"
+         "vec2 e="$"(ivec2(p.x/2,row+(odd?2:1)));"
+         "vec2 pos=vec2(float(p.x/2)+.5,float(row)+(odd?53.0/283.0:230.0/283.0)-float(!odd)+.5)/vec2(%d.0,%d.0);"
+         "vec2 b=texture("$",pos).rg*4095.0;"
+         "vec2 uv=clamp(floor((-(odd?27.0:4.0)*a+283.0*b-(odd?4.0:27.0)*e+4.0*d)/256.0+.5),0.0,4095.0);"
