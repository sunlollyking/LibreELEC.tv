From: CroqueMr
Subject: [PATCH] libreelec-x86-DV R1.0.0 RC1.1: HDR10+ country code

https://github.com/CroqueMr/libreelec-x86-DV/releases/tag/R1.0.0-RC1.1
---
diff --git a/libavcodec/itut35.c b/libavcodec/itut35.c
--- a/libavcodec/itut35.c
+++ b/libavcodec/itut35.c
@@ -237,6 +237,7 @@ int ff_itut_t35_parse_payload_to_struct(FFITUTT35 *const itut_t35, FFITUTT35Aux *const
                 return ret;
             }
 
+            hdr_plus->itu_t_t35_country_code = itut_t35->country_code;
             av_buffer_unref(&metadata->hdr_plus);
             metadata->hdr_plus = av_buffer_create((uint8_t *)hdr_plus, size, NULL, NULL, 0);
             if (!metadata->hdr_plus) {
