@@ -0,0 +1,173 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <atomic>
+#include <string>
+#include <sstream>
+#include <bitset>
+#include <array>
+#include <cstdint>
+#include "utils/DVBridgeLldv.h"
+
+namespace DVBRIDGE
+{
+enum class OutputReason { None, NoDVTransport, NoHDR10Transport,
+  NoGPUProcessing, SourceIneligible, TVProfileRequired, ActivationFailed, RestoreFailed,
+  NoHDR10PlusTransport, SDRTargetInvalid, ProcessingPending, NoPlayerLedTransport, HDR10LinkDepthTooLow };
+struct ModeAdmission { bool usable{}; OutputReason reason{OutputReason::None}; };
+struct OutputCapabilities
+{
+  bool sourceKnown{}, isDV{}, processingKnown{}, nativeDV{}, hdr10{};
+  bool stereoSource{};
+  uint64_t generation{};
+  std::array<ModeAdmission, 9> processing{};
+  bool isHLG{}; // Plain HLG only: Dolby Vision RPU/configuration takes precedence.
+  bool isHDR10{};
+  bool hdr10PlusSource{}; // Native source classification, independent of metadata admission.
+  bool isHDR10Plus{}; // Selected decoded picture, not receiver HDR10+ transport.
+  std::array<ModeAdmission, 9> hdr10Processing{};
+  bool hdr10plus{}, playerLed{};
+  LldvDisplay lldvDisplay;
+  uint64_t lldvEdidGeneration{};
+  unsigned lldvRgbScanoutBits{8};
+  int lldvUnavailableLabel{41280};
+  uint64_t hdr10MaxBpc{}; // Zero means the HDMI ceiling is unknown.
+
+  bool HDR10DepthLimited() const { return hdr10MaxBpc != 0 && hdr10MaxBpc < 10; }
+};
+}
+
+// The render thread publishes one coherent snapshot only after presentation.
+// This is output telemetry, never a source-format or TV certification flag.
+struct CDVPlaybackInfo
+{
+  template<class Output> static bool IsHDR10AI(const Output& output)
+  {
+    if constexpr (requires { output.hdr10AI; }) return output.hdr10AI;
+    return false;
+  }
+  template<class Output> static bool IsHDR10PlusDV(const Output& output)
+  {
+    if constexpr (requires { output.hdr10PlusDV; }) return output.hdr10PlusDV;
+    return false;
+  }
+  enum : unsigned { HDMI = 1, FEL = 2, CM4 = 4, HDR10 = 8, HDR10PLUS = 16, SDR = 32 };
+  static constexpr int PlayerLedMode = 9;
+  inline static std::atomic<unsigned> presented{0};
+  static int ReasonLabel(DVBRIDGE::OutputReason reason)
+  { return reason == DVBRIDGE::OutputReason::HDR10LinkDepthTooLow ? 41223 :
+      reason == DVBRIDGE::OutputReason::NoPlayerLedTransport ? 41222 :
+      reason == DVBRIDGE::OutputReason::ProcessingPending ? 41142 :
+      reason == DVBRIDGE::OutputReason::SDRTargetInvalid ? 41141 :
+      reason == DVBRIDGE::OutputReason::NoHDR10PlusTransport ? 40923 :
+      reason == DVBRIDGE::OutputReason::None ? 0 : 41824 + static_cast<int>(reason); }
+
+  static const char* Reason(DVBRIDGE::OutputReason reason)
+  {
+    switch(reason)
+    {
+      case DVBRIDGE::OutputReason::NoPlayerLedTransport: return "no-player-led-transport";
+      case DVBRIDGE::OutputReason::NoDVTransport: return "no-dv-transport";
+      case DVBRIDGE::OutputReason::NoHDR10Transport: return "no-hdr10-transport";
+      case DVBRIDGE::OutputReason::HDR10LinkDepthTooLow: return "hdr10-link-depth-too-low";
+      case DVBRIDGE::OutputReason::NoGPUProcessing: return "gpu-processing-unavailable";
+      case DVBRIDGE::OutputReason::SourceIneligible: return "source-ineligible";
+      case DVBRIDGE::OutputReason::TVProfileRequired: return "tv-profile-required";
+      case DVBRIDGE::OutputReason::SDRTargetInvalid: return "sdr-target-invalid";
+      case DVBRIDGE::OutputReason::ProcessingPending: return "processing-pending";
+      case DVBRIDGE::OutputReason::ActivationFailed: return "activation-failed";
+      case DVBRIDGE::OutputReason::RestoreFailed: return "restoration-failed";
+      case DVBRIDGE::OutputReason::NoHDR10PlusTransport: return "no-hdr10plus-transport";
+      default: return "none";
+    }
+  }
+
+  static std::string Detail(std::string source, unsigned output)
+  {
+    if (!(output & (HDMI | HDR10)))
+      return source;
+    if ((output & FEL) && source.find("FEL") == std::string::npos)
+      source += " FEL";
+    source += (output & CM4) ? " · CM4 metadata" : " · CM2.9 metadata";
+    return source + ((output & HDR10) ? " · HDR10 Rendering" : " · HDMI Dolby Vision");
+  }
+
+  template<class Output> static const char* Policy(const Output& output)
+  {
+    if (IsHDR10PlusDV(output)) return "Dolby Vision : Rendering";
+    switch (output.effective)
+    {
+      case 2: return "HDR10 : Rendering";
+      case 3: return "HDR10 : LLDV Reference conversion";
+      case 4: return "Dolby Vision : Adaptive HDR Mapping";
+      case 5: return "Dolby Vision : Master Reference";
+      case 6: return "Dolby Vision : Adaptive HDR Mapping";
+      case 8: return "SDR : Conversion";
+      case 7: return output.flags & HDR10PLUS ? "HDR10+ : Conversion" : "HDR10 : Rendering";
+      default: return output.flags & HDR10 ? "HDR10 : Rendering" : "Dolby Vision : Reference";
+    }
+  }
+  static const char* RequestedPolicy(int mode, bool hdr10AI = false, bool hdr10PlusDV = false)
+  {
+    if ((hdr10PlusDV || hdr10AI) && mode == 1) return "Dolby Vision : Rendering";
+    switch(mode)
+    {
+      case 0:return "Kodi : Default";
+      case 1:return "Dolby Vision : Reference";
+      case 2:return "HDR10 : Rendering";
+      case 3:return "HDR10 : LLDV Reference conversion";
+      case 4:return "Dolby Vision : Adaptive HDR Mapping";
+      case 5:return "Dolby Vision : Master Reference";
+      case 6:return "Dolby Vision : Adaptive HDR Mapping";
+      case 7:return "HDR10+ : Conversion";
+      case 8:return "SDR : Conversion";
+      case PlayerLedMode:return "Dolby Vision : LLDV Reference";
+      default:return "";
+    }
+  }
+
+  template<class Output> static std::string Mode(const Output& output)
+  {
+    if (output.effective==8 && (output.flags & SDR)) return "SDR : Conversion";
+    if (!output.flags) return "Kodi default";
+    if constexpr (requires { output.lldv; })
+      if (output.lldv) return RequestedPolicy(PlayerLedMode);
+    if (IsHDR10PlusDV(output)) return Policy(output);
+    std::string mode = output.flags & HDR10 ? Policy(output) :
+        output.effective == 6 ? "Dolby Vision : Adaptive HDR Mapping" :
+        output.effective == 5 ? "Dolby Vision : Master Reference" :
+        output.effective == 4 ? "Dolby Vision : Adaptive HDR Mapping" : "Dolby Vision : Reference";
+    if (output.fallback)
+      mode += " / compatibility fallback";
+    return mode;
+  }
+
+  static std::string Blocks(const std::bitset<256>& blocks)
+  {
+    std::string text;
+    for(unsigned level=0;level<blocks.size();++level)
+      if(blocks[level]) text+=(text.empty() ? "" : " ")+std::string("L")+std::to_string(level);
+    return text;
+  }
+
+  static std::string Transport(uint32_t format)
+  {
+    switch(format)
+    {
+      case 0x34325258: case 0x34325241: return "RGB 4:4:4 / 8-bit";
+      case 0x30335258: case 0x30335241:
+      case 0x30334258: case 0x30334241: return "RGB 4:4:4 / 10-bit";
+      case 0x48344241: return "RGB 4:4:4 / 16-bit float";
+      default: return ""; // Unknown negotiated format is unavailable, never guessed.
+    }
+  }
+
+  template<class Output> static std::string Detail(std::string source, const Output& output)
+  {
+    if (!output.flags) return source;
+    if ((output.flags & FEL) && source.find("FEL") == std::string::npos) source += " FEL";
+    if (!(output.flags & SDR))
+      source += output.flags & CM4 ? " · CM4 metadata" : " · CM2.9 metadata";
+    source += " · " + Mode(output);
+    return source;
+  }
+};
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackNotification.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackNotification.h
new file mode 100644
index 0000000000..94ec9d7e44
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackNotification.h
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#ifdef HAVE_DVBRIDGE
+#include "DVOutputSettings.h"
+#include "DVPlaybackInfo.h"
+#include "DVMetadataBuffer.h"
+#include <atomic>
+#include <mutex>
+#include <string>
+
+namespace DVBRIDGE
+{
+// File lifecycle arms once. Only accepted presentation consumes the message.
+class PlaybackNotification
+{
+public:
+  static bool Pending() { return m_pending.load(std::memory_order_relaxed); }
+  static uint64_t Generation() { return Pending() ? m_generation.load(std::memory_order_relaxed) : 0; }
+  static void StartVideo()
+  {
+    const auto component=CServiceBroker::GetSettingsComponent();
+    const auto settings=component ? component->GetSettings() : nullptr;
+    const bool enabled=settings && settings->GetBool("dvbridge.startupmode");
+    std::lock_guard lock(m_mutex);
+    m_generation.fetch_add(1,std::memory_order_relaxed);
+    m_nativeFloor=nativeRevision.load(std::memory_order_relaxed);
+    m_ordinaryFrame=false;
+    m_nativeFrame={};
+    m_pending.store(enabled,std::memory_order_relaxed);
+  }
+  static void StopVideo()
+  {
+    std::lock_guard lock(m_mutex);
+    m_ordinaryFrame=false;
+    m_nativeFrame={};
+    m_pending.store(false,std::memory_order_relaxed);
+  }
+  static void RenderedOrdinary(uint64_t generation)
+  {
+    if (!generation || !Pending()) return;
+    std::lock_guard lock(m_mutex);
+    if (!Pending() || generation!=m_generation.load(std::memory_order_relaxed)) return;
+    m_nativeFrame={};
+    m_ordinaryFrame=true;
+  }
+  static void RenderedNative(uint64_t generation,const SourceBinding& binding)
+  {
+    if (!Pending()) return;
+    std::lock_guard lock(m_mutex);
+    m_nativeFrame={};
+    m_ordinaryFrame=false;
+    if (generation && generation==m_generation.load(std::memory_order_relaxed) && binding.Valid())
+      m_nativeFrame=binding;
+  }
+  static void OrdinaryOutputAccepted(bool accepted)
+  {
+    if (!Pending()) return;
+    {
+      std::lock_guard lock(m_mutex);
+      const bool notify=accepted && m_ordinaryFrame && m_pending.exchange(false);
+      m_ordinaryFrame=false;
+      if (!notify) return;
+    }
+    Emit("Kodi : Default");
+  }
+  template<class Output> static void NativeOutputAccepted(const Output& output)
+  {
+    if (!Pending()) return;
+    if (!(output.flags & (CDVPlaybackInfo::HDMI | CDVPlaybackInfo::HDR10 | CDVPlaybackInfo::SDR))) return;
+    {
+      std::lock_guard lock(m_mutex);
+      if (!output.picture || output.stream<=m_nativeFloor) return;
+      if (output.stream!=m_nativeFrame.stream || output.picture!=m_nativeFrame.picture) return;
+      if (!m_pending.exchange(false)) return;
+      m_ordinaryFrame=false;
+      m_nativeFrame={};
+    }
+#ifdef CB1_HAS_HDR10_AI
+    if constexpr (requires { output.hdr10AI; })
+      if (output.hdr10AI)
+      {
+        if (CDVPlaybackInfo::IsHDR10PlusDV(output))
+        {
+          Emit(CDVPlaybackInfo::Mode(output));
+          return;
+        }
+        EmitAI(output.effective);
+        return;
+      }
+#endif
+    Emit(CDVPlaybackInfo::Mode(output));
+  }
+  static void Emit(const std::string& text);
+  static void EmitAI(int mode);
+private:
+  inline static std::atomic<bool> m_pending{false};
+  inline static std::atomic<uint64_t> m_generation{0};
+  inline static std::mutex m_mutex;
+  inline static bool m_ordinaryFrame{};
+  inline static uint64_t m_nativeFloor{};
+  inline static SourceBinding m_nativeFrame{};
+};
+}
+#endif
