@@ -0,0 +1,286 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "HDR10AISource.h"
+#include "utils/DVBridgeDiagnosticState.h"
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <limits>
+
+HDR10AISource::~HDR10AISource() { cb1_hdr10_ai_destroy(&m_context); }
+
+void HDR10AISource::ReleaseRetired()
+{
+  m_job = m_active = m_fallback = m_resetPending = false;
+  m_lease.reset();
+  m_prepared.reset();m_committed.reset();
+  m_preparedHDR10Plus.reset();m_committedHDR10Plus.reset();m_metadataOnly=false;
+  m_activation.Stop();
+}
+
+bool HDR10AISource::Matches(DVBRIDGE::SourceBinding binding) const
+{
+  return m_active && binding.Valid() && binding.stream == m_binding.stream &&
+      binding.revision == m_binding.revision;
+}
+
+cb1_ai_identity HDR10AISource::Identity(DVBRIDGE::SourceBinding binding) const
+{
+  return {binding.stream,binding.picture,m_revision};
+}
+
+cb1_ai_status HDR10AISource::Collect()
+{
+  if (!m_job) return CB1_AI_READY;
+  const auto status = cb1_hdr10_ai_submit(m_context,nullptr,m_jobIdentity,m_jobPts);
+  if (status == CB1_AI_READY)
+  {
+    m_job = false;
+    m_lastSubmitted = m_jobIdentity.picture;
+    m_activation.AnalysisCompleted(m_jobIdentity, DVBRIDGE::DiagnosticNowMs());
+    m_lease.reset();
+  }
+  return RecordStatus("analysis-collect",status);
+}
+
+cb1_ai_status HDR10AISource::Begin(pl_gpu gpu, const char* bundle,
+    const DVBRIDGE::OutputPreferences& preferences, DVBRIDGE::SourceBinding binding,
+    double pts, uint64_t now, bool buffered, bool metadataOnly)
+{
+  if (!binding.Valid() || !std::isfinite(pts) || !gpu)
+    return RecordStatus("analysis-begin",CB1_AI_INVALID);
+  if (m_gpu && m_gpu != gpu)
+    return RecordStatus("analysis-begin",CB1_AI_INCOMPATIBLE);
+  if (!m_resetPending || !Current(binding,preferences))
+  {
+    m_diagnosticStage = "none";
+    m_diagnosticStatus = CB1_AI_READY;
+    m_diagnosticFailure = false;
+    m_preferences = preferences;
+    m_binding = binding;
+    m_origin = pts;
+    m_revision = DVBRIDGE::NextRevisionAfter(std::max(preferences.revision,binding.revision));
+    m_prepared.reset();m_committed.reset();m_preparedBinding = {};
+    m_preparedHDR10Plus.reset();m_committedHDR10Plus.reset();
+    m_metadataOnly=metadataOnly;
+    m_fallback = false;
+    m_active = preferences.hdr10Source != DVBRIDGE::HDR10SourceMode::Native;
+    m_resetPending = true;
+    if (m_active)
+    {
+      m_activation.Begin(binding.stream,m_revision,now);
+      if (!buffered) m_activation.WaitForInput();
+      m_activation.SetPaused(m_paused,now);
+    }
+    else m_activation.Stop();
+  }
+  if (m_fallback) return CB1_AI_INCOMPATIBLE;
+  if (buffered) m_activation.InputReady(now);
+  // A policy/seek reset must not release a decoder surface still read by the GPU.
+  if (m_job)
+  {
+    const auto status = Collect();
+    if (status != CB1_AI_READY)
+    {
+      // Terminal work belongs to the retiring source. The context owner
+      // fences it before releasing its lease and starting the new source.
+      if (status != CB1_AI_PENDING)
+        return CB1_AI_INVALID;
+      if (m_active && m_activation.Observe(status,Identity(binding),now) == Decision::Native)
+      {
+        m_fallback = true;
+        return CB1_AI_INCOMPATIBLE;
+      }
+      return CB1_AI_PENDING;
+    }
+  }
+  m_resetPending = false;
+  m_job = false;
+  m_lastSubmitted = 0;
+  if (!m_active)
+  {
+    cb1_hdr10_ai_destroy(&m_context);
+    m_gpu = nullptr;
+    m_activation.Stop();
+    return CB1_AI_READY;
+  }
+  if(m_metadataOnly)
+  {
+    // The context owner retired prior GPU use before selecting this strategy.
+    cb1_hdr10_ai_destroy(&m_context);
+    m_gpu=nullptr;
+    return CB1_AI_READY;
+  }
+  auto status = CB1_AI_READY;
+  if (!m_context)
+    status = cb1_hdr10_ai_create(gpu,bundle,&m_context);
+  RecordStatus("ai-create",status);
+  if (status != CB1_AI_READY)
+  {
+    m_activation.Observe(CB1_AI_INCOMPATIBLE,Identity(binding),now);
+    m_fallback = true;
+    return status;
+  }
+  m_gpu = gpu;
+  cb1_hdr10_ai_reset(m_context,binding.stream,m_revision);
+  if (!cb1_hdr10_ai_set_coalesced_bounds(m_context,true))
+    return RecordStatus("analysis-configuration",CB1_AI_INVALID);
+  return CB1_AI_READY;
+}
+
+cb1_ai_status HDR10AISource::Submit(const pl_frame* frame, DVBRIDGE::SourceBinding binding,
+    double pts, std::shared_ptr<void> lease)
+{
+  if (!Matches(binding) || m_fallback || !m_context || !std::isfinite(pts) || pts < m_origin)
+    return RecordStatus("analysis-submit",CB1_AI_INVALID);
+  const auto collected = Collect();
+  if (collected != CB1_AI_READY) return collected;
+  const auto submissions = Metrics().gpu_submissions;
+  const auto status = cb1_hdr10_ai_submit(m_context,frame,Identity(binding),pts-m_origin);
+  // Failed partial batches still read the decoder surface until retirement.
+  if (status == CB1_AI_PENDING || Metrics().gpu_submissions != submissions)
+  {
+    m_job = true;m_jobIdentity = Identity(binding);m_jobPts = pts-m_origin;
+    m_lease = std::move(lease);
+  }
+  else if (status == CB1_AI_READY) m_lastSubmitted = binding.picture;
+  return RecordStatus("analysis-submit",status);
+}
+
+cb1_ai_status HDR10AISource::Seal(double pts)
+{
+  if (!m_context || !Active() || !std::isfinite(pts) || pts < m_origin)
+    return RecordStatus("temporal-seal",CB1_AI_INVALID);
+  const auto status = Collect();
+  return status == CB1_AI_READY ?
+      RecordStatus("temporal-seal",cb1_hdr10_ai_advance(m_context,pts-m_origin)) : status;
+}
+
+void HDR10AISource::End()
+{
+  if (m_context && Active()) cb1_hdr10_ai_end(m_context);
+}
+
+HDR10AISource::Decision HDR10AISource::Prediction(DVBRIDGE::SourceBinding binding,
+    const DVBRIDGE::OutputPreferences& preferences, uint64_t now, cb1_ai_result* result,
+    bool required)
+{
+  if (!result || !Matches(binding) || preferences.revision != m_preferences.revision ||
+      !preferences.SameValues(m_preferences))
+    return Decision::Ignore;
+  if (m_fallback) return Decision::Native;
+  if (m_committed && m_committed->id.picture == binding.picture)
+  {
+    *result = *m_committed;
+    return Decision::Prepare;
+  }
+  if (m_prepared && binding == m_preparedBinding)
+  {
+    *result = *m_prepared;
+    return m_activation.Observe(CB1_AI_READY,Identity(binding),now);
+  }
+  // Speculative preparation must not replace an image awaiting presentation.
+  if (!required && m_prepared &&
+      (!m_committed || m_prepared->id.picture != m_committed->id.picture))
+    return Decision::Wait;
+  const auto started=std::chrono::steady_clock::now();
+  cb1_ai_result prediction{};
+  const auto collected = Collect();
+  const auto status = collected == CB1_AI_READY || collected == CB1_AI_PENDING ?
+      cb1_hdr10_ai_poll(m_context,Identity(binding),&prediction) : collected;
+  RecordStatus("prediction",status,false);
+  const auto elapsed=static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now()-started).count());
+  const auto completed=std::max(DVBRIDGE::DiagnosticNowMs(),
+      now+std::min(elapsed,std::numeric_limits<uint64_t>::max()-now));
+  const auto decision = m_activation.Observe(status,Identity(binding),completed,required);
+  if (decision == Decision::Prepare)
+  {
+    m_prepared = prediction;m_preparedBinding = binding;*result = prediction;
+  }
+  if (decision == Decision::Native) m_fallback = true;
+  return decision;
+}
+
+bool HDR10AISource::Presented(DVBRIDGE::SourceBinding binding, bool success)
+{
+  if (Matches(binding) && m_committed && m_committed->id.picture == binding.picture)
+  {
+    if (!success) m_fallback = true;
+    return success;
+  }
+  if (binding != m_preparedBinding || !m_prepared ||
+      !m_activation.Presented(m_prepared->id,success))
+  {
+    if (binding == m_preparedBinding && !success) m_fallback = true;
+    return false;
+  }
+  m_committed = m_prepared;
+  m_committedHDR10Plus=m_preparedHDR10Plus;
+  return true;
+}
+
+HDR10AISource::Decision HDR10AISource::DescribeHDR10Plus(DVBRIDGE::SourceBinding binding,
+    std::shared_ptr<const AVDynamicHDRPlus> source,double pts,uint64_t now,cb1_ai_result* result)
+{
+  if(!result || !Current(binding,m_preferences) || !std::isfinite(pts))return Decision::Ignore;
+  if(m_fallback)return Decision::Native;
+  if(source && m_prepared && (m_prepared->source_flags&CB1_SOURCE_HDR10PLUS) &&
+      binding==m_preparedBinding && m_preparedHDR10Plus==source)
+  { *result=*m_prepared;return m_activation.Observe(CB1_AI_READY,Identity(binding),now); }
+  cb1_ai_result described=m_metadataOnly ? cb1_ai_result{} : *result;
+  if(!m_metadataOnly && !Describes(binding,described))return Decision::Ignore;
+  const bool same=m_committed && source && m_committedHDR10Plus &&
+      cb1_hdr10plus_dovi_same_scene(source.get(),m_committedHDR10Plus.get());
+  const bool reusable=same && (m_committed->source_flags&CB1_SOURCE_STATISTICS);
+  cb1_hdr10plus_dovi_result metadata{};
+  if(!source || (!reusable && cb1_hdr10plus_dovi_describe(&metadata,source.get(),
+      m_metadataOnly ? nullptr : &described.raw)!=CB1_HDR10PLUS_DOVI_OK))
+  {
+    RecordStatus("hdr10plus-description",CB1_AI_INCOMPATIBLE);
+    m_activation.Observe(CB1_AI_INCOMPATIBLE,Identity(binding),now);
+    m_fallback=true;
+    return Decision::Native;
+  }
+  described.id=Identity(binding);described.pts=pts-m_origin;
+  described.raw=reusable ? m_committed->raw : metadata.metadata;
+  described.source_flags=CB1_SOURCE_HDR10PLUS | (same ? 0 : CB1_SOURCE_SCENE_REFRESH) |
+      (reusable ? CB1_SOURCE_STATISTICS :
+       (metadata.source_fields&CB1_HDR10PLUS_DOVI_AVG ? CB1_SOURCE_STATISTICS : 0));
+  const auto decision=m_activation.Observe(CB1_AI_READY,described.id,now);
+  if(decision==Decision::Prepare)
+  {
+    m_prepared=described;m_preparedBinding=binding;m_preparedHDR10Plus=std::move(source);
+    *result=described;
+  }
+  return decision;
+}
+
+void HDR10AISource::DiscardBefore(DVBRIDGE::SourceBinding binding, uint64_t now)
+{
+  if (Matches(binding) && AwaitingPresentation() &&
+      binding.picture > m_preparedBinding.picture)
+  {
+    if (m_activation.CancelPrepared(m_prepared->id, now) == Decision::Native)
+      m_fallback = true;
+    // Kodi discarded this image; no presentation state is committed.
+    m_prepared.reset();
+    m_preparedBinding = {};
+  }
+}
+
+HDR10AISource::Decision HDR10AISource::Preparation(DVBRIDGE::SourceBinding binding,
+    cb1_ai_status status, uint64_t now)
+{
+  if (!Matches(binding) || binding != m_preparedBinding || !m_prepared)
+    return Decision::Ignore;
+  const auto decision = m_activation.Observe(status, m_prepared->id, now);
+  if (decision == Decision::Native) m_fallback = true;
+  return decision;
+}
+
+struct cb1_hdr10_ai_metrics HDR10AISource::Metrics() const
+{
+  struct cb1_hdr10_ai_metrics metrics{};
+  if (m_context) cb1_hdr10_ai_metrics(m_context,&metrics);
+  return metrics;
+}
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HDR10AISource.h b/xbmc/cores/VideoPlayer/VideoRenderers/HDR10AISource.h
new file mode 100644
index 0000000000..411a850bb5
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/HDR10AISource.h
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h"
+#include "cores/VideoPlayer/DVDCodecs/Video/HDR10AIActivation.h"
+extern "C"
+{
+#include "cb1_hdr10_ai.h"
+#include "cb1_hdr10plus_dovi.h"
+}
+#include <optional>
+
+// Render-thread confined. The owning GL context must retire GPU use before destruction.
+class HDR10AISource
+{
+public:
+  using Decision = DVBRIDGE::HDR10AIActivation::Decision;
+  HDR10AISource() = default;
+  HDR10AISource(const HDR10AISource&) = delete;
+  HDR10AISource& operator=(const HDR10AISource&) = delete;
+  ~HDR10AISource();
+  // Called only after the owning context's retirement fence has completed.
+  void ReleaseRetired();
+  cb1_ai_status Begin(pl_gpu gpu, const char* bundle, const DVBRIDGE::OutputPreferences& preferences,
+      DVBRIDGE::SourceBinding binding, double pts, uint64_t now, bool buffered = true,
+      bool metadataOnly = false);
+  bool MetadataOnly() const { return m_metadataOnly; }
+  bool HDR10Plus() const { return m_preferences.hdr10Source == DVBRIDGE::HDR10SourceMode::HDR10PlusDV; }
+  Decision DescribeHDR10Plus(DVBRIDGE::SourceBinding binding,
+      std::shared_ptr<const AVDynamicHDRPlus> source, double pts, uint64_t now,
+      cb1_ai_result* result);
+  cb1_ai_status Submit(const pl_frame* frame, DVBRIDGE::SourceBinding binding, double pts,
+      std::shared_ptr<void> lease);
+  cb1_ai_status Seal(double pts);
+  void End();
+  Decision Prediction(DVBRIDGE::SourceBinding binding,
+      const DVBRIDGE::OutputPreferences& preferences, uint64_t now, cb1_ai_result* result,
+      bool required = true);
+  bool Presented(DVBRIDGE::SourceBinding binding, bool success);
+  void DiscardBefore(DVBRIDGE::SourceBinding binding, uint64_t now);
+  Decision Preparation(DVBRIDGE::SourceBinding binding, cb1_ai_status status, uint64_t now);
+  bool FallbackEvent() { return m_activation.TakeFallbackEvent(); }
+  bool Active() const { return m_active && !m_fallback; }
+  bool ResetPending() const { return m_resetPending; }
+  bool Current(DVBRIDGE::SourceBinding binding, const DVBRIDGE::OutputPreferences& preferences) const
+  {
+    return Matches(binding) && preferences.revision == m_preferences.revision &&
+        preferences.SameValues(m_preferences);
+  }
+  bool Describes(DVBRIDGE::SourceBinding binding, const cb1_ai_result& prediction) const
+  {
+    const auto expected = Identity(binding);
+    return Matches(binding) && expected.stream == prediction.id.stream &&
+        expected.picture == prediction.id.picture && expected.revision == prediction.id.revision;
+  }
+  uint64_t LastSubmitted() const { return m_lastSubmitted; }
+  void SetPresentationDeadline(uint64_t deadline) { m_activation.SetPresentationDeadline(deadline); }
+  void InputReady(uint64_t now) { m_activation.InputReady(now); }
+  void SetPaused(bool paused, uint64_t now)
+  {
+    m_paused = paused;
+    m_activation.SetPaused(paused,now);
+  }
+  const std::optional<cb1_ai_result>& Committed() const { return m_committed; }
+  bool AwaitingPresentation() const
+  {
+    return m_prepared && (!m_committed || m_prepared->id.picture != m_committed->id.picture);
+  }
+  struct cb1_hdr10_ai_metrics Metrics() const;
+  cb1_ai_status Collect();
+  cb1_ai_status RecordStatus(const char* stage, cb1_ai_status status, bool processing=true)
+  {
+    if (!m_diagnosticFailure)
+    {
+      m_diagnosticStage = stage;
+      m_diagnosticStatus = status;
+      m_diagnosticFailure = processing && status != CB1_AI_READY && status != CB1_AI_PENDING;
+    }
+    return status;
+  }
+  const char* DiagnosticStage() const { return m_diagnosticStage; }
+  cb1_ai_status DiagnosticStatus() const { return m_diagnosticStatus; }
+
+private:
+  cb1_ai_identity Identity(DVBRIDGE::SourceBinding binding) const;
+  bool Matches(DVBRIDGE::SourceBinding binding) const;
+  cb1_hdr10_ai* m_context{};
+  pl_gpu m_gpu{};
+  DVBRIDGE::HDR10AIActivation m_activation;
+  DVBRIDGE::OutputPreferences m_preferences;
+  DVBRIDGE::SourceBinding m_binding{}, m_preparedBinding{};
+  cb1_ai_identity m_jobIdentity{};
+  std::shared_ptr<void> m_lease;
+  std::optional<cb1_ai_result> m_prepared, m_committed;
+  std::shared_ptr<const AVDynamicHDRPlus> m_preparedHDR10Plus, m_committedHDR10Plus;
+  uint64_t m_revision{};
+  uint64_t m_lastSubmitted{};
+  double m_origin{}, m_jobPts{};
+  bool m_active{}, m_job{}, m_fallback{}, m_resetPending{}, m_paused{};
+  bool m_metadataOnly{};
+  const char* m_diagnosticStage{"none"};
+  cb1_ai_status m_diagnosticStatus{CB1_AI_READY};
+  bool m_diagnosticFailure{};
+};
