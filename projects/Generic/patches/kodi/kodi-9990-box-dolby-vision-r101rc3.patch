+        !KODI::WINDOWING::GBM::ReadDVBridgeScreenshot(window, buffer, true) || !buffer.pixels ||
+        buffer.width != static_cast<unsigned int>(window.GetGfxContext().GetWidth()) ||
+        buffer.height != static_cast<unsigned int>(fbHeight))
