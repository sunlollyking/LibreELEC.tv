+bool CWinSystemGbmGLESContext::SetGuiCompositing(int colorTransfer)
+{
+  float gamma = 2.4f;
+#ifdef HAVE_DVBRIDGE
+  if (colorTransfer && m_sdrConversion)
+  {
+    double peak = 0, targetGamma = 0, black = 0;
+    if (!dvbridge_sdr_target(&m_dvSelection.policy.sdr, &peak, &targetGamma, &black)) return false;
+    gamma = static_cast<float>(targetGamma);
+  }
+#endif
+  return ConfigureGuiCompositing(colorTransfer, gamma);
+}
+
+bool CWinSystemGbmGLESContext::ConfigureGuiCompositing(int colorTransfer, float gamma)
+{
+  if (colorTransfer == AVCOL_TRC_GAMMA22 && m_guiColorTransfer == colorTransfer &&
+      m_guiCompositing && m_compositeShader && m_guiSDRGamma == gamma)
+    return true;
+
+  m_guiCacheValid = false;
+  m_guiColorTransfer = colorTransfer;
+  m_guiCompositing = (colorTransfer != 0);
+
+  if (m_guiCompositing)
+  {
+    if (!m_compositeShader)
+    {
+      std::string defines;
+      m_compositeShaderLimited = UseLimitedColor()
+#ifdef HAVE_DVBRIDGE
+          && !m_dvState.Captured() && !m_hdrConversion
+#endif
+          ;
+      if (m_compositeShaderLimited)
+        defines += "#define KODI_LIMITED_RANGE 1\n";
+      m_compositeShader = std::make_unique<CGuiCompositeShaderGLES>(defines);
+      if (!m_compositeShader->CompileAndLink())
+      {
+        CLog::Log(LOGERROR, "CWinSystemGbmGLESContext: failed to compile GUI composite shader");
+        m_compositeShader.reset();
+        m_guiCompositing = false;
+        return false;
+      }
+    }
+
+    if (!m_compositeShader->CreateLUTs(colorTransfer, gamma))
+    {
+      CLog::Log(LOGERROR, "CWinSystemGbmGLESContext: failed to create LUTs");
+      m_compositeShader.reset();
+      m_guiCompositing = false;
+      return false;
+    }
+    const bool nativeSDR = colorTransfer == AVCOL_TRC_BT2020_10;
+    m_compositeShader->SetSDRBT2020(nativeSDR, nativeSDR);
+    m_guiSDRGamma = gamma;
+  }
+  else
+  {
+#ifdef HAVE_DVBRIDGE
+    m_dvPQSubtitleFbo.Cleanup();
+    m_dvPQSubtitleWidth = m_dvPQSubtitleHeight = 0;
+    m_dvPQSubtitleDraws = 0;
+    m_dvPQGuiMergeAttempted = m_dvPQGuiComposed = false;
+    m_dvPQSubtitleRendering = m_dvPQSubtitleCleared = m_dvNativeGui = false;
+#endif
+    m_guiFbo.Cleanup();
+    m_guiFboWidth = 0;
+    m_guiFboHeight = 0;
+    m_compositeShader.reset();
+  }
+
+  return m_guiCompositing;
+}
