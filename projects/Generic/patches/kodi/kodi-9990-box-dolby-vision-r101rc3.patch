+  std::string text = levels & (1u << 8) ? "L8" : "L2";
+  if (groups & Trims::SOP) text += " · SOP";
+  if (groups & Trims::Colour) text += " · Colour";
+  if (groups & Trims::Mid) text += " · Mid";
