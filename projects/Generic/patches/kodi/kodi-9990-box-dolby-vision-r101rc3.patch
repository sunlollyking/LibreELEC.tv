+        "version={} length={} target={} compatibility={} peak={:.3f} black={:.6f} "
+        "read_rgb_xy={:.6f},{:.6f}/{:.6f},{:.6f}/{:.6f},{:.6f} "
+        "used_rgb_xy={:.6f},{:.6f}/{:.6f},{:.6f}/{:.6f},{:.6f} "
