+  return m_aiActive;
+}
+
+bool CWinSystemGbmGLESContext::PrepareHDR10AIQueue(const VideoPicture& picture,
+    std::span<const CDVBridgeGLES::Layer> queue, bool end, bool paused,
+    uint64_t presentationDeadline)
+{
+  const auto preferences = DVBRIDGE::FrameOutputSettings(picture.hdrType == StreamHdrType::HDR_TYPE_HDR10PLUS,
+      !picture.doviSourceInfo.profile && picture.hdrType == StreamHdrType::HDR_TYPE_HLG);
+  const auto caps = GetDVOutputCapabilities(&picture, preferences);
+  const auto binding = picture.doviSourceBinding;
+  const auto requested=DVBRIDGE::SelectOutput(preferences,caps);
+  if ((!caps.isHDR10 && !caps.isHLG) || requested.route!=DVBRIDGE::OutputRoute::NativeDV)
+  {
+    const bool failed=caps.sourceKnown && !caps.stereoSource && (caps.isHDR10 || caps.isHLG) &&
+        preferences.hdr10Source!=DVBRIDGE::HDR10SourceMode::Native &&
+        requested.reason!=DVBRIDGE::OutputReason::None &&
+        requested.reason!=DVBRIDGE::OutputReason::ProcessingPending;
+    {
+      std::lock_guard lock(m_dvCapabilityMutex);
+      m_aiActive=m_aiReady=false;
+      if (failed && !m_dvFatalConsumed) m_dvFatalReason=requested.reason;
+      if (!failed)
+      {
+        m_aiActivation={};
+        m_aiPolicy=0;
+        m_aiFallback=false;
+      }
+    }
+    const bool ready=!m_dvContext || m_dvContext->StopHDR10AI();
+    const bool pending=requested.reason==DVBRIDGE::OutputReason::ProcessingPending;
+    if (ready)
+    {
+      std::lock_guard lock(m_dvCapabilityMutex);
+      m_aiSelectionPolicy=pending ? 0 : preferences.revision;
+    }
+    return ready && !failed && !pending;
+  }
+  // The ordinary commit retires the prior renderer before AI can prime it again.
+  if (m_dvOrdinaryFrame || m_dvEndPending || m_dvStopPending) return false;
+  if (queue.empty() || !(queue.front().binding == binding)) return false;
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    if (binding.stream != m_aiActivation.stream ||
+        binding.revision != m_aiActivation.revision || preferences.revision != m_aiPolicy)
+    {
+      m_aiActivation = binding;
+      m_aiPolicy = preferences.revision;
+      m_aiReady = m_aiFallback = false;
+    }
+    m_aiActive=!m_aiFallback;
+    if (m_aiFallback) return false;
+  }
+  if (!m_dvContext) m_dvContext = std::make_shared<CDVBridgeGLES::Context>();
+  auto decision = HDR10AISource::Decision::Native;
+  cb1_ai_result prediction{};
+  if (m_dvContext->Initialize(false))
+  {
+    // Kodi's display-reset delay is not time spent waiting for an AI prediction.
+    paused |= (picture.hdrType == StreamHdrType::HDR_TYPE_HDR10 || caps.isHLG) && m_dispReset;
+    decision = m_dvContext->PrepareHDR10AIQueue(queue, preferences,
+        CB1_L1L3_BUNDLE_DIR, DVBRIDGE::DiagnosticNowMs(), end, &prediction, paused,
+        presentationDeadline);
+  }
+  else m_dvContext->HDR10AI().RecordStatus("analysis-context",CB1_AI_INCOMPATIBLE);
+  if (decision == HDR10AISource::Decision::Prepare &&
+      (!m_dvBridge || !m_dvBridge->CommittedHDR10AI()))
+  {
+    // Prime the output before Kodi starts the playback clock.
+    {
+      std::lock_guard lock(m_dvCapabilityMutex);
+      m_aiReady = true;
+    }
+    auto status = CDVBridgeGLES::FrameStatus::Pending;
+    const bool outputReady = PrepareDVOutputFrame(picture) && BeginDVBridge();
+    if (outputReady)
+      status = m_dvBridge->PrepareHDR10AIFrame(queue.front(),
+          m_dvImportGeometry, preferences, prediction, m_dvSelection.policy);
+    const auto result = status == CDVBridgeGLES::FrameStatus::Ready ||
+        status == CDVBridgeGLES::FrameStatus::Reused ? CB1_AI_READY :
+        status == CDVBridgeGLES::FrameStatus::Failed ||
+        status == CDVBridgeGLES::FrameStatus::Unsupported ? CB1_AI_INCOMPATIBLE : CB1_AI_PENDING;
+    m_dvContext->HDR10AI().RecordStatus(outputReady ? "rgb-prepare" : "rgb-output-setup",result);
+    decision = m_dvContext->HDR10AI().Preparation(binding, result, DVBRIDGE::DiagnosticNowMs());
+  }
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    m_aiReady |= decision == HDR10AISource::Decision::Prepare;
+    m_aiFallback = decision == HDR10AISource::Decision::Native;
+    m_aiActive = !m_aiFallback;
+    if (decision != HDR10AISource::Decision::Wait)
+      m_aiSelectionPolicy=preferences.revision;
+  }
+  if (decision == HDR10AISource::Decision::Native)
+  {
+    const auto& source = m_dvContext->HDR10AI();
+    const auto metrics = source.Metrics();
+    DVBRIDGE::DiagnosticLog(LOGWARNING,
+        "CB1 HDR10 AI: requested rendering failed stream={} revision={} policy={} stage={} status={} queue={} coverage_s={} pictures={} gpu_submissions={} readback_bytes={} inferences={} prepared={} committed={} end={} paused={} head={} last_submitted={}",
+        binding.stream, binding.revision, preferences.revision,
+        source.DiagnosticStage(),int(source.DiagnosticStatus()),queue.size(),
+        queue.back().pts-queue.front().pts,metrics.pictures,metrics.gpu_submissions,
+        metrics.readback_bytes,metrics.inferences,source.AwaitingPresentation(),bool(source.Committed()),
+        end,paused,binding.picture,source.LastSubmitted());
+    std::lock_guard lock(m_dvCapabilityMutex);
+    if (!m_dvFatalConsumed) m_dvFatalReason=DVBRIDGE::OutputReason::ActivationFailed;
+  }
+  return decision == HDR10AISource::Decision::Prepare;
+}
+#endif
+
+void CWinSystemGbmGLESContext::ResetDVActivation(const VideoPicture* picture)
+{
+  if (!picture) return;
+  const auto binding = picture->doviSourceBinding.Valid() ?
+      picture->doviSourceBinding : picture->doviMetadata.Binding();
+  const auto revision = DVBRIDGE::FrameOutputSettings().revision;
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    if (binding.stream == m_dvActivationStream && revision == m_dvActivationPolicy) return;
+    m_dvActivationStream = binding.stream;
+    m_dvActivationPolicy = revision;
+    m_dvNativeFailed = m_dvHDR10Failed = m_dvSDRFailed = m_dvPlayerLedFailed = m_dvFallbackActive = false;
+    m_dvActivationReason = DVBRIDGE::OutputReason::None;
+    m_dvFailedStream = m_dvFailedPolicy = 0;
+  }
+  m_sdrBT2020Rejected = false;
+  if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM)) drm->ResetDVActivation();
+}
+
+bool CWinSystemGbmGLESContext::RecoverDVActivation()
+{
+  if (!m_dvRecoveryPending) return true;
+  if (!PollRejectedDVSurface()) return false;
+  // Retire the rejected GPU work before restoring properties with clean pixels.
+  if (!m_dvContext || m_dvContext->Poll() != DVBRIDGE_DV_IDLE) return false;
+  const bool superseded = m_dvSuperseded;
+  if (!EndDVBridge())
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    m_dvActivationReason = DVBRIDGE::OutputReason::RestoreFailed;
+    return false;
+  }
+  // Supersession retired the candidate and restored connector/session state,
+  // but it was not an activation failure of either the old or the new target.
+  if (superseded)
+  {
+    m_dvConfiguredOutput.reset();
+    m_dvRecoveryPending = false;
+    if (m_sdrBT2020Rejected)
+    {
+      std::lock_guard lock(m_dvCapabilityMutex);
+      m_dvActivationReason = DVBRIDGE::OutputReason::None;
+    }
+    return true;
+  }
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  bool fallback;
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    fallback = m_dvFallbackActive;
+  }
+  const bool retry = drm && !fallback && drm->CanRetryDVActivation(true);
+  if (!retry)
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    if (m_dvRejectedRoute == DVBRIDGE::OutputRoute::NativeDV) m_dvNativeFailed = true;
+    if (m_dvRejectedRoute == DVBRIDGE::OutputRoute::HDR10) m_dvHDR10Failed = true;
+    if (m_dvRejectedRoute == DVBRIDGE::OutputRoute::SDR) m_dvSDRFailed = true;
+    if (m_dvRejectedRoute == DVBRIDGE::OutputRoute::PlayerLed) m_dvPlayerLedFailed = true;
+    m_dvFallbackActive = true;
+    m_dvActivationReason = DVBRIDGE::OutputReason::ActivationFailed;
+    m_dvFailedStream = m_dvActivationStream;
+    m_dvFailedPolicy = m_dvActivationPolicy;
+  }
+  m_dvConfiguredOutput.reset();
+  DVBRIDGE::StreamTelemetry::NativeFailure(DVBRIDGE::OutputReason::ActivationFailed,
+      drm ? drm->DVActivationError() : 0,drm ? drm->DVActivationFailures() : 0,true);
+  DVBRIDGE::StreamTelemetry::PublishNativePending(
+      CServiceBroker::GetDataCacheCore().GetVideoProcessingGeneration());
+  m_dvRecoveryPending = false;
+  return true;
+}
+
+DVBRIDGE::OutputReason CWinSystemGbmGLESContext::ConsumeDVPlaybackFailure(DVBRIDGE::SourceBinding binding)
+{
+  std::lock_guard lock(m_dvCapabilityMutex);
+  if (!binding.Valid() || binding.stream != m_dvFatalBinding.stream ||
+      binding.revision != m_dvFatalBinding.revision || m_dvFatalConsumed)
+    return DVBRIDGE::OutputReason::None;
+  if (m_dvFatalReason != DVBRIDGE::OutputReason::None) m_dvFatalConsumed = true;
+  return m_dvFatalReason;
+}
+
+void CWinSystemGbmGLESContext::RefreshHDR10LinkDepth()
+{
+  auto* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  if (!connector || connector->GetType().rfind("HDMI", 0) != 0 ||
+      !connector->SupportsProperty("max bpc"))
+  {
+    m_hdr10MaxBpc = 0;
+    return;
+  }
+
+  // Native DV and LLDV temporarily own an 8-bit scanout. HDR10 setup stages
+  // the saved connector depth when it releases that transport.
+  const auto restored = m_dvState.Before("max bpc");
+  auto depth = GetEffectiveMaxBpc(restored);
+  if (restored && *restored != 0)
+    depth = std::min(depth, *restored);
+  if (const auto range = connector->GetRangePropertyLimits("max bpc"); range && depth != 0)
+    depth = std::min(depth, range->second);
+  m_hdr10MaxBpc = depth;
+}
+
+bool CWinSystemGbmGLESContext::SupportsHDR10Conversion(bool requireCurrentMode)
+{
+  if (!IsHDRDisplay() || !GetDisplayHDRCapabilities().SupportsHDR10())
+    return false;
+  auto* connector = m_DRM->GetConnector();
+  return connector && connector->IsConnected() && connector->SupportsProperty("HDR_OUTPUT_METADATA") &&
+      (connector->SupportsProperty("DVBRIDGE_HDR10_DEEP_COLOR") || FloatOutputUsable()) &&
+      SupportsDVOutputMode(requireCurrentMode);
+}
+
+bool CWinSystemGbmGLESContext::SupportsSDRConversion() const
+{
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  const auto* mode = drm ? drm->GetSelectedMode() : nullptr;
+  auto* connector = drm ? drm->GetConnector() : nullptr;
+  return connector && connector->IsConnected() && mode && mode->hdisplay && mode->vdisplay &&
+      mode->hdisplay <= 3840 && mode->vdisplay <= 2160 &&
+      !(mode->flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN));
+}
+
+bool CWinSystemGbmGLESContext::ConfigureSDRConversion(const VideoPicture& picture)
+{
+  if (!CompleteDVBridgePage()) return false;
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm || (m_dvState.Captured() && !m_dvState.Stage(*drm, true))) return false;
+  if (!CaptureCB1ConnectorPreferences()) return false;
+  m_failedHDR10SetupRestore = true;
+  if (m_hdrDeepColorPrevious && !drm->AddProperty(drm->GetConnector(),
+      "DVBRIDGE_HDR10_DEEP_COLOR", *m_hdrDeepColorPrevious)) return false;
+  m_sdrSignal.reset(); // The first rendered frame supplies the actual gamut.
+  SetHDR(nullptr); // The native method returns false for SDR, including SDR-only displays.
+  if (drm->GetConnector()->SupportsProperty("HDR_OUTPUT_METADATA") &&
+      !drm->AddProperty(drm->GetConnector(), "HDR_OUTPUT_METADATA", 0)) return false;
+  drm->StageHDR10Plus({}, picture.doviSourceInfo.informationGeneration);
+  if (!BeginDVBridge()) return false;
+  m_hdr10Session.reset();
+  m_hdr10BasicSignal.reset();
+  m_hdr10Signal.reset();
+  m_hdr10SessionStream = 0;
+  m_failedHDR10SetupRestore = false;
+  return true;
+}
+
+namespace
+{
+bool IsPascal(uint16_t vendor, uint16_t device)
+{
+  // GP102/104/106/107/108. R580 also covers Maxwell and Volta.
+  return vendor == 0x10de && device >= 0x1b00 && device < 0x1d80;
+}
+
+bool IsSelectedPascal(const CDRMAtomic& drm)
+{
+  drmDevicePtr device = nullptr;
+  if (drmGetDevice2(drm.GetFileDescriptor(), 0, &device) != 0)
+    return false;
+  const bool pascal = device->bustype == DRM_BUS_PCI && device->deviceinfo.pci &&
+      IsPascal(device->deviceinfo.pci->vendor_id, device->deviceinfo.pci->device_id);
+  drmFreeDevice(&device);
+  return pascal;
+}
+}
+
+bool CWinSystemGbmGLESContext::PrepareHDR10Scanout(const VideoPicture* picture)
+{
+  const bool native = m_dvSelection.route == DVBRIDGE::OutputRoute::Vanilla && picture &&
+      picture->color_transfer == AVCOL_TRC_SMPTE2084 &&
+      (picture->hdrType == StreamHdrType::HDR_TYPE_HDR10 ||
+       picture->hdrType == StreamHdrType::HDR_TYPE_HDR10PLUS);
+  if (!native && (!m_dvOutputSurface || m_dvSelection.route != DVBRIDGE::OutputRoute::HDR10))
+    return false;
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  auto* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector || !connector->GetType().starts_with("HDMI") ||
+      !connector->SupportsProperty("DVBRIDGE_HDR10_DEEP_COLOR"))
+    return false;
+  std::string driverVersion;
+  std::ifstream("/sys/module/nvidia/version") >> driverVersion;
+  if (!driverVersion.starts_with("580."))
+    return false;
+  if (native && (!IsSelectedPascal(*drm) ||
+                 !GetDisplayHDRCapabilities().SupportsHDR10() ||
+                 !CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
+                     SETTING_WINSYSTEM_IS_HDR_DISPLAY) ||
+                 (GetEffectiveMaxBpc() > 0 && GetEffectiveMaxBpc() < 10)))
+    return false;
+  if (!ChooseEGLConfig(m_renderableType, 8))
+    return false;
+
+  if (!m_pascalHDRScanout)
+  {
+    try
+    {
+      m_pascalHDRScanout = CPascalHDR10Scanout::Create(
+          m_GBM->GetDevice().Get(), *drm, m_nWidth, m_nHeight);
+    }
+    catch (const std::exception& error)
+    {
+      CLog::LogF(LOGWARNING, "R580 HDR10 scanout import failed: {}", error.what());
+    }
+    CLog::LogF(m_pascalHDRScanout ? LOGINFO : LOGWARNING,
+              "R580 10-bit HDR10 scanout probe: {}",
+              m_pascalHDRScanout ? "passed" : "unavailable");
+  }
+  if (!m_pascalHDRScanout)
+    return false;
+  SelectPascalHDRMode(native ? PascalHDRMode::Native : PascalHDRMode::Conversion);
+  return true;
+}
+
+void CWinSystemGbmGLESContext::SelectPascalHDRMode(PascalHDRMode mode)
+{
+  const bool wasNative = m_pascalHDRMode == PascalHDRMode::Native;
+  m_pascalHDRMode = mode;
+  if (wasNative && mode != PascalHDRMode::Native)
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  BindNativePascalHDRFramebuffer();
+}
+
+void CWinSystemGbmGLESContext::BindNativePascalHDRFramebuffer()
+{
+  if (m_pascalHDRMode == PascalHDRMode::Native)
+    glBindFramebuffer(GL_FRAMEBUFFER, m_pascalHDRScanout->Framebuffer());
+}
+
+std::shared_ptr<gbm_bo> CWinSystemGbmGLESContext::BlitNativePascalHDRFrame()
+{
+  return m_pascalHDRMode == PascalHDRMode::Native ? m_pascalHDRScanout->Blit() : nullptr;
+}
+
+bool CWinSystemGbmGLESContext::StageNativePascalHDR10()
+{
+  if (GetEotf() != KODI::UTILS::Eotf::PQ)
+    return false;
+  const auto drm = std::static_pointer_cast<CDRMAtomic>(m_DRM);
+  auto* connector = drm->GetConnector();
+  if (!m_dvOrdinaryFrame && connector->GetPropertyValue("DVBRIDGE_HDR10_DEEP_COLOR").value_or(0) == 1)
+    return true;
+  drm->SetColorRangeTransition();
+  return RequeueOutputProperties() &&
+         drm->AddProperty(connector, "DVBRIDGE_HDR10_DEEP_COLOR", 1);
+}
+
+unsigned int CWinSystemGbmGLESContext::HDR10Framebuffer() const
+{
+  return m_pascalHDRMode == PascalHDRMode::Conversion ? m_pascalHDRScanout->Framebuffer() : 0;
+}
+
+bool CWinSystemGbmGLESContext::ConfigureHDR10Conversion(const VideoPicture& picture)
+{
+  if (!CompleteDVBridgePage()) return false;
+  m_hdr10Signal.reset();
+  const auto stream = picture.doviMetadata.Binding().stream;
+  if (!stream) return false;
+  if (m_failedHDR10SetupRestore && !EndDVBridge())
+    return false;
+  dvbridge_hdr10_session session{};
+  if (m_hdr10Session && m_hdr10SessionStream == stream) session = *m_hdr10Session;
+  else if (!dvbridge_hdr10_session_init(&session, picture.doviMetadata.Data(), picture.doviMetadata.Size()))
+    return false;
+  auto atomic = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (m_dvState.Captured() && (!atomic || !m_dvState.Stage(*atomic,true))) return false;
+  VideoPicture output;
+  output.SetParams(picture);
+  output.color_transfer = AVCOL_TRC_SMPTE2084;
+  output.color_primaries = AVCOL_PRI_BT2020;
+  output.color_space = AVCOL_SPC_BT2020_NCL;
+  output.colorBits = 10;
+  const auto& metadata = session.output;
+  if (metadata.max_luminance)
+  {
+    if (!output.hasDisplayMetadata)
+      output.displayMetadata = {};
+    output.hasDisplayMetadata = true;
+    output.displayMetadata.has_luminance = metadata.max_luminance != 0;
+    output.displayMetadata.max_luminance = {static_cast<int>(metadata.max_luminance), 1};
+    output.displayMetadata.min_luminance = {static_cast<int>(metadata.min_luminance), 10000};
+    output.hasLightMetadata = true;
+    output.lightMetadata.MaxCLL = metadata.max_cll;
+    output.lightMetadata.MaxFALL = metadata.max_fall;
+  }
+  if (!CaptureCB1ConnectorPreferences()) return false;
+  // Every rejected setup after this point must restore ordinary HDR/color state.
+  m_failedHDR10SetupRestore = true;
+  SetColorimetry(&output);
+  if (!SetHDR(&output))
+    return false;
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  auto* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector)
+    return false;
+  const auto previous = connector->GetPropertyValue("DVBRIDGE_HDR10_DEEP_COLOR");
+  if (previous ? !drm->AddProperty(connector, "DVBRIDGE_HDR10_DEEP_COLOR", 1) : !FloatOutputUsable())
+    return false;
+  m_hdrDeepColorPrevious = previous;
+  if (!BeginDVBridge() || !m_dvBridge->SetHDR10Session(session,stream,UseLimitedColor()))
+  {
+    if (previous && !drm->AddProperty(connector, "DVBRIDGE_HDR10_DEEP_COLOR", *previous))
+    {
+      drm->FlipPageTransactional(nullptr, true);
+    }
+    m_hdrDeepColorPrevious.reset();
+    return false;
+  }
+  m_hdr10Session = session;
+  m_hdr10SessionStream = stream;
+  m_hdr10BasicSignal = std::make_unique<VideoPicture>();
+  m_hdr10BasicSignal->color_transfer = output.color_transfer;
+  m_hdr10BasicSignal->color_primaries = output.color_primaries;
+  m_hdr10BasicSignal->color_space = output.color_space;
+  m_hdr10BasicSignal->colorBits = output.colorBits;
+  m_hdr10BasicSignal->hasDisplayMetadata = output.hasDisplayMetadata;
+  m_hdr10BasicSignal->displayMetadata = output.displayMetadata;
+  m_hdr10BasicSignal->hasLightMetadata = output.hasLightMetadata;
+  m_hdr10BasicSignal->lightMetadata = output.lightMetadata;
+  m_hdr10Signal = {metadata.max_luminance, metadata.min_luminance,
+      metadata.max_cll, metadata.max_fall, ~0u};
+  m_failedHDR10SetupRestore = false;
+  if (m_dvSelection.reason == DVBRIDGE::OutputReason::NoDVTransport ||
+      m_dvSelection.reason == DVBRIDGE::OutputReason::NoPlayerLedTransport)
+    CLog::Log(LOGINFO, "CB1 fallback: selected HDR10 Rendering ({})",
+              CDVPlaybackInfo::Reason(m_dvSelection.reason));
+  if (DVBRIDGE::DiagnosticsEnabled())
+  {
+    if (m_dvSelection.policy.mode == DVBRIDGE_MODE_HDR10PLUS)
+      DVBRIDGE::DiagnosticLog(LOGINFO, "CB1 HDR10+ configured: pixel_mapping=none dynamic=pending-analysis framebuffer_bits={} range={}",
+          GetOutputBitDepth(), UseLimitedColor() ? "limited" : "full");
+    else
+      DVBRIDGE::DiagnosticLog(LOGINFO, "DVBridge HDR10 configured: policy={} signal_target={} nits origin={} framebuffer_bits={} range={}",
+          m_dvSelection.policy.mode == DVBRIDGE_MODE_HDR10_EXPERT ? "Expert" : "Basic",
+        session.target.hdr.max_luma, session.output.level6 ? "RPU-L6" : "RPU-source-PQ",
+        GetOutputBitDepth(), UseLimitedColor() ? "limited" : "full");
+    if (m_hdrDeepColorPrevious)
+      DVBRIDGE::DiagnosticLog(LOGINFO, "DVBridge HDR10: link minimum=10 bits; native HDMI bandwidth and format validation retained");
+    else
+      DVBRIDGE::DiagnosticLog(LOGINFO, "DVBridge HDR10: framebuffer_bits={} link_depth=driver-selected wire_depth=unknown", GetOutputBitDepth());
+  }
+  return true;
+}
+
+bool CWinSystemGbmGLESContext::RestoreFailedHDR10Setup()
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return false;
+  if (!StageCB1ConnectorPreferences(true) || !StageOrdinaryHDR10Recovery())
+  {
+    drm->FlipPageTransactional(nullptr, true);
+    return false;
+  }
+  SetColorimetry(nullptr);
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  glDisable(GL_SCISSOR_TEST);
+  glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+  glClearColor(0, 0, 0, 1);
+  glClear(GL_COLOR_BUFFER_BIT);
+  if (!m_dvBridge || !m_dvBridge->Advanced()) glFinish();
+  if (!m_eglContext.TrySwapBuffers())
+  {
+    drm->FlipPageTransactional(nullptr, true);
+    return false;
+  }
+  auto& surface = m_GBM->GetDevice().GetSurface();
+  auto* bo = surface.LockTransactionalBuffer();
+  const bool presented = drm->FlipPageTransactional(bo, true);
+  surface.CompleteTransactionalBuffer(presented);
+  if (!presented)
+    return false;
+  surface.EndTransactionalMode();
+  CompleteOrdinaryHDR10Recovery();
+  CompleteCB1ConnectorRestore();
+  m_failedHDR10SetupRestore = false;
+  return true;
+}
+
+bool CWinSystemGbmGLESContext::ConnectorPreferencesAllowed() const
+{
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  return !HasPendingDVBridgeRestore() && !m_dvOutputSurface && !HasPendingDVOutputSurface() &&
+      !m_nativeDVProperties && !m_cb1ConnectorState.Captured() &&
+      !m_dvOrdinaryFrame && !m_dvEndPending &&
+      (!drm || !drm->HasPendingCB1Page());
+}
+
+bool CWinSystemGbmGLESContext::CaptureCB1ConnectorPreferences()
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm || !m_cb1ConnectorState.CaptureColorPreferences(*drm, DefaultMaxBpc()))
+    return false;
+  if (!m_cb1LimitedRange)
+  {
+    m_cb1LimitedRange = RequestedLimitedColor();
+    m_cb1OrdinaryLimitedRange = OrdinaryShaderLimitedColor();
+    auto* connector = drm->GetConnector();
+    if (*m_cb1LimitedRange && connector &&
+        !connector->IsPropertyImmutable("Broadcast RGB").value_or(false))
+      m_sdrBroadcastRange = connector->GetPropertyEnumValue("Broadcast RGB", "Limited 16:235");
+  }
+  return true;
+}
+
+std::optional<bool> CWinSystemGbmGLESContext::TransportLimitedColor() const
+{
+  if (m_cb1RestoringPreferences) return m_cb1OrdinaryLimitedRange;
+  // When the driver owns RGB quantization, give it full-range pixels.
+  if (m_sdrConversion && m_cb1ConnectorState.Before("Broadcast RGB")) return false;
+  return m_cb1LimitedRange;
+}
+
+bool CWinSystemGbmGLESContext::StageCB1ConnectorPreferences(bool restore)
+{
+  m_cb1RestoringPreferences = restore;
+  // A quick switch may have captured the movie's native HDR metadata.
+  // Stage GUI signaling on each stop restore, including an NVIDIA head restart.
+  if (restore && m_dvStopPending)
+    SetHDR(nullptr);
+  if (!m_cb1ConnectorState.Captured()) return true;
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  return drm && m_cb1ConnectorState.Stage(*drm, restore,
+      m_sdrConversion ? m_sdrBroadcastRange : std::nullopt);
+}
+
+bool CWinSystemGbmGLESContext::StageTransportPreferences()
+{
+  if (!m_cb1RestoringPreferences && m_dvState.Captured() && !m_hdrConversion)
+    return true;
+  if (!StageCB1ConnectorPreferences(m_cb1RestoringPreferences)) return false;
+  if (m_cb1RestoringPreferences) ApplyColorspace();
+  return true;
+}
+
+std::optional<uint64_t> CWinSystemGbmGLESContext::RestoredConnectorProperty(const char* name) const
+{
+  return m_cb1RestoringPreferences ? m_cb1ConnectorState.Before(name) : std::nullopt;
+}
+
+void CWinSystemGbmGLESContext::CompleteCB1ConnectorRestore()
+{
+  m_cb1ConnectorState.Restored();
+  m_cb1RestoringPreferences = false;
+  m_cb1LimitedRange.reset();
+  m_cb1OrdinaryLimitedRange.reset();
+  m_sdrBroadcastRange.reset();
+  DeferConnectorPreferences();
+}
+
+bool CWinSystemGbmGLESContext::BeginDVBridge()
+{
+  if (!PollRejectedDVSurface())
+  { DVBRIDGE::DiagnosticStage("output-surface-restoring"); return false; }
+  if (m_dvShutdownFence && !RetireDVContext())
+  { DVBRIDGE::DiagnosticStage("context-retiring"); return false; }
+  const auto failure = [this](const char* stage, const char* detail = "none") {
+    if (DVBRIDGE::DiagnosticsEnabled())
+      DVBRIDGE::DiagnosticFailureLog(stage,
+          m_dvSetupFailures.Record(DVBRIDGE::DiagnosticNowMs(), stage), LOGERROR,
+          "DVBridge setup: stage={} detail={} failures={} size={}x{} depth={} renderable={}",
+          stage, detail, m_dvSetupFailures.Count(), m_nWidth, m_nHeight,
+          GetOutputBitDepth(), m_renderableType);
+    return false;
+  };
+  const bool playerLed = m_dvSelection.route == DVBRIDGE::OutputRoute::PlayerLed;
+  const bool sdr = m_dvSelection.route == DVBRIDGE::OutputRoute::SDR;
+  const bool hdr10 = m_dvSelection.route == DVBRIDGE::OutputRoute::HDR10 || sdr;
+  const auto* hdr10plusDisplay = GetDisplayInfo();
+  const int hdr10plusVersion = hdr10plusDisplay ? hdr10plusDisplay->HDR10PlusVersion() : -1;
+  if (m_dvBridge) m_dvBridge->SetHDR10PlusVersion(hdr10plusVersion);
+  if (playerLed ? !GetLldvConnectorStatus().currentTiming :
+      sdr ? !SupportsSDRConversion() : !SupportsDVOutputMode())
+    return failure("output-format", "unsupported-current-mode");
+  const auto selected = m_DRM->GetSelectedMode();
+  if (!selected || m_nWidth != selected->hdisplay || m_nHeight != selected->vdisplay)
+    return failure("output-format", "drawable-size");
+  const int dvDrawableDepth = playerLed ? m_dvSelection.lldvRgbScanoutBits : 8;
+  if (sdr ? GetOutputBitDepth() < 8 : hdr10 ? GetOutputBitDepth() < 10 :
+      GetOutputBitDepth() != dvDrawableDepth)
+    return failure("output-format", "drawable-depth");
+  if (m_renderableType != EGL_OPENGL_ES3_BIT) return failure("output-format", "egl-renderable");
+  if (m_dvBridge && m_dvConfiguredOutput == m_dvSelection.policy.mode &&
+      (m_dvState.Captured() || m_hdrConversion))
+    return (!sdr || SetGuiCompositing(AVCOL_TRC_GAMMA22)) &&
+        m_guiCompositing && m_compositeShader;
+  if (!CompleteDVBridgePage())
+  { DVBRIDGE::DiagnosticStage("display-pending"); return false; }
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm || (!drm->IsSelectedModeCommitted() &&
+      m_modeHold.Holding() != CModeChangeHold::Kind::START))
+    return failure("atomic-output-unavailable");
+  CDVWindowRetirement::PollOnce();
+  if (CDVBridgeGLES::Context::NewContextBlocked()) return failure("context-retained");
+  if (!m_dvContext) m_dvContext = std::make_shared<CDVBridgeGLES::Context>();
+  if (m_dvContext->GL() && m_dvContext->Poll() != DVBRIDGE_DV_IDLE)
+    return failure("context-retiring");
+  if (m_dvBridge && m_dvBridge->PlayerLed() != playerLed)
+    m_dvBridge.reset(); // Previous renderer use was retired above.
+  if (!m_dvBridge)
+  {
+    m_dvBridge = std::make_unique<CDVBridgeGLES>(playerLed);
+    if (!m_dvBridge->Initialize(false, hdr10, m_dvContext, sdr, HDR10Framebuffer()))
+      return failure("renderer-init");
+    m_dvBridge->SetHDR10PlusVersion(hdr10plusVersion);
+  }
+  m_GBM->GetDevice().UseDVOutputLifetime();
+  const bool hadConnectorState = m_cb1ConnectorState.Captured();
+  if (!CaptureCB1ConnectorPreferences())
+    return failure("connector-preferences", m_cb1ConnectorState.CaptureFailure());
+  if (!hdr10 && !m_dvState.Captured())
+  {
+    const auto* display = GetDisplayInfo();
+    if (!display) return failure("drm-state-capture", "edid-unavailable");
+    const auto sink = display->GetDolbyVisionCaps();
+    const auto* mode = drm->GetSelectedMode();
+    const double rate = mode && mode->htotal && mode->vtotal ?
+        mode->clock * 1000.0 / mode->htotal / mode->vtotal : 0.0;
+    if (!playerLed && !sink.supports_2160p60 &&
+        mode && mode->vdisplay >= 2160 && rate > 30.01)
+      return failure("output-format", "sink-dv-rate");
+    if (!(playerLed ? m_dvState.CapturePlayerLed(*drm) :
+          m_dvState.Capture(*drm, 0, sink.legacy_vsif)))
+    {
+      if (!hadConnectorState) CompleteCB1ConnectorRestore();
+      return failure("drm-state-capture", m_dvState.CaptureFailure());
+    }
+    m_presentStall.Reset();
+    if (DVBRIDGE::DiagnosticsEnabled())
+      DVBRIDGE::DiagnosticLog(LOGINFO, "DVBridge {} state captured: hdr_static_metadata={}",
+          playerLed ? "Player-Led" : "TV-Led",
+          drm->GetConnector()->SupportsProperty("HDR_OUTPUT_METADATA") ? "preserved" : "not-exposed");
+  }
+  m_hdrConversion = hdr10;
+  m_sdrConversion = sdr;
+  if (sdr && m_dvPQSubtitleDraws)
+  {
+    m_dvPQSubtitleDraws = 0;
+    CServiceBroker::GetGUI()->GetWindowManager().MarkDirty();
+  }
+  if (!StageCB1ConnectorPreferences(false)) return failure("connector-preferences");
+  DeferConnectorPreferences();
+  m_compositeShader.reset();
+  const bool ready = SetGuiCompositing(sdr ? AVCOL_TRC_GAMMA22 : AVCOL_TRC_SMPTE2084);
+  if (ready) m_dvConfiguredOutput = m_dvSelection.policy.mode;
+  return ready;
+}
+
+bool CWinSystemGbmGLESContext::SetVideoOutput(const VideoPicture* picture)
+{
+#ifdef CB1_HAS_HDR10_AI
+  m_hdr10HandoffPending = false;
+  m_hdr10HandoffPicture.reset();
+#endif
+  if (picture && DVBRIDGE::DiagnosticsEnabled())
+  {
+    const auto binding = picture->doviSourceBinding.Valid() ? picture->doviSourceBinding : picture->doviMetadata.Binding();
+    const auto preferences = DVBRIDGE::FrameOutputSettings();
+    if (picture->doviSourceInfo.profile || picture->hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION)
+      DVBRIDGE::ObserveDiagnostic(binding.stream,binding.picture,binding.revision,
+          preferences.revision,"output-admission",preferences.output != DVBRIDGE::OutputMode::Disabled,false);
+  }
+  if (picture && m_dvStopPending)
+  {
+    m_modeHold.Cancel();
+    if (!StopDVBridgePlayback() || m_dvOrdinaryFrame) return false;
+  }
+  if (picture && !(SelectedDVOutput(picture).route == DVBRIDGE::OutputRoute::SDR ?
+      SupportsSDRConversion() : SupportsDVOutputMode()) && DVBridgeRequested(picture))
+    return true; // Configure/import first; the GUI owner must modeset before transport setup.
+  if (!CompleteDVBridgePage()) return false;
+  const auto preferences = DVBRIDGE::FrameOutputSettings();
+  if (!RecoverDVActivation()) return false;
+  ResetDVActivation(picture);
+  const auto capabilities = GetDVOutputCapabilities(picture);
+  if (picture && capabilities.isDV && preferences.output != DVBRIDGE::OutputMode::Disabled &&
+      (!capabilities.processingKnown || (picture->strDVELType == "FEL" && !picture->doviEnhancement)))
+    return true; // Configure must reach UploadTexture before source-dependent activation.
+  m_dvSelection = SelectedDVOutput(picture);
+  if (!PollRejectedDVSurface()) return false;
+  if (HasPendingDVOutputSurface() || m_dvOrdinaryFrame) return false;
+  const bool transaction = DVBridgeRequested(picture) || m_hdrConversion || m_dvState.Captured();
+  if (transaction)
+  {
+    // Same-format policy/frame work bypasses this actual transport transition.
+    const bool playerLed = m_dvSelection.route == DVBRIDGE::OutputRoute::PlayerLed;
+    const bool nativeTransport = playerLed || m_dvSelection.route == DVBRIDGE::OutputRoute::NativeDV;
+    const bool wasPlayerLed = m_dvBridge && m_dvBridge->PlayerLed();
+    const bool active = nativeTransport ? m_dvState.Captured() && playerLed == wasPlayerLed :
+        m_hdrConversion;
+    m_dvActivating = DVBridgeRequested(picture) && (m_dvActivating || !active);
+    if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM))
+      drm->SetDVActivationPending(m_dvActivating);
+    if (!m_dvOutputRetiring)
+    {
+      m_dvPriorConfiguredOutput = m_dvState.Captured() || m_hdrConversion ?
+          m_dvConfiguredOutput : std::nullopt;
+      m_dvPriorHDRConversion = m_hdrConversion;
+      m_dvPriorSDRConversion = m_sdrConversion;
+      m_dvPriorGuiCompositing = m_guiCompositing;
+      m_dvPriorGuiSDRGamma = m_guiSDRGamma;
+      m_dvPendingStream = picture ? (picture->doviSourceBinding.Valid() ?
+          picture->doviSourceBinding.stream : picture->doviMetadata.Binding().stream) : 0;
+      m_dvPendingPolicy = preferences.revision;
+      if (m_dvBridge)
+      {
+        m_dvBridge->Cancel();
+        // Cancelled readiness cannot cross an output-format transaction.
+        m_cb1FramePending = m_dvFrame = m_dvNativeGui = false;
+        m_dvOutputRetiring = true;
+        if (!m_dvContext->FenceLastUse()) return false;
+      }
+    }
+    if (m_dvContext && m_dvContext->GL() && m_dvContext->Poll() != DVBRIDGE_DV_IDLE)
+      return false;
+    if (!m_dvContext) m_dvContext = std::make_shared<CDVBridgeGLES::Context>();
+    if (!m_dvContext->Initialize(false)) return false;
+    m_dvOutputRetiring = false;
+    const bool linkChange =
+        nativeTransport != m_dvState.Captured() || (nativeTransport && playerLed != wasPlayerLed) ||
+        ((m_dvSelection.route == DVBRIDGE::OutputRoute::HDR10 ||
+          m_dvSelection.route == DVBRIDGE::OutputRoute::SDR) != m_hdrConversion) ||
+        ((m_dvSelection.route == DVBRIDGE::OutputRoute::SDR) != m_sdrConversion);
+    if (linkChange && m_modeAnnouncement.Pending() == CHeldModeAnnouncement::Step::NONE)
+      m_modeAnnouncement.Held();
+    m_GBM->GetDevice().UseDVOutputLifetime();
+    m_priorPascalHDRMode = m_pascalHDRMode;
+    SelectPascalHDRMode(PascalHDRMode::None);
+    UseDVOutputSurfaceTransaction(true);
+    const bool staged = CWinSystemGbmEGLContext::SetVideoOutput(picture);
+    UseDVOutputSurfaceTransaction(false);
+    if (!staged)
+    {
+      if (!HasPendingDVOutputSurface())
+        SelectPascalHDRMode(m_priorPascalHDRMode);
+      return false;
+    }
+    m_hdr10Signal.reset();
+    const bool requested = DVBridgeRequested(picture);
+    const bool hdr10 = m_dvSelection.route == DVBRIDGE::OutputRoute::HDR10 ||
+        m_dvSelection.route == DVBRIDGE::OutputRoute::SDR;
+    if (requested && m_dvBridge && playerLed == wasPlayerLed &&
+        !m_dvBridge->RebindOutputSurface(hdr10, m_dvSelection.route == DVBRIDGE::OutputRoute::SDR,
+                                         HDR10Framebuffer()))
+    {
+      RejectDVOutputSurface();
+      return false;
+    }
+    m_hdrConversion = false;
+    m_sdrConversion = false;
+    m_dvConfiguredOutput.reset();
+    if (!requested && !PrepareOrdinaryDVOutput(picture)) return false;
+    return true;
+  }
+  // Restore with the current surface before EGL replaces its buffers.
+  if ((m_dvState.Captured() || m_hdrConversion || m_failedHDR10SetupRestore) && !EndDVBridge())
+    return false;
+  m_dvBridge.reset();
+  const auto priorPascalMode = m_pascalHDRMode;
+  SelectPascalHDRMode(PascalHDRMode::None);
+  if (!CWinSystemGbmEGLContext::SetVideoOutput(picture))
+  {
+    SelectPascalHDRMode(priorPascalMode);
+    return false;
+  }
+  if (priorPascalMode == PascalHDRMode::Native && m_pascalHDRMode == PascalHDRMode::None)
+  {
+    const auto drm = std::static_pointer_cast<CDRMAtomic>(m_DRM);
+    drm->AllowModeset();
+    return drm->AddProperty(drm->GetConnector(), "DVBRIDGE_HDR10_DEEP_COLOR", 0);
+  }
+  return true;
+}
+
+bool CWinSystemGbmGLESContext::PrepareDVOutputFrame(const VideoPicture& picture)
+{
+  const auto deferred = [](const char* stage) {
+    DVBRIDGE::DiagnosticStage(stage);
+    return false;
+  };
+  if (DVBRIDGE::DiagnosticsEnabled())
+  {
+    const auto binding = picture.doviSourceBinding.Valid() ? picture.doviSourceBinding : picture.doviMetadata.Binding();
+    const auto preferences = DVBRIDGE::FrameOutputSettings();
+    if (picture.doviSourceInfo.profile || picture.hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION)
+      DVBRIDGE::ObserveDiagnostic(binding.stream,binding.picture,binding.revision,
+          preferences.revision,"output-preparation",preferences.output != DVBRIDGE::OutputMode::Disabled,false);
+  }
+  if (m_dvStopPending) return deferred("output-stop-pending");
+  if (!(SelectedDVOutput(&picture).route == DVBRIDGE::OutputRoute::SDR ?
+      SupportsSDRConversion() : SupportsDVOutputMode()) && DVBridgeRequested(&picture))
+    return deferred("output-mode-unavailable");
+  if (m_dvRollbackFailed || !RecoverDVActivation())
+  {
+    if (m_dvRollbackFailed)
+    {
+      if (DVBRIDGE::StreamTelemetry::Read().transaction.reason != DVBRIDGE::OutputReason::RestoreFailed)
+      {
+        auto atomic=std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+        DVBRIDGE::StreamTelemetry::NativeFailure(DVBRIDGE::OutputReason::RestoreFailed,
+            0,atomic ? atomic->DVActivationFailures() : 0,false);
+        DVBRIDGE::StreamTelemetry::PublishNativePending(picture.doviSourceInfo.informationGeneration);
+      }
+      std::lock_guard lock(m_dvCapabilityMutex);
+      if (!m_dvFatalConsumed) m_dvFatalReason = DVBRIDGE::OutputReason::RestoreFailed;
+    }
+    return deferred(m_dvRollbackFailed ? "output-restore-failed" : "output-restore-pending");
+  }
+  // A stopped file's GUI transaction must be presented before new video setup.
+  if (m_dvOrdinaryFrame && HasPendingDVOutputSurface())
+    return deferred("output-await-previous-scanout");
+  ResetDVActivation(&picture);
+  const auto preferences = DVBRIDGE::FrameOutputSettings(picture.hdrType == StreamHdrType::HDR_TYPE_HDR10PLUS,
+      !picture.doviSourceInfo.profile && picture.hdrType == StreamHdrType::HDR_TYPE_HLG);
+  const auto capabilities = GetDVOutputCapabilities(&picture, preferences);
+#ifdef CB1_HAS_HDR10_AI
+  if (((!capabilities.isHDR10 && !capabilities.isHLG) ||
+       preferences.hdr10Source==DVBRIDGE::HDR10SourceMode::Native ||
+       preferences.hdr10Source==DVBRIDGE::HDR10SourceMode::SDR) &&
+      m_dvContext && !m_dvContext->StopHDR10AI()) return deferred("output-await-ai-retirement");
+#endif
+  auto selectionCapabilities = capabilities;
+  auto selection = SelectedDVOutput(&picture, preferences, selectionCapabilities);
+  const bool awaitingFEL = picture.strDVELType == "FEL" && !picture.doviEnhancement;
+  const bool prepareDV = capabilities.isDV && preferences.output != DVBRIDGE::OutputMode::Disabled &&
+      (!preferences.hdr10TransportFallback || selection.route == DVBRIDGE::OutputRoute::HDR10 ||
+       selection.reason == DVBRIDGE::OutputReason::ProcessingPending ||
+       (awaitingFEL && selection.reason == DVBRIDGE::OutputReason::SourceIneligible));
+  if (prepareDV)
+  {
+    if (!capabilities.processingKnown) return deferred("output-await-source-import");
+    if (awaitingFEL) return deferred("output-await-fel");
+  }
+  {
+    const auto masterBinding=picture.doviSourceBinding.Valid() ?
+        picture.doviSourceBinding : picture.doviMetadata.Binding();
+    std::lock_guard lock(m_dvCapabilityMutex);
+    m_masterSafety.Begin(masterBinding.stream,preferences.revision,masterBinding.revision,picture.pts,
+        capabilities.isDV && preferences.output==DVBRIDGE::OutputMode::MasterReference);
+  }
+  if (selection.route == DVBRIDGE::OutputRoute::SDR &&
+      selection.policy.sdr.gamut == DVBRIDGE_GAMUT_BT2020 &&
+      (m_sdrBT2020Rejected || GetSDRBT2020Support() != SDRBT2020Support::Available))
+    selection.policy.sdr.gamut = DVBRIDGE_GAMUT_BT709;
+  const auto binding = picture.doviSourceBinding.Valid() ?
+      picture.doviSourceBinding : picture.doviMetadata.Binding();
+  if (HasPendingDVOutputSurface() &&
+      (m_dvPendingStream != binding.stream || m_dvPendingPolicy != preferences.revision ||
+       m_dvSelection.route != selection.route || m_dvSelection.policy.mode != selection.policy.mode ||
+       m_dvSelection.lldvEdidGeneration != selection.lldvEdidGeneration ||
+       m_dvSelection.lldvRgbScanoutBits != selection.lldvRgbScanoutBits))
+  {
+    // A pending drawable and renderer belong to their original target. Retire
+    // and unwind that transaction before selecting any successor, even at the
+    // same bit depth. Preserve real retirement/restoration failures.
+    m_dvSuperseded = true;
+    if (!RejectDVOutputSurface() || !RecoverDVActivation())
+      return deferred("output-await-superseded-scanout");
+  }
+  m_dvSelection = selection;
+  // Retained renderer facts belong to this render-side phase, never Configure.
+  if (capabilities.sourceKnown)
+  {
+    auto identity = m_dvBridge ? m_dvBridge->SelectionIdentity(binding, preferences, m_dvSelection.policy.mode) :
+        DVBRIDGE::SourceBinding{};
+    if (!identity.Valid() && binding.Valid()) identity = {binding.stream,binding.picture,preferences.revision};
+    int requested=DVBRIDGE::PolicyCode(preferences.Policy());
+#ifdef CB1_HAS_HDR10_AI
+    if (capabilities.isHDR10 || capabilities.isHLG)
+      requested=DVBRIDGE::PolicyCode(preferences.HDR10Policy());
+#endif
+    DVBRIDGE::StreamTelemetry::NativeSelection(identity, selectionCapabilities,
+        requested,DVBRIDGE::PolicyCode(m_dvSelection.policy),m_dvSelection.reason);
+    if (m_dvSelection.reason!=DVBRIDGE::OutputReason::None)
+      DVBRIDGE::StreamTelemetry::PublishNativePending(picture.doviSourceInfo.informationGeneration);
+  }
+  if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM))
+    m_dvAttemptFailures = drm->DVActivationFailures();
+  const auto& source = picture.doviSourceInfo;
+  const bool requestedCircuit=capabilities.isDV ? preferences.output!=DVBRIDGE::OutputMode::Disabled :
+      (capabilities.isHDR10 || capabilities.isHLG) &&
+      preferences.hdr10Source!=DVBRIDGE::HDR10SourceMode::Native;
+  if (capabilities.sourceKnown && !capabilities.stereoSource && requestedCircuit &&
+      m_dvSelection.route==DVBRIDGE::OutputRoute::Vanilla &&
+      m_dvSelection.reason!=DVBRIDGE::OutputReason::None &&
+      m_dvSelection.reason!=DVBRIDGE::OutputReason::ProcessingPending &&
+      (preferences.hdr10TransportFallback || !(source.el && !picture.doviEnhancement)))
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    if (!m_dvFatalConsumed) m_dvFatalReason=m_dvSelection.reason;
+    return false;
+  }
+  if (!PollRejectedDVSurface()) return deferred("output-await-rejected-scanout");
+  // A format match cannot carry a fixed target across original source streams.
+  if (m_dvSelection.route == DVBRIDGE::OutputRoute::HDR10 && m_hdrConversion &&
+      m_hdr10Session && m_hdr10SessionStream != picture.doviMetadata.Binding().stream)
+    return ConfigureHDR10Conversion(picture);
+  if (m_dvSelection.reason == DVBRIDGE::OutputReason::TVProfileRequired)
+  {
+    DVBRIDGE::DiagnosticStage("output-tv-profile-required");
+    if ((m_dvProfileLoggedRevision != preferences.revision || m_dvProfileLoggedStream != binding.stream) &&
+        DVBRIDGE::DiagnosticLog(LOGWARNING,
+            "DVBridge profile incomplete: peak={} panel={} gamut={} requirement=peak_and_gamut_required",
+            preferences.peak,preferences.panel,preferences.gamut))
+    {
+      m_dvProfileLoggedRevision = preferences.revision;
+      m_dvProfileLoggedStream = binding.stream;
+    }
+  }
+  const bool matchedPlayerLedDepth = m_dvSelection.route != DVBRIDGE::OutputRoute::PlayerLed ||
+      GetOutputBitDepth() == static_cast<int>(m_dvSelection.lldvRgbScanoutBits);
+  if (m_dvConfiguredOutput == m_dvSelection.policy.mode && !m_dvOutputRetiring && matchedPlayerLedDepth &&
+      (m_dvSelection.route == DVBRIDGE::OutputRoute::Vanilla || m_dvState.Captured() || m_hdrConversion))
+    return m_dvSelection.route != DVBRIDGE::OutputRoute::SDR ||
+        SetGuiCompositing(AVCOL_TRC_GAMMA22);
+  const bool requested = DVBridgeRequested(&picture);
+  if (requested && m_dvBridge && !HasPendingDVOutputSurface() && matchedPlayerLedDepth &&
+      (m_dvSelection.route == DVBRIDGE::OutputRoute::PlayerLed) == m_dvBridge->PlayerLed() &&
+      (m_dvState.Captured() || m_hdrConversion) &&
+      (m_dvSelection.route == DVBRIDGE::OutputRoute::SDR) == m_sdrConversion &&
+      (m_dvSelection.route == DVBRIDGE::OutputRoute::HDR10 ||
+       m_dvSelection.route == DVBRIDGE::OutputRoute::SDR) == m_hdrConversion)
+  {
+    // Same-format policies keep the renderer and its committed history intact.
+    if (m_sdrConversion && !SetGuiCompositing(AVCOL_TRC_GAMMA22)) return false;
+    if (!CompleteDVBridgePage()) return false;
+    m_dvConfiguredOutput = m_dvSelection.policy.mode;
+    return true;
+  }
+  if (!HasPendingDVOutputSurface() && !SetVideoOutput(&picture)) return false;
+  m_dvSelection = selection;
+  if (requested)
+  {
+    if (CDVBridgeGLES::Context::NewContextBlocked() ||
+        (m_dvContext && m_dvContext->GL() && m_dvContext->Poll() != DVBRIDGE_DV_IDLE))
+      return false;
+    const bool ready = m_dvSelection.route == DVBRIDGE::OutputRoute::SDR ?
+        ConfigureSDRConversion(picture) : m_dvSelection.route == DVBRIDGE::OutputRoute::HDR10 ?
+        ConfigureHDR10Conversion(picture) : BeginDVBridge();
+    if (!ready) { RejectDVOutputSurface(); return false; }
+  }
+  else if ((HasPendingDVOutputSurface() || m_dvOrdinaryFrame) &&
+           !PrepareOrdinaryDVOutput(&picture)) return false;
+  m_dvConfiguredOutput = m_dvSelection.policy.mode;
+  return true;
+}
+
+bool CWinSystemGbmGLESContext::PrepareOrdinaryDVOutput(const VideoPicture* picture)
+{
+  // Keep the current native metadata blob alive until its commit is accepted.
+  if (m_dvOrdinaryFrame && !m_dvStopPending) return true;
+  m_cb1RestoringPreferences = true;
+  if (m_dvStopPending)
+  {
+    SetGuiCompositing(0);
+    CServiceBroker::GetGUI()->GetWindowManager().MarkDirty();
+  }
+  SetColorimetry(picture);
+  const bool hdr = SetHDR(picture);
+  SetGuiCompositing(hdr && picture ? picture->color_transfer : 0);
+  m_dvOrdinaryFrame = true;
+  return true;
+}
+
+bool CWinSystemGbmGLESContext::RejectDVOutputSurface()
+{
+  m_hdr10Signal.reset();
+  // Ordinary commit rejection stays retryable through its pending frame owner.
+  if (m_dvOrdinaryFrame) return false;
+  if (!m_dvActivating && !HasPendingDVOutputSurface()) return true;
+  if (!m_dvStopPending && !m_dvRecoveryPending)
+  {
+    m_dvRecoveryPending = true;
+    if (!m_dvSuperseded)
+    {
+      m_dvRejectedRoute = m_dvSelection.route;
+      if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+          drm && drm->DVActivationFailures() == m_dvAttemptFailures)
+        drm->FailDVActivation(EINVAL);
+    }
+  }
+  if (!HasPendingDVOutputSurface())
+  {
+    if (m_dvBridge) m_dvBridge->Cancel();
+    if (!m_dvContext || !m_dvContext->FenceLastUse()) m_dvRollbackFailed = true;
+    return !m_dvRollbackFailed;
+  }
+  if (!m_dvRejectedSurface)
+  {
+    m_dvRejectedSurface = true;
+    m_dvConfiguredOutput.reset();
+    if (m_dvBridge) m_dvBridge->Cancel();
+    // The tail covers imports, resolve and the candidate's native swap commands.
+    if (!m_dvContext || !m_dvContext->FenceLastUse()) m_dvRollbackFailed = true;
+    if (!m_eglContext.BindPriorOutputSurface()) m_dvRollbackFailed = true;
+  }
+  return PollRejectedDVSurface();
+}
+
+bool CWinSystemGbmGLESContext::PollRejectedDVSurface()
+{
+  if (!m_dvRejectedSurface) return true;
+  if (m_dvRollbackFailed || !m_dvContext) return false;
+  const auto retired = m_dvContext->Poll();
+  if (retired != DVBRIDGE_DV_IDLE)
+  {
+    if (retired == DVBRIDGE_DV_FAILED) m_dvRollbackFailed = true;
+    return false;
+  }
+  if (!CompleteDVOutputSurface(false))
+  {
+    m_dvRollbackFailed = true;
+    return false;
+  }
+  // Ordinary restoration may retain a 10-bit drawable without CB1 processing.
+  SelectPascalHDRMode(m_priorPascalHDRMode);
+  const bool discardedRenderer = m_dvBridge && m_dvPriorConfiguredOutput &&
+      m_dvBridge->PlayerLed() != (*m_dvPriorConfiguredOutput == DVBRIDGE_MODE_PLAYER_LED);
+  if (discardedRenderer)
+    m_dvBridge.reset(); // The rejected renderer is retired and cannot own the restored surface.
+  if (m_dvBridge && m_dvPriorConfiguredOutput &&
+      !m_dvBridge->RebindOutputSurface(m_dvPriorHDRConversion, m_dvPriorSDRConversion,
+                                       HDR10Framebuffer()))
+  {
+    m_dvRollbackFailed = true;
+    return false;
+  }
+  m_hdrConversion = m_dvPriorHDRConversion;
+  m_sdrConversion = m_dvPriorSDRConversion;
+  m_hdr10Signal.reset();
+  m_dvConfiguredOutput = discardedRenderer ? std::nullopt : m_dvPriorConfiguredOutput;
+  const bool guiReady = ConfigureGuiCompositing(m_dvPriorGuiCompositing ?
+      (m_dvPriorSDRConversion ? AVCOL_TRC_GAMMA22 : AVCOL_TRC_SMPTE2084) : 0,
+      m_dvPriorGuiSDRGamma);
+  if (m_dvPriorGuiCompositing && !guiReady)
+  {
+    m_dvRollbackFailed = true;
+    return false;
+  }
+  m_dvRejectedSurface = false;
+  return true;
+}
+
+bool KODI::WINDOWING::GBM::HasDVBridgeScreenshot(CWinSystemBase& window)
+{
+  auto* gbm = dynamic_cast<CWinSystemGbmGLESContext*>(&window);
+  return gbm && gbm->HasDVBridgeScreenshot();
+}
+
+bool KODI::WINDOWING::GBM::IsDVBridgeScreenshotSDR(CWinSystemBase& window)
+{
+  auto* gbm = dynamic_cast<CWinSystemGbmGLESContext*>(&window);
+  return gbm && gbm->IsDVBridgeScreenshotSDR();
+}
+
+bool CWinSystemGbmGLESContext::ReadDVBridgeScreenshot(KODI::RENDERING::CAPTURE::ReadbackBuffer& out, bool videoOnly)
+{
+  if (!m_dvFrame || !m_dvBridge)
+  {
+    const char* stage = !m_dvBridge ? "renderer-unavailable" : "video-frame-unprepared";
+    if (DVBRIDGE::DiagnosticsEnabled() &&
+        m_dvScreenshotFailures.Record(DVBRIDGE::DiagnosticNowMs(), stage))
+      DVBRIDGE::DiagnosticLog(LOGWARNING,
+          "DVBridge screenshot: stage={} frame={} bridge={} sdr={} hdr_conversion={} gui={} gui_render={} size={}x{}",
+          stage, m_dvFrame, m_dvBridge != nullptr, m_sdrConversion, m_hdrConversion,
+          m_guiCompositing, m_guiWillRender, m_nWidth, m_nHeight);
+    return false;
+  }
+  // The other DV outputs have a packed carrier or display-linear RGB. Neither is BT.2020 PQ.
+  if (videoOnly && !m_hdrConversion && !m_dvBridge->UsesMasterSourceCarrier())
+    return false;
+  return m_dvBridge->ReadScreenshot(out, videoOnly);
+}
+
+bool KODI::WINDOWING::GBM::ReadDVBridgeScreenshot(CWinSystemBase& window, KODI::RENDERING::CAPTURE::ReadbackBuffer& out, bool videoOnly)
+{
+  auto* gbm = dynamic_cast<CWinSystemGbmGLESContext*>(&window);
+  return gbm && gbm->ReadDVBridgeScreenshot(out, videoOnly);
+}
+
+bool CWinSystemGbmGLESContext::CB1AsyncAvailable() const
+{
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  return m_eglFence && drm && drm->CanAsyncDVBridge() && m_dvBridge &&
+      !m_dvBridge->Fallback() && !m_dvFallbackActive && !m_dvActivating &&
+      !m_dvRecoveryPending && !m_dvRejectedSurface && !m_dvRollbackFailed &&
+      !m_dvOutputRetiring && !m_dvShutdownFence && !m_dvStopPending && !HasPendingDVOutputSurface() &&
+      m_dvSelection.route != DVBRIDGE::OutputRoute::Vanilla &&
+      (m_hdrConversion || m_dvState.Captured());
+}
+
+int CWinSystemGbmGLESContext::ExportCB1GPUFence()
+{
+#if defined(EGL_ANDROID_native_fence_sync) && defined(EGL_KHR_fence_sync)
+  if (m_eglFence)
+  {
+    m_eglFence->CreateGPUFence();
+    glFlush();
+    return m_eglFence->FlushFence();
+  }
+#endif
+  return -1;
+}
+
+bool CWinSystemGbmGLESContext::CreateCB1GPUFence(const CDVBridgeGLES::Submission& submission)
+{
+#if defined(EGL_ANDROID_native_fence_sync) && defined(EGL_KHR_fence_sync)
+  const auto current = m_dvBridge ? m_dvBridge->CaptureSubmission() : CDVBridgeGLES::Submission{};
+  if (submission.asyncEligible && current.asyncEligible && submission.sequence &&
+      submission.sequence == current.sequence && submission.target == current.target &&
+      submission.resolveSerial == current.resolveSerial &&
+      submission.identity.stream == current.identity.stream &&
+      submission.identity.picture == current.identity.picture &&
+      submission.identity.revision == current.identity.revision && CB1AsyncAvailable())
+  {
+    // The exported fence covers packing as well as source reconstruction.
+    const int fd = ExportCB1GPUFence();
+    if (fd >= 0)
+    {
+      const int prior = m_DRM->TakeOutFenceFd();
+      if (prior >= 0) close(prior);
+      m_DRM->SetInFenceFd(fd);
+      return true;
+    }
+    glFinish();
+  }
+#endif
+  return false;
+}
+
+bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
+                                            std::shared_ptr<AVFrame> enhancement,
+                                            DVBRIDGE::SourceBinding enhancementBinding,
+                                            const CDVMetadataBuffer& metadata,
+                                            dvbridge_geometry geometry,
+                                            const CDVBridgeGLES::FELSuccessor* successor)
+{
+  // A delayed KMS handoff must not replace the one prepared next picture.
+  if (m_cb1FramePending && m_dvFrame) return true;
+  m_cb1FramePending = false;
+  m_dvFrame = false;
+  if (!BeginDVBridge() || (m_sdrConversion && !m_dvBridge->SetSDROutputRange(UseLimitedColor())))
+    return false;
+  if (m_dvBridge->PlayerLedCpuPending() && CB1AsyncAvailable())
+  {
+    // Retire a confirmed scanout before the next producer checks carrier availability.
+    CompleteDVBridgePage(0);
+    if (!CB1AsyncAvailable()) return false;
+  }
+  const auto capture = CServiceBroker::GetCaptureService();
+  const auto preferences = DVBRIDGE::FrameOutputSettings(
+      !layer.sourceInfo.profile && layer.hdr10PlusSource,
+      !layer.sourceInfo.profile && layer.hlg);
+  bool capturing = capture && !capture->TakeActive(
+      KODI::RENDERING::CAPTURE::CaptureContent::COMPOSITE).empty();
+  const bool masterCapture=capturing && m_dvSelection.policy.mode==DVBRIDGE_MODE_MASTER_REFERENCE;
+  if (masterCapture)
+    m_dvBridge->InvalidateScreenshot();
+  else if (capture && (m_hdrConversion || m_dvSelection.policy.mode == DVBRIDGE_MODE_MASTER_REFERENCE))
+  {
+    // A paused frame may already have been consumed by scanout.
+    using namespace KODI::RENDERING::CAPTURE;
+    const auto requests = capture->TakeActive(CaptureContent::VIDEO);
+    if (!requests.empty())
+    {
+      const auto& spec = requests.front()->spec;
+      if (spec.cadence == CaptureCadence::ONESHOT && spec.format == CaptureFormat::NATIVE &&
+          !spec.width && !spec.height && (m_hdrConversion || CDVBridgeGLES::UsesMasterSourceCarrier(
+              m_dvSelection.policy.mode, preferences.masterIPT, metadata)))
+      {
+        m_dvBridge->InvalidateScreenshot();
+        // Direct HDR10 writes scanout only. Prepare its PQ RGB target for the video tap.
+        if (m_hdrConversion && !m_sdrConversion)
+          capturing = true;
+      }
+    }
+  }
+  const bool guiAvailable = m_guiWillRender || CanReuseGuiComposite();
+  const bool overlayFree = (!capturing || masterCapture) &&
+      (!guiAvailable || GetGUIElementCount() == 0) && !m_dvOverlays;
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  m_continuousFrameEligible = !capturing && overlayFree && player && player->GetPlaySpeed() == 1 &&
+      m_previousSourceStream == layer.binding.stream &&
+      DVBRIDGE::ContinuousPresentationPicture(layer.pts, m_previousSourcePts) &&
+      m_dvSelection.reason == DVBRIDGE::OutputReason::None;
+  m_masterFramePeriodNs=m_continuousFrameEligible &&
+      m_dvSelection.policy.mode==DVBRIDGE_MODE_MASTER_REFERENCE ?
+      DVBRIDGE::MasterFramePeriodNs(CServiceBroker::GetDataCacheCore().GetVideoFps()) : 0;
+  if(auto drm=std::dynamic_pointer_cast<CDRMAtomic>(m_DRM))
+  {
+    const auto margin=drm->TakeCB1Headroom();
+    bool switched=false;
+    {
+      std::lock_guard lock(m_dvCapabilityMutex);
+      switched=m_masterSafety.Observe(margin,m_continuousFrameEligible &&
+          m_dvSelection.policy.mode==DVBRIDGE_MODE_MASTER_REFERENCE);
+    }
+    if(switched)
+    {
+      CLog::Log(LOGWARNING,
+          "CB1 Master safety: sustained headroom below 2.5ms; requested Master circuit retained");
+    }
+    drm->SetCB1TimingPeriod(m_masterFramePeriodNs);
+  }
+  m_preparedSourceStream = layer.binding.stream;
+  m_preparedSourcePts = layer.pts;
+  m_preparedRenderPts = m_cb1RenderPts;
+  geometry.ignore_l5=false;
+  const bool mergedPQGUI = ComposeDVPQGUI();
+  const bool subtitlesOnly = !capturing && guiAvailable && m_guiFbo.IsValid() &&
+      m_guiFboWidth == m_nWidth && m_guiFboHeight == m_nHeight && m_compositeShader &&
+      m_dvSubtitleDraws && m_dvSubtitleDraws == GetGUIElementCount() &&
+      (!m_dvPQSubtitleDraws || m_dvPQSubtitleDraws == m_dvSubtitleDraws);
+  const bool pqSubtitles = (subtitlesOnly || mergedPQGUI) && m_dvPQSubtitleDraws;
+  const bool enhancedSubtitles = subtitlesOnly && metadata.Data() &&
+      m_dvSelection.policy.mode == DVBRIDGE_MODE_ENHANCED_DV;
+  const bool fullGUI = guiAvailable && GetGUIElementCount() &&
+      (mergedPQGUI || CDVBridgeGLES::CanComposeSDRGUI(preferences.optimizedDV ||
+          m_dvSelection.policy.mode == DVBRIDGE_MODE_MASTER_REFERENCE,m_hdrConversion,capturing && !masterCapture,
+          m_guiFboWidth,m_guiFboHeight,m_dvPQSubtitleDraws));
+  // The TV masks L5 margins. Keep controls/subtitles in letterbox bars visible.
+  m_dvBridge->SetOverlayVisible((guiAvailable && GetGUIElementCount()) || m_dvOverlays);
+  // Prime the subtitle shader once; empty frames retain the lean native shader.
+  // Captures and PQ subtitles still use the separate composition pass.
+  const bool playerLedGui = m_dvBridge->PlayerLed() && !capturing && fullGUI &&
+      !m_dvOverlays && !m_dvPQSubtitleDraws && GetOutputBitDepth() == 8 &&
+      GetGfxContext().GetStereoMode() == RenderStereoMode::OFF &&
+      (!capture || capture->TakeActive(KODI::RENDERING::CAPTURE::CaptureContent::VIDEO).empty());
+  const bool nativeOverlay = !m_hdrConversion &&
+      (m_dvBridge->PlayerLed() ? playerLedGui :
+       (fullGUI || subtitlesOnly || (overlayFree && !m_dvBridge->NativeOverlayPrimed()))) &&
+      m_guiFbo.IsValid() && m_guiFboWidth == m_nWidth && m_guiFboHeight == m_nHeight && m_compositeShader;
+  const bool nativeSubtitles = m_dvBridge->SetNativeOverlay(
+      nativeOverlay ? (pqSubtitles ? m_dvPQSubtitleFbo.Texture() : m_guiFbo.Texture()) : 0,
+      nativeOverlay ? m_compositeShader->GetDegammaTexture() : 0,
+      nativeOverlay ? m_compositeShader->GetTransferTexture() : 0,
+      fullGUI && !enhancedSubtitles ? CRect(0,0,m_nWidth,m_nHeight) : m_dvSubtitleBounds,
+      fullGUI && !enhancedSubtitles ? m_dvGUIContentGeneration : m_dvSubtitleContent,
+      pqSubtitles, true);
+  if (std::getenv("CB1_PRESENTATION_AUDIT"))
+  {
+    static unsigned prior = ~0u;
+    const unsigned route = (overlayFree ? 1 : 0) | (nativeSubtitles ? 2 : 0) |
+        (pqSubtitles ? 4 : 0) | (GetGUIElementCount() << 4) | (m_dvSubtitleDraws << 16);
+    if (route != prior)
+    {
+      prior = route;
+      DVBRIDGE::DiagnosticLog(LOGINFO, "CB1 subtitle route: gui={} subtitle_draws={} pq_draws={} gui_render={} free={} native={} bounds={},{},{},{}",
+          GetGUIElementCount(), m_dvSubtitleDraws, m_dvPQSubtitleDraws, m_guiWillRender, overlayFree, nativeSubtitles,
+          m_dvSubtitleBounds.x1, m_dvSubtitleBounds.y1, m_dvSubtitleBounds.x2, m_dvSubtitleBounds.y2);
+    }
+  }
+  m_dvNativeGui = false;
+  const auto policy = m_dvSelection.policy;
+  const bool allowAsync = CB1AsyncAvailable() && !capturing;
+  m_dvBridge->EnablePlayerLedCpu(m_dvBridge->PlayerLed() && GetOutputBitDepth() == 8 &&
+      allowAsync && overlayFree &&
+      enhancement && player && player->GetPlaySpeed() == 1 && m_GBM ?
+      m_GBM->GetDevice().Get() : nullptr);
+#ifdef CB1_HAS_HDR10_AI
+  const bool aiFrame = !metadata.Data() && policy.mode != DVBRIDGE_MODE_SDR;
+  cb1_ai_result prediction{};
+  if (aiFrame && m_dvBridge->PredictHDR10AI(layer.binding, preferences,
+      DVBRIDGE::DiagnosticNowMs(), &prediction) != HDR10AISource::Decision::Prepare)
+    return false;
+#endif
+  const auto prepare = [&]() {
+#ifdef CB1_HAS_HDR10_AI
+    if (aiFrame)
+      return m_dvBridge->PrepareHDR10AIFrame(layer, geometry, preferences,
+          prediction, policy, allowAsync, overlayFree || (preferences.optimizedDV && nativeSubtitles));
+#endif
+    return m_dvBridge->PrepareHardwareFrame(layer, enhancement, enhancementBinding,
+        metadata, geometry, preferences,
+        overlayFree || nativeSubtitles || (m_hdrConversion && !capturing), &policy, allowAsync);
+  };
+  const double refresh = m_DRM->GetCurrentMode().fRefreshRate;
+  const auto interval = std::chrono::duration<double>(refresh >= 10 ? 1.0 / refresh : 0.02);
+  const auto preparationDeadline = std::chrono::steady_clock::now() +
+      (capturing ? std::chrono::duration<double>(1.0) : interval);
+  auto status = prepare();
+  const auto preparedAt = std::chrono::steady_clock::now();
+  const auto initialStatus = status;
+  const bool prefetchFEL = successor && successor->frame && metadata.Data() &&
+      policy.mode == DVBRIDGE_MODE_ENHANCED_DV &&
+      allowAsync && m_dvContext->AsyncPreparation(layer.binding.stream) && m_continuousFrameEligible &&
+      overlayFree && geometry.source_width == 3840 && geometry.source_height == 2160 &&
+      !geometry.x && !geometry.y && geometry.width == 3840 && geometry.height == 2160;
+  if (!prefetchFEL)
+    m_dvBridge->ClearFELPrefetch();
+  else if (status == CDVBridgeGLES::FrameStatus::Pending)
+    m_dvBridge->PrefetchHardwareFEL(*successor,preferences);
+#ifdef CB1_HAS_HDR10_AI
+  if (aiFrame)
+  {
+    // Future analysis may advance, but cannot withhold a ready current picture.
+    for (;;)
+    {
+      const auto analysis = m_dvBridge->CollectHDR10AI();
+      if (analysis != CB1_AI_READY && analysis != CB1_AI_PENDING)
+        return false;
+      const bool renderPending = status == CDVBridgeGLES::FrameStatus::Pending ||
+          status == CDVBridgeGLES::FrameStatus::Busy;
+      if ((!renderPending && status != CDVBridgeGLES::FrameStatus::Ready &&
+           status != CDVBridgeGLES::FrameStatus::Reused) ||
+          !renderPending || std::chrono::steady_clock::now() >= preparationDeadline)
+        break;
+      if (renderPending) status = prepare();
+      if (status == CDVBridgeGLES::FrameStatus::Pending ||
+          status == CDVBridgeGLES::FrameStatus::Busy)
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+  }
+  else
+#endif
+  if (capturing || (metadata.Data() && (policy.mode == DVBRIDGE_MODE_ENHANCED_DV ||
+                                      policy.mode == DVBRIDGE_MODE_HDR10PLUS)))
+  {
+    // Complete content analysis before Kodi advances this source picture.
+    const auto deadline = preparationDeadline;
+    while ((status == CDVBridgeGLES::FrameStatus::Pending ||
+            status == CDVBridgeGLES::FrameStatus::Busy) &&
+           std::chrono::steady_clock::now() < deadline)
+    {
+      if (status == CDVBridgeGLES::FrameStatus::Pending)
+      {
+        const auto remaining = std::chrono::duration_cast<std::chrono::nanoseconds>(
+            deadline - std::chrono::steady_clock::now()).count();
+        const uint64_t waitNs = prefetchFEL && remaining > 0 ?
+            static_cast<uint64_t>(std::min<int64_t>(remaining,2000000)) : 0;
+        if (prefetchFEL || policy.mode == DVBRIDGE_MODE_HDR10PLUS)
+          status = m_dvBridge->PollStatus(waitNs);
+        else if (m_dvBridge->PollReady())
+          status = CDVBridgeGLES::FrameStatus::Ready;
+      }
+      else
+      {
+        status = prepare();
+        if (prefetchFEL && status == CDVBridgeGLES::FrameStatus::Pending)
+          m_dvBridge->PrefetchHardwareFEL(*successor,preferences);
+      }
+      if (status != CDVBridgeGLES::FrameStatus::Ready &&
+          !(prefetchFEL && status == CDVBridgeGLES::FrameStatus::Pending))
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    // Completion during the last sleep still belongs to the current picture.
+    if (status == CDVBridgeGLES::FrameStatus::Pending && m_dvBridge->PollReady())
+      status = CDVBridgeGLES::FrameStatus::Ready;
+  }
+  // A paused final surface is already committed scanout, not a fresh resolve.
+  const bool reused = status == CDVBridgeGLES::FrameStatus::Reused;
+  m_dvFrame = status == CDVBridgeGLES::FrameStatus::Ready;
+  if (m_dvBridge->PlayerLed() && status == CDVBridgeGLES::FrameStatus::Failed)
+  {
+    m_dvActivating = true;
+    RejectDVOutputSurface();
+  }
+  m_dvNativeGui = (m_dvFrame || reused) && m_dvBridge->NativeOverlayComposed();
+  if (m_dvFrame && m_hdrConversion && !m_sdrConversion)
+  {
+    if (const auto* policy = m_dvBridge->HDR10Output())
+    {
+      const std::array<unsigned, 5> signal{policy->hdr10.max_luminance,
+          policy->hdr10.min_luminance, policy->hdr10.max_cll, policy->hdr10.max_fall,
+          static_cast<unsigned>(policy->nominal_target.primaries)};
+      // Stage static HDR metadata only when the output reference changes.
+      if (m_hdr10Signal != signal)
+      {
+        VideoPicture output;
+        output.color_transfer = AVCOL_TRC_SMPTE2084;
+        output.color_primaries = AVCOL_PRI_BT2020;
+        output.color_space = AVCOL_SPC_BT2020_NCL;
+        output.colorBits = 10;
+        output.hasDisplayMetadata = true;
+        output.displayMetadata = {};
+        output.displayMetadata.has_luminance = true;
+        output.displayMetadata.max_luminance = {static_cast<int>(policy->hdr10.max_luminance),1};
+        output.displayMetadata.min_luminance = {static_cast<int>(policy->hdr10.min_luminance),10000};
+        const auto* primaries = pl_raw_primaries_get(policy->nominal_target.primaries);
+        const auto coordinate = [](float value) {
+          return AVRational{static_cast<int>(std::lround(value * 50000)), 50000};
+        };
+        output.displayMetadata.has_primaries = true;
+        output.displayMetadata.display_primaries[0][0] = coordinate(primaries->red.x);
+        output.displayMetadata.display_primaries[0][1] = coordinate(primaries->red.y);
+        output.displayMetadata.display_primaries[1][0] = coordinate(primaries->green.x);
+        output.displayMetadata.display_primaries[1][1] = coordinate(primaries->green.y);
+        output.displayMetadata.display_primaries[2][0] = coordinate(primaries->blue.x);
+        output.displayMetadata.display_primaries[2][1] = coordinate(primaries->blue.y);
+        output.displayMetadata.white_point[0] = coordinate(primaries->white.x);
+        output.displayMetadata.white_point[1] = coordinate(primaries->white.y);
+        output.hasLightMetadata = true;
+        output.lightMetadata = {policy->hdr10.max_cll,policy->hdr10.max_fall};
+        m_dvFrame = SetHDR(&output);
+        if (m_dvFrame) m_hdr10Signal = signal;
+      }
+    }
+    else if (m_hdr10Session && m_hdr10BasicSignal)
+    {
+      const auto& metadata = m_hdr10Session->output;
+      const std::array<unsigned, 5> signal{metadata.max_luminance, metadata.min_luminance,
+          metadata.max_cll, metadata.max_fall, ~0u};
+      if (m_hdr10Signal != signal)
+      {
+        m_dvFrame = SetHDR(m_hdr10BasicSignal.get());
+        if (m_dvFrame) m_hdr10Signal = signal;
+      }
+    }
+  }
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  bool queuedPlayerLed = false;
+  if (m_dvFrame && m_dvBridge->PlayerLedCpuPrepared())
+  {
+    const auto transport = DVBRIDGE::SelectLldvTransport(GetLldvConnectorStatus(), m_dvSelection.lldvFormat);
+    const float fps = CServiceBroker::GetDataCacheCore().GetVideoFps();
+    // The FIFO is drained by KMS. Reserve a frame only at the matched 30 Hz cadence.
+    const auto primeWindow = fps >= 29.9f && fps <= 30.01f && std::abs(static_cast<double>(fps) - refresh) < 0.01 ?
+        std::chrono::milliseconds(static_cast<int>(std::ceil(1000.0 / static_cast<double>(fps)))) : 0ms;
+    queuedPlayerLed = transport.edidGeneration == m_dvSelection.lldvEdidGeneration &&
+        m_dvBridge->QueuePlayerLedCpu(transport, layer.pts, m_preparedRenderPts,
+                                                 ExportCB1GPUFence(), layer.sourceSideData, primeWindow);
+    m_dvFrame = false;
+    if (!queuedPlayerLed)
+    {
+      m_dvActivating = true;
+      RejectDVOutputSurface();
+    }
+  }
+  const bool renderPending = status == CDVBridgeGLES::FrameStatus::Pending ||
+      status == CDVBridgeGLES::FrameStatus::Busy;
+  m_cb1FramePending = (metadata.Data() && (policy.mode == DVBRIDGE_MODE_ENHANCED_DV ||
+                                         policy.mode == DVBRIDGE_MODE_HDR10PLUS) && renderPending) ||
+      (allowAsync && (m_dvBridge->PlayerLed() || m_dvContext->AsyncPreparation(layer.binding.stream)) &&
+       (m_dvFrame || renderPending));
+  if (std::getenv("CB1_PRESENTATION_AUDIT"))
+  {
+    static unsigned samples=0,ready=0,pending=0,busy=0,repeats=0;
+    static double submitMs=0,waitMs=0;
+    static unsigned initialFailures=0;
+    if (!m_dvFrame && initialFailures++<8)
+      DVBRIDGE::DiagnosticLog(LOGINFO,"CB1 private preparation detail: initial={} final={} refresh={} mode={} authored={} capture={} submit_ms={:.3f} wait_ms={:.3f}",
+          int(initialStatus),int(status),refresh,int(policy.mode),metadata.Data()!=nullptr,capturing,
+          std::chrono::duration<double,std::milli>(preparedAt-(preparationDeadline-(capturing?std::chrono::duration<double>(1.0):interval))).count(),
+          std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-preparedAt).count());
+    ++samples; ready+=(m_dvFrame || queuedPlayerLed); pending+=status==CDVBridgeGLES::FrameStatus::Pending;
+    busy+=status==CDVBridgeGLES::FrameStatus::Busy; repeats+=reused;
+    submitMs+=std::chrono::duration<double,std::milli>(preparedAt-(preparationDeadline-(capturing?std::chrono::duration<double>(1.0):interval))).count();
+    waitMs+=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-preparedAt).count();
+    if (samples==120)
+    {
+      DVBRIDGE::DiagnosticLog(LOGINFO,"CB1 private preparation: samples={} ready={} pending={} busy={} reused={} submit_ms={:.3f} wait_ms={:.3f}",samples,ready,pending,busy,repeats,submitMs/samples,waitMs/samples);
+      samples=ready=pending=busy=repeats=0; submitMs=waitMs=0;
+    }
+  }
+  return m_dvFrame || queuedPlayerLed || reused;
+}
+
+bool CWinSystemGbmGLESContext::ComposeDVPQGUI()
+{
+  // Resolve the actual current policy here, after BeginDVBridge, not during GUI rendering.
+  if (m_dvSelection.policy.mode != DVBRIDGE_MODE_MASTER_REFERENCE || m_hdrConversion ||
+      !m_dvState.Captured() || !m_guiWillRender || !m_dvPQSubtitleDraws ||
+      GetGUIElementCount() <= m_dvPQSubtitleDraws || !m_compositeShader ||
+      !m_guiFbo.IsValid() || !m_dvPQSubtitleFbo.IsValid() ||
+      m_guiFboWidth != m_nWidth || m_guiFboHeight != m_nHeight ||
+      m_dvPQSubtitleWidth != m_guiFboWidth || m_dvPQSubtitleHeight != m_guiFboHeight)
+    return false;
+  // One merge per GUI redraw. Preparation retries must not compound translucency.
+  if (m_dvPQGuiMergeAttempted)
+    return m_dvPQGuiComposed;
+  // An existing GL error is not evidence that this transfer completed.
+  if (glGetError() != GL_NO_ERROR)
+    return false;
+  m_dvPQGuiMergeAttempted = true;
+
+  GLint draw, read, viewport[4], program, active, array, vao;
+  GLint blend[6], textures[3], samplers[3];
+  GLboolean mask[4];
+  constexpr GLenum caps[]{GL_BLEND, GL_DEPTH_TEST, GL_STENCIL_TEST, GL_SCISSOR_TEST,
+      GL_DITHER, GL_CULL_FACE, GL_RASTERIZER_DISCARD, GL_SAMPLE_ALPHA_TO_COVERAGE, GL_SAMPLE_COVERAGE};
+  GLboolean enabled[std::size(caps)];
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+  glGetIntegerv(GL_VIEWPORT, viewport);
+  glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+  glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+  glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &array);
+  glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+  glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+  constexpr GLenum blendNames[]{GL_BLEND_SRC_RGB, GL_BLEND_DST_RGB, GL_BLEND_SRC_ALPHA,
+      GL_BLEND_DST_ALPHA, GL_BLEND_EQUATION_RGB, GL_BLEND_EQUATION_ALPHA};
+  for (unsigned i = 0; i < std::size(blend); ++i)
+    glGetIntegerv(blendNames[i], &blend[i]);
+  for (unsigned i = 0; i < 3; ++i)
+  {
+    glActiveTexture(GL_TEXTURE0 + i);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &textures[i]);
+    glGetIntegerv(GL_SAMPLER_BINDING, &samplers[i]);
+    glBindSampler(i, 0);
+  }
+  for (unsigned i = 0; i < std::size(caps); ++i)
+  {
+    enabled[i] = glIsEnabled(caps[i]);
+    glDisable(caps[i]);
+  }
+
+  const bool bound = m_dvPQSubtitleFbo.BeginRender();
+  GLuint transferVao = 0, transferBuffer = 0;
+  bool drawn = false;
+  if (bound)
+  {
+    // Both textures use GUI-FBO orientation; do not apply the video-PQ flip.
+    const float w = m_guiFboWidth, h = m_guiFboHeight;
+    GLfloat projection[]{2.0f / w, 0, 0, 0, 0, -2.0f / h, 0, 0,
+                        0, 0, -1, 0, -1, 1, 0, 1};
+    const GLfloat vertices[][4]{{0, 0, 0, 1}, {w, 0, 1, 1}, {0, h, 0, 0}, {w, h, 1, 0}};
+    glViewport(0, 0, m_guiFboWidth, m_guiFboHeight);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, m_guiFbo.Texture());
+    // Native output requires GLES3. A private VAO keeps caller attributes untouched.
+    glGenVertexArrays(1, &transferVao);
+    glGenBuffers(1, &transferBuffer);
+    const bool allocated = glGetError() == GL_NO_ERROR;
+    if (transferVao && transferBuffer && allocated)
+    {
+      glBindVertexArray(transferVao);
+      glBindBuffer(GL_ARRAY_BUFFER, transferBuffer);
+      glBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STREAM_DRAW);
+      glEnable(GL_BLEND);
+      glBlendEquation(GL_FUNC_ADD);
+      // Shader emits straight PQ. Accumulate premultiplied PQ and coverage over PGS.
+      glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+      m_compositeShader->SetInputPQ(false);
+      m_compositeShader->SetProjection(projection);
+      const GLint pos = m_compositeShader->GetPosLoc(), tex = m_compositeShader->GetTexLoc();
+      glVertexAttribPointer(pos, 2, GL_FLOAT, GL_FALSE, sizeof(vertices[0]), nullptr);
+      glVertexAttribPointer(tex, 2, GL_FLOAT, GL_FALSE, sizeof(vertices[0]),
+                            reinterpret_cast<const void*>(2 * sizeof(GLfloat)));
+      glEnableVertexAttribArray(pos);
+      glEnableVertexAttribArray(tex);
+      if (m_compositeShader->Enable() && glGetError() == GL_NO_ERROR)
+      {
+        glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+        drawn = glGetError() == GL_NO_ERROR;
+      }
+      m_compositeShader->Disable();
+      // The shader stores a pointer; do not leave it pointing at this stack projection.
+      m_compositeShader->SetProjection(nullptr);
+    }
+  }
+
+  for (unsigned i = 0; i < 3; ++i)
+  {
+    glActiveTexture(GL_TEXTURE0 + i);
+    glBindTexture(GL_TEXTURE_2D, textures[i]);
+    glBindSampler(i, samplers[i]);
+  }
+  glActiveTexture(active);
+  glBindVertexArray(vao);
+  glBindBuffer(GL_ARRAY_BUFFER, array);
+  glDeleteBuffers(1, &transferBuffer);
+  glDeleteVertexArrays(1, &transferVao);
+  glUseProgram(program);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, read);
+  glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+  glColorMask(mask[0], mask[1], mask[2], mask[3]);
+  glBlendFuncSeparate(blend[0], blend[1], blend[2], blend[3]);
+  glBlendEquationSeparate(blend[4], blend[5]);
+  for (unsigned i = 0; i < std::size(caps); ++i)
+    if (enabled[i]) glEnable(caps[i]); else glDisable(caps[i]);
+  const bool restored = glGetError() == GL_NO_ERROR;
+  m_dvPQGuiComposed = drawn && restored;
+  return m_dvPQGuiComposed;
+}
+
+void CWinSystemGbmGLESContext::RecordDVSubtitle(const CRect& rect, unsigned texture)
+{
+  if (!m_guiCompositing || !m_guiWillRender || rect.IsEmpty())
+    return;
+  if (!m_dvSubtitleDraws++)
+    m_dvSubtitleBounds = rect;
+  else
+    m_dvSubtitleBounds.Union(rect);
+  // A reused glyph texture keeps a paused picture reusable. Position/fade edits rekey it.
+  m_dvSubtitleContent = (m_dvSubtitleContent ^ texture) * 1099511628211ULL;
+  for (float value : {rect.x1, rect.y1, rect.x2, rect.y2})
+    m_dvSubtitleContent = (m_dvSubtitleContent ^ std::bit_cast<uint32_t>(value)) * 1099511628211ULL;
+  if (m_dvPQSubtitleRendering)
+    ++m_dvPQSubtitleDraws;
+}
+
+bool CWinSystemGbmGLESContext::BeginDVPQSubtitle()
+{
+  if (m_sdrConversion) return false;
+  if (!HasDVBridgeScreenshot() || !m_guiCompositing || !m_guiWillRender)
+    return false;
+  glGetIntegerv(GL_FRAMEBUFFER_BINDING, &m_dvPQPreviousFbo);
+  if (!m_dvPQSubtitleFbo.IsValid() || m_dvPQSubtitleWidth != m_guiFboWidth ||
+      m_dvPQSubtitleHeight != m_guiFboHeight)
+  {
+    m_dvPQSubtitleFbo.Cleanup();
+    if (!m_dvPQSubtitleFbo.Initialize() ||
+        !m_dvPQSubtitleFbo.CreateAndBindToTexture(GL_TEXTURE_2D, m_guiFboWidth,
+                                                m_guiFboHeight, GL_RGBA16F, GL_HALF_FLOAT) ||
+        (GetEnabledFrontToBackRendering() &&
+         !m_dvPQSubtitleFbo.AttachDepthBuffer(m_guiFboWidth, m_guiFboHeight)))
+    {
+      DVBRIDGE::DiagnosticLog(LOGERROR, "CB1: PQ subtitle framebuffer allocation failed");
+      m_dvPQSubtitleFbo.Cleanup();
+      glBindFramebuffer(GL_FRAMEBUFFER, m_dvPQPreviousFbo);
+      return false;
+    }
+    m_dvPQSubtitleWidth = m_guiFboWidth;
+    m_dvPQSubtitleHeight = m_guiFboHeight;
+  }
+  if (!m_dvPQSubtitleFbo.BeginRender())
+  {
+    glBindFramebuffer(GL_FRAMEBUFFER, m_dvPQPreviousFbo);
+    return false;
+  }
+  if (!m_dvPQSubtitleCleared)
+  {
+    const bool scissor = glIsEnabled(GL_SCISSOR_TEST);
+    glDisable(GL_SCISSOR_TEST);
+    glClearColor(0, 0, 0, 0);
+    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+    if (scissor) glEnable(GL_SCISSOR_TEST);
+    m_dvPQSubtitleCleared = true;
+  }
+  m_dvPQSubtitleRendering = true;
+  return true;
+}
+
+void CWinSystemGbmGLESContext::EndDVPQSubtitle()
+{
+  m_dvPQSubtitleRendering = false;
+  glBindFramebuffer(GL_FRAMEBUFFER, m_dvPQPreviousFbo);
+}
+
+void CWinSystemGbmGLESContext::DiscardDVBridgeFrame()
+{
+  // Discard unsubmitted work; accepted KMS buffers retain their retirement owner.
+  if (m_dvBridge) m_dvBridge->Cancel();
+  m_cb1FramePending = m_dvFrame = m_dvNativeGui = false;
+}
+
+bool CWinSystemGbmGLESContext::DeferRendererForOutputRestore()
+{
+  if (!m_dvStopPending || m_dvRollbackFailed)
+    return false;
+  // A successor no longer needs to wait for the idle GUI's refresh rate change.
+  if (m_modeHold.Holding() == CModeChangeHold::Kind::STOP)
+    m_modeHold.Cancel();
+  CServiceBroker::GetGUI()->GetWindowManager().MarkDirty();
+  return true;
+}
+
+bool CWinSystemGbmGLESContext::StopDVBridgePlayback()
+{
+  if (!m_dvStopPending && HoldCB1Stop())
+  {
+    m_dvStopPending=true;
+    return false;
+  }
+  if (m_modeHold.Holding() == CModeChangeHold::Kind::STOP &&
+      !m_modeHold.Commits(DVBRIDGE::DiagnosticNowMs())) return false;
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    m_masterSafety={};
+  }
+  m_masterFramePeriodNs=0;
+  m_continuousFrameEligible = false;
+  m_previousSourceStream = 0;
+  m_previousSourcePts = 0;
+  if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM)) drm->SetCB1TimingPeriod(0);
+  // The window outlives the renderer when a pending scanout defers teardown.
+  m_dvStopPending = true;
+  // Cancel an unpresented startup drawable with its existing GPU retirement.
+  if (HasPendingDVOutputSurface() && !m_dvOrdinaryFrame && !RejectDVOutputSurface())
+    return false;
+  if (!SetVideoOutput(nullptr)) return false;
+  if (!m_dvOrdinaryFrame)
+  {
+    SetGuiCompositing(0);
+    SetColorimetry(nullptr);
+    SetHDR(nullptr);
+    m_dvStopPending = false;
+  }
+  return true;
+}
+
+bool CWinSystemGbmGLESContext::EndDVBridge()
+{
+  if (!CompleteDVBridgePage())
+  {
+    m_dvEndPending = true;
+    return false;
+  }
+  if (m_failedHDR10SetupRestore && !RestoreFailedHDR10Setup())
+    return false;
+  if (m_hdrDeepColorPrevious || (m_cb1ConnectorState.Captured() && !m_dvState.Captured()))
+  {
+    auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+    if (!drm)
+      return false;
+    if (!StageCB1ConnectorPreferences(true) ||
+        (m_hdrDeepColorPrevious && !drm->AddProperty(drm->GetConnector(),
+            "DVBRIDGE_HDR10_DEEP_COLOR", *m_hdrDeepColorPrevious)))
+    {
+      drm->FlipPageTransactional(nullptr, true);
+      return false;
+    }
+    SetColorimetry(nullptr);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glDisable(GL_SCISSOR_TEST);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glClearColor(0, 0, 0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+    if (!m_dvBridge || !m_dvBridge->Advanced()) glFinish();
+    if (!m_eglContext.TrySwapBuffers())
+      return false;
+    auto& surface = m_GBM->GetDevice().GetSurface();
+    auto* bo = surface.LockTransactionalBuffer();
+    AnnounceCB1Mode(false);
+    const bool presented = drm->FlipPageTransactional(bo, true);
+    CompleteCB1Mode(presented,false);
+    surface.CompleteTransactionalBuffer(presented);
+    if (!presented)
+      return false;
+    surface.EndTransactionalMode();
+    m_hdrDeepColorPrevious.reset();
+    CompleteCB1ConnectorRestore();
+    if (DVBRIDGE::DiagnosticsEnabled())
+      DVBRIDGE::DiagnosticLog(LOGINFO, "DVBridge HDR10: native link policy restored");
+  }
+  m_cb1FramePending = m_dvFrame = false;
+  m_presentStall.Reset();
+  // Never reset Kodi's ordinary HDR GUI compositor unless we owned DV output.
+  if (!m_dvState.Captured() && !m_hdrConversion)
+  {
+    m_dvSuperseded = false;
+    m_dvEndPending = false;
+    return true;
+  }
+  if (m_dvState.Captured())
+  {
+    // Restore signaling with a clean ordinary framebuffer, never tunnel pixels.
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glDisable(GL_SCISSOR_TEST);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glClearColor(0, 0, 0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+    if (!m_dvBridge || !m_dvBridge->Advanced()) glFinish();
+    AnnounceCB1Mode(false);
+    if (!StageCB1ConnectorPreferences(true)) return false;
+    SetColorimetry(nullptr);
+    const bool restored=m_eglContext.TrySwapBuffers() && FlipDVBridgePage(m_dvState, true);
+    CompleteCB1Mode(restored,false);
+    if (!restored)
+    {
+      if (DVBRIDGE::DiagnosticsEnabled() &&
+          m_dvSetupFailures.Record(DVBRIDGE::DiagnosticNowMs(), "restore"))
+        DVBRIDGE::DiagnosticLog(LOGERROR, "DVBridge: output restoration failed; retaining scanout state; failures={}",
+            m_dvSetupFailures.Count());
+      return false;
+    }
+  }
+  if (m_hdrConversion)
+    m_dvBridge.reset();
+  else if (m_dvBridge)
+    m_dvBridge->Reset();
+  m_hdr10Session.reset();
+  m_hdr10BasicSignal.reset();
+  m_hdr10Signal.reset();
+  m_hdr10SessionStream = 0;
+  SelectPascalHDRMode(PascalHDRMode::None);
+  m_hdrConversion = false;
+  m_sdrConversion = false;
+  CompleteCB1ConnectorRestore();
+  if (DVBRIDGE::DiagnosticsEnabled() &&
+      m_dvSetupFailures.Recovered(DVBRIDGE::DiagnosticNowMs()))
+    DVBRIDGE::DiagnosticLog(LOGINFO, "DVBridge: normal display restored after failures={}", m_dvSetupFailures.Count());
+  SetGuiCompositing(0);
+  m_dvSuperseded = false;
+  m_dvEndPending = false;
+  return true;
+}
+
+bool CWinSystemGbmGLESContext::DestroyWindowSystem()
+{
+  m_modeHold.Cancel();
+  if (!EndDVBridge())
+    return false;
+  m_dvBridge.reset();
+  if (!RetireDVContext()) return false;
+  SelectPascalHDRMode(PascalHDRMode::None);
+  m_pascalHDRScanout.reset();
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    m_dvOutputTimings.clear();
+  }
+  if (!CWinSystemGbmEGLContext::DestroyWindowSystem()) return false;
+  std::lock_guard lock(m_dvCapabilityMutex);
+  const auto generation = m_dvCapabilities.generation + 1;
+  m_dvCapabilities = {};
+  m_dvAvailableNativeDV = m_dvAvailableHDR10 = false;
+  m_dvLldvStatus = {};
+  m_dvCapabilities.generation = generation;
+  m_dvImportBinding = {};
+  return true;
+}
+
+bool CWinSystemGbmGLESContext::RetireDVContext()
+{
+  if (!CompleteDVBridgePage()) return false;
+  if (m_dvBridge) m_dvBridge->Cancel();
+  m_dvBridge.reset();
+  if (!m_dvContext || !m_dvContext->GL()) return true;
+  if (!m_dvShutdownFence)
+  {
+    m_dvShutdownFence = true;
+    if (!m_dvContext->FenceLastUse()) return false;
+  }
+  if (m_dvContext->Poll() != DVBRIDGE_DV_IDLE || !m_dvContext->Close()) return false;
+  // Retain the per-video setting snapshot across graphics-context recreation.
+  m_dvShutdownFence = false;
+  return true;
+}
+
+bool CWinSystemGbmGLESContext::DestroyWindow()
+{
+  m_modeHold.Cancel();
+  if (!EndDVBridge() || !RetireDVContext()) return false;
+  // Drawable retirement must not discard deferred playback/SDR cleanup.
+  if (HasPendingDVOutputSurface() &&
+      (!m_dvOrdinaryFrame || !CompleteDVOutputSurface(false))) return false;
+  m_dvOrdinaryFrame = false;
+  SelectPascalHDRMode(PascalHDRMode::None);
+  m_pascalHDRScanout.reset();
+  if (!CWinSystemGbmEGLContext::DestroyWindow()) return false;
+  ObserveDVImport({}, {}, false);
+  return true;
+}
+#endif
+
+bool CWinSystemGbmGLESContext::CreateContext()
+{
+  const EGLint version = (m_renderableType == EGL_OPENGL_ES3_BIT) ? 3 : 2;
+
+  CEGLAttributesVec contextAttribs;
+  contextAttribs.Add({{EGL_CONTEXT_CLIENT_VERSION, version}});
+
+  if (!m_eglContext.CreateContext(contextAttribs))
+  {
+    CLog::Log(LOGERROR, "EGL context creation failed");
+    return false;
+  }
+#ifdef HAVE_DVBRIDGE
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    const auto generation = m_dvCapabilities.generation + 1;
+    m_dvCapabilities = {};
+    m_dvAvailableNativeDV = m_dvAvailableHDR10 = false;
+    m_dvOutputTimings.clear();
+    m_dvLldvStatus = {};
+    m_dvCapabilities.generation = generation;
+    m_dvImportBinding = {};
+    m_dvImportUsable = false;
+  }
+#endif
   return true;
 }
