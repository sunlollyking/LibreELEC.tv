+                                                   overlay->width, overlay->height);
+    if (!copy->palette.empty())
+      copy->palette.swap(copy->alternatePalette);
+    copy->m_isHDROverlay = m_hdrGraphics;
+    overlay = copy;
+  }
+#endif
+}
