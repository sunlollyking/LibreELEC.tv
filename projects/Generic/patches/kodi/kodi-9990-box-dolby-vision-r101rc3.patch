+#include <string>
+
+namespace AE
+{
+struct AudioSourceInfo
+{
+  bool valid{false};
+  int uniqueId{-1};
+  int64_t demuxerId{-1};
+  int codec{0};
+  int profile{-99};
+  int channels{0};
+  int sampleRate{0};
+  int bitsPerSample{0};
+  uint64_t channelMask{0};
