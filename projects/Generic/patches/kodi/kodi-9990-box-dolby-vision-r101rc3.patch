+}
+
+void CDRMAtomic::SetCB1TimingPeriod(uint64_t periodNs)
+{
+  if (!periodNs || periodNs != m_cb1TimingPeriodNs) ResetCB1Timing();
+  m_cb1TimingPeriodNs = periodNs;
+}
