+
+void CWinSystemGbmGLESContext::RefreshDVOutputCapabilities()
+{
+  const auto lldvStatus = GetLldvConnectorStatus(true);
+  const auto previous = [&] {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    auto prior = m_dvLldvStatus;
+    if (lldvStatus.connectorId != prior.connectorId ||
+        lldvStatus.edidGeneration != prior.edidGeneration)
+      m_dvOutputTimings.clear();
+    m_dvLldvStatus = lldvStatus;
+    return prior;
+  }();
+  if (eglGetCurrentContext() == EGL_NO_CONTEXT ||
+      eglGetCurrentContext() != m_eglContext.GetEGLContext()) return;
+  RefreshHDR10LinkDepth();
+  auto caps = GetDVOutputCapabilities(nullptr);
+  caps.nativeDV = SupportsNativeDVOutput();
+  caps.hdr10 = SupportsHDR10Conversion();
+  auto* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  const auto* display = GetDisplayInfo();
+  caps.hdr10plus = connector && connector->SupportsProperty("HDR10PLUS_METADATA") &&
+      display && display->HDR10PlusVersion() >= 0;
+  if (m_renderableType != EGL_OPENGL_ES3_BIT)
+  {
+    caps.processingKnown = true;
+    for (auto& mode : caps.processing) mode = {false, DVBRIDGE::OutputReason::NoGPUProcessing};
+    for (auto& mode : caps.hdr10Processing) mode = {false, DVBRIDGE::OutputReason::NoGPUProcessing};
+  }
+  else if (m_dvBridge && m_dvBridge->HasRenderer())
+  {
+    caps.processingKnown = true;
+    for (unsigned mode = 1; mode < caps.processing.size(); ++mode)
+    {
+      const bool usable=m_dvBridge->SupportsMode(static_cast<dvbridge_mode>(mode));
+      caps.processing[mode] = {usable, usable ? DVBRIDGE::OutputReason::None :
+          DVBRIDGE::OutputReason::NoGPUProcessing};
+      const bool ai=mode == DVBRIDGE_MODE_SDR ? usable :
+          m_dvBridge->SupportsHDR10AI(static_cast<dvbridge_mode>(mode));
+      caps.hdr10Processing[mode] = {ai,ai ? DVBRIDGE::OutputReason::None : DVBRIDGE::OutputReason::NoGPUProcessing};
+    }
+  }
+  else
+  {
+    CDVBridgeGLES::Context probe;
+    auto* context = m_dvContext ? m_dvContext.get() : &probe;
+    if (context->Initialize(false))
+    {
+      if (auto* renderer = context->Attach())
+      {
+        const bool common = pl_opengl_has_ext(context->GL(), "GL_EXT_float_blend") &&
+            pl_opengl_has_ext(context->GL(), "GL_OES_texture_float_linear");
+        caps.processingKnown = true;
+        for (unsigned mode = 1; mode < caps.processing.size(); ++mode)
+        {
+          const bool usable=common && dvbridge_renderer_supports_mode(renderer, static_cast<dvbridge_mode>(mode));
+          caps.processing[mode] = {usable, usable ? DVBRIDGE::OutputReason::None :
+              DVBRIDGE::OutputReason::NoGPUProcessing};
+          const bool ai=mode == DVBRIDGE_MODE_SDR ? usable :
+              common && dvbridge_renderer_supports_hdr10_ai(renderer,static_cast<dvbridge_mode>(mode));
+          caps.hdr10Processing[mode] = {ai,ai ? DVBRIDGE::OutputReason::None : DVBRIDGE::OutputReason::NoGPUProcessing};
+        }
+        context->Detach(renderer);
+      }
+    }
+  }
+  const bool availableNativeDV = SupportsNativeDVOutput(false);
+  const bool availableHDR10 = SupportsHDR10Conversion(false);
+  auto timings = GetDVOutputTimings();
+  std::lock_guard lock(m_dvCapabilityMutex);
+  if (lldvStatus.edidGeneration != previous.edidGeneration ||
+      lldvStatus.connectorId != previous.connectorId ||
+      lldvStatus.driverFormats != previous.driverFormats ||
+      lldvStatus.forced42210 != previous.forced42210)
+  {
+    const auto& display = lldvStatus.display;
+    CLog::Log(LOGINFO, "CB1 LLDV: connector={} edid_generation={} edid_bytes={}/{} dolby_block={} "
+        "version={} length={} target={} compatibility={} peak={:.3f} black={:.6f} "
+        "read_rgb_xy={:.6f},{:.6f}/{:.6f},{:.6f}/{:.6f},{:.6f} "
+        "used_rgb_xy={:.6f},{:.6f}/{:.6f},{:.6f}/{:.6f},{:.6f} "
+        "driver_formats={:#x} forced_422_10={} timing_current={} timing_available={}",
+        lldvStatus.connectorId, lldvStatus.edidGeneration, display.received, display.expected,
+        dvbridge_edid_reason(display.sink.status), display.sink.version, display.sink.length,
+        DVBRIDGE::LldvEdidReason(display.status), DVBRIDGE::LldvCompatibilityReason(lldvStatus, 0),
+        display.peak, display.black, display.reported[0], display.reported[1], display.reported[2],
+        display.reported[3], display.reported[4], display.reported[5], display.primaries[0],
+        display.primaries[1], display.primaries[2], display.primaries[3], display.primaries[4],
+        display.primaries[5], lldvStatus.driverFormats, lldvStatus.forced42210,
+        lldvStatus.currentTiming, lldvStatus.availableTiming);
+  }
+  m_dvCapabilities = caps;
+  m_dvAvailableNativeDV = availableNativeDV;
+  m_dvAvailableHDR10 = availableHDR10;
+  m_dvOutputTimings = std::move(timings);
+  if (DVBRIDGE::DiagnosticsEnabled())
+  {
+    try
+    {
+      const auto* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+      const auto* displayInfo = GetDisplayInfo();
+      const bool inventory = connector && connector->HasPropertyInventory();
+      const DVBRIDGE::DiagnosticProperty dv(inventory,
+          inventory ? connector->GetPropertyValue("DVBRIDGE_DV_STANDARD_LAB") : std::nullopt);
+      DVBRIDGE::DiagnosticLog(LOGINFO,
+          "DVBridge capabilities: origin=initial-or-mode-refresh connector={} connection_generation=unknown graphics_generation={} edid_status={} edid_version={} dv_property={} dv_value={} native_dv={} available_native_dv={} hdr10={} link_type=unknown",
+          connector ? connector->GetId() : 0,caps.generation,
+          displayInfo ? dvbridge_edid_reason(displayInfo->GetDolbyVisionCaps().status) : "unknown",
+          displayInfo ? std::to_string(displayInfo->GetDolbyVisionCaps().version) : "unavailable",
+          dv.Presence(),dv.Value(),caps.nativeDV,availableNativeDV,caps.hdr10);
+    }
+    catch (...) {}
+  }
+}
+
+bool CWinSystemGbmGLESContext::SupportsDVOutputTiming(const RESOLUTION_INFO& mode) const
+{
+  if (mode.dwFlags & D3DPRESENTFLAG_MODEMASK)
+    return false;
+
+  const auto* end = mode.strId.data() + mode.strId.size();
+  int index = -1;
+  const auto parsed = std::from_chars(mode.strId.data(), end, index);
+  if (parsed.ec != std::errc{} || parsed.ptr != end || index < 0)
+    return false;
+
+  // The connector's mode indices can change before Kodi rebuilds its resolution catalogue.
+  std::lock_guard lock(m_dvCapabilityMutex);
+  return std::ranges::any_of(m_dvOutputTimings, [&](const DVOutputTiming& timing) {
+    return timing.index == index && timing.width == mode.iScreenWidth &&
+           timing.height == mode.iScreenHeight &&
+           std::abs(timing.refresh - static_cast<double>(mode.fRefreshRate)) < 0.01;
+  });
+}
+
+RESOLUTION CWinSystemGbmGLESContext::ChooseHDR10FallbackResolution(RESOLUTION chosen) const
+{
+  const auto& display = CDisplaySettings::GetInstance();
+  const auto original = display.GetResolutionInfoCopy(chosen);
+  const auto advanced = CServiceBroker::GetSettingsComponent()->GetAdvancedSettings();
+  if (SupportsDVOutputTiming(original) || CResolutionUtils::HasWhitelist() ||
+      !advanced->m_videoAdjustRefreshOverrides.empty())
+    return chosen;
+  std::vector<RESOLUTION> candidates;
+  GetGfxContext().GetAllowedResolutions(candidates);
+  RESOLUTION best = chosen;
+  int bestArea = 0;
+  for (const RESOLUTION candidate : candidates)
+  {
+    const auto mode = display.GetResolutionInfoCopy(candidate);
+    if (std::abs(mode.fRefreshRate - original.fRefreshRate) < 0.01f &&
+        SupportsDVOutputTiming(mode))
+    {
+      const int area = mode.iScreenWidth * mode.iScreenHeight;
+      if (area > bestArea)
+      {
+        best = candidate;
+        bestArea = area;
+      }
+    }
+  }
+  if (best != chosen)
+    CLog::Log(LOGDEBUG, "CB1 HDR10 fallback: selected {} (original mode {})",
+              display.GetResolutionInfoCopy(best).strMode, original.strMode);
+  return best;
+}
+
+bool CWinSystemGbmGLESContext::CanRetainDVSource() const
+{
+  const auto preferences = DVBRIDGE::FrameOutputSettings();
+  if (preferences.output == DVBRIDGE::OutputMode::Disabled) return false;
+  const auto caps = GetDVOutputCapabilities(nullptr, true);
+  if (preferences.hdr10TransportFallback)
+    return caps.hdr10 && !caps.HDR10DepthLimited() &&
+        (!caps.processingKnown || caps.processing[DVBRIDGE_MODE_HDR10_BASIC].usable);
+  if (preferences.output == DVBRIDGE::OutputMode::SDR)
+    return SupportsSDRConversion() && (!caps.processingKnown || caps.processing[DVBRIDGE_MODE_SDR].usable);
+  if (preferences.output == DVBRIDGE::OutputMode::PlayerLed)
+    return caps.playerLed && (!caps.processingKnown || caps.processing[DVBRIDGE_MODE_PLAYER_LED].usable);
+  if (!caps.nativeDV && !caps.hdr10) return false;
+  if (!caps.processingKnown) return true;
+  const auto mode = preferences.Policy().mode;
+  return caps.processing[mode].usable &&
+      (preferences.output == DVBRIDGE::OutputMode::HDR10 ? caps.hdr10 : caps.nativeDV);
+}
+
+bool CWinSystemGbmGLESContext::LldvSupportsPlaybackTiming(double fps, bool requireCurrentMode) const
+{
+  std::lock_guard lock(m_dvCapabilityMutex);
+  return !m_dvLldvStatus.cta93FractionalOnly ||
+         ((!requireCurrentMode || m_dvLldvStatus.currentTiming) && std::abs(fps - 24000.0 / 1001) < 0.01);
+}
+
+std::optional<RESOLUTION> CWinSystemGbmGLESContext::PlayerLedResolution(double fps, bool atStartup) const
+{
+  const auto preferences = DVBRIDGE::FrameOutputSettings();
+  if (preferences.output != DVBRIDGE::OutputMode::PlayerLed ||
+      preferences.hdr10TransportFallback || !std::isfinite(fps) || !LldvSupportsPlaybackTiming(fps) ||
+      !GetDVOutputCapabilities(nullptr, preferences, true).playerLed)
+    return {};
+  constexpr std::array rates{24000.0 / 1001, 24.0, 25.0, 30000.0 / 1001, 30.0};
+  const auto rate = std::find_if(rates.begin(), rates.end(),
+                                [fps](double rate) { return std::abs(fps - rate) < 0.01; });
+  if (rate == rates.end())
+    return {};
+  const double wanted = *rate;
+
+  const auto& settings = CDisplaySettings::GetInstance();
+  std::optional<RESOLUTION> rejected;
+  for (size_t index = RES_DESKTOP; index < settings.ResolutionInfoSize(); ++index)
+  {
+    const auto mode = settings.GetResolutionInfoCopy(static_cast<RESOLUTION>(index));
+    if (mode.iWidth == 3840 && mode.iHeight == 2160 &&
+        mode.iScreenWidth == 3840 && mode.iScreenHeight == 2160 &&
+        std::abs(static_cast<double>(mode.fRefreshRate) - wanted) < 0.01 &&
+        !(mode.dwFlags & (D3DPRESENTFLAG_MODEMASK)))
+    {
+      const auto target = static_cast<RESOLUTION>(index);
+      const int reason = PlayerLedResolutionReason(target, preferences.lldvFormat);
+      if (!reason) return target;
+      if (atStartup && !rejected && reason == DVBRIDGE::LLDV_DRIVER_REJECTED_LABEL)
+        rejected = target;
+    }
+  }
+  return rejected;
+}
+
+int CWinSystemGbmGLESContext::PlayerLedResolutionReason(RESOLUTION resolution, int preference) const
+{
+  const auto id = CDisplaySettings::GetInstance().GetResolutionInfoCopy(resolution).strId;
+  int modeIndex = -1;
+  const auto end = id.data() + id.size();
+  const auto parsed = std::from_chars(id.data(), end, modeIndex);
+  const bool validIndex = parsed.ec == std::errc{} && parsed.ptr == end && modeIndex >= 0;
+
+  std::lock_guard lock(m_dvCapabilityMutex);
+  if (resolution == RES_INVALID)
+    return DVBRIDGE::LldvUnavailableLabel(m_dvLldvStatus, preference, false);
+
+  const auto& modes = m_dvLldvStatus.modeRejections;
+  const auto mode = validIndex ? std::ranges::find(modes, modeIndex, &std::pair<int, unsigned>::first)
+                               : modes.end();
+  auto target = m_dvLldvStatus;
+  target.currentTiming = mode != modes.end();
+  target.currentRejected = target.currentTiming ? mode->second : 0;
+  return DVBRIDGE::LldvUnavailableLabel(target, preference, false);
+}
+
+std::optional<RESOLUTION> CWinSystemGbmGLESContext::PlayerLedStartupHDR10Resolution(
+    RESOLUTION resolution, int preference) const
+{
+  constexpr int timingUnavailable = 41212;
+  const int reason = PlayerLedResolutionReason(resolution, preference);
+  if (reason != DVBRIDGE::LLDV_DRIVER_REJECTED_LABEL && reason != timingUnavailable)
+    return std::nullopt;
+
+  const bool allowModeSwitch = resolution != RES_INVALID;
+  const auto target = allowModeSwitch ? ChooseHDR10FallbackResolution(resolution) : RES_INVALID;
+  if (allowModeSwitch &&
+      !SupportsDVOutputTiming(CDisplaySettings::GetInstance().GetResolutionInfoCopy(target)))
+    return std::nullopt;
+
+  const auto caps = GetDVOutputCapabilities(nullptr, allowModeSwitch);
+  if (!caps.hdr10 || caps.HDR10DepthLimited())
+    return std::nullopt;
+  return target;
+}
+
+bool CWinSystemGbmGLESContext::CompleteDVModeSwitch(const VideoPicture& picture)
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  const bool supported = m_dvSelection.route == DVBRIDGE::OutputRoute::PlayerLed ?
+      GetLldvConnectorStatus().currentTiming : m_dvSelection.route == DVBRIDGE::OutputRoute::SDR ?
+      SupportsSDRConversion() : SupportsDVOutputMode();
+  if (supported && drm && (drm->IsSelectedModeCommitted() ||
+      m_modeHold.Holding() == CModeChangeHold::Kind::START)) return true;
+  // An advertised mode can still fail its real modeset. Reuse the existing
+  // per-source activation failure latch; never wait or retry every frame.
+  ResetDVActivation(&picture);
+  std::lock_guard lock(m_dvCapabilityMutex);
+  m_dvNativeFailed = m_dvHDR10Failed = m_dvSDRFailed = m_dvPlayerLedFailed = m_dvFallbackActive = true;
+  m_dvActivationReason = DVBRIDGE::OutputReason::ActivationFailed;
+  m_dvFailedStream = m_dvActivationStream;
+  m_dvFailedPolicy = m_dvActivationPolicy;
+  return false;
+}
+
+void CWinSystemGbmGLESContext::ObserveDVImport(DVBRIDGE::SourceBinding binding,
+                                              dvbridge_geometry geometry, bool usable)
+{
+  std::lock_guard lock(m_dvCapabilityMutex);
+  if (eglGetCurrentContext() != m_eglContext.GetEGLContext()) binding = {};
+  m_dvImportBinding = binding;
+  m_dvImportGeometry = geometry;
+  m_dvImportUsable = usable;
+  m_dvImportGeneration = m_dvCapabilities.generation;
+  if (binding.Valid() && (binding.stream != m_dvFatalBinding.stream ||
+                          binding.revision != m_dvFatalBinding.revision))
+  {
+    m_dvFatalBinding = binding;
+    m_dvFatalReason = DVBRIDGE::OutputReason::None;
+    m_dvFatalConsumed = false;
+  }
+}
