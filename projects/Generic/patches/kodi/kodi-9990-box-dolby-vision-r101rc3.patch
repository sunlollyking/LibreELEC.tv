diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVMetadataBuffer.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVMetadataBuffer.h
new file mode 100644
index 0000000000..20cbd4ba74
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVMetadataBuffer.h
@@ -0,0 +1,94 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+extern "C"
+{
+#include <libavutil/buffer.h>
+}
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <atomic>
+#include <algorithm>
+#include <limits>
+
+namespace DVBRIDGE
+{
+struct SourceBinding
+{
+  uint64_t stream{}, picture{}, revision{};
+  bool Valid() const { return stream && picture && revision; }
+  bool operator==(const SourceBinding&) const = default;
+};
+struct SourceInfo
+{
+  unsigned profile{}, level{}, major{}, minor{}, bits{};
+  int format{-1};
+  bool bl{}, el{}, rpu{}, mastering{}, light{};
+  double maxLuma{}, minLuma{};
+  unsigned maxCLL{}, maxFALL{};
+  unsigned compatibility{};
+  uint64_t informationGeneration{};
+  bool frameRpu{};
+};
+// Native source epochs and preference changes share a monotonic revision domain.
+inline std::atomic<uint64_t> nativeRevision{1};
+inline uint64_t NextRevisionAfter(uint64_t minimum)
+{
+  auto previous = nativeRevision.load();
+  for (;;)
+  {
+    const auto last = std::max(previous,minimum);
+    if (last == std::numeric_limits<uint64_t>::max()) return 0;
+    if (nativeRevision.compare_exchange_weak(previous,last+1)) return last+1;
+  }
+}
+inline uint64_t NextRevision() { return NextRevisionAfter(0); }
+class SourceOwner
+{
+public:
+  void BeginStream() { m_stream = NextRevision(); m_revision = m_stream; m_picture = 0; }
+  uint64_t Stream() const { return m_stream; }
+  void Seek() { m_revision = NextRevision(); }
+  SourceBinding NextPicture() { return {m_stream,++m_picture,m_revision}; }
+private:
+  uint64_t m_stream{}, m_picture{}, m_revision{};
+};
+}
+
+class CDVMetadataBuffer
+{
+public:
+  bool Assign(const uint8_t* data, size_t size, DVBRIDGE::SourceBinding binding = {})
+  {
+    if (!data || size == 0 || size > MAX_PAYLOAD_SIZE)
+    {
+      Reset();
+      return false;
+    }
+
+    AVBufferRef* buffer = av_buffer_alloc(size);
+    if (!buffer)
+    {
+      Reset();
+      return false;
+    }
+    std::memcpy(buffer->data, data, size);
+    m_buffer = std::shared_ptr<AVBufferRef>(buffer, [](AVBufferRef* ref) { av_buffer_unref(&ref); });
+    m_binding = binding;
+    return true;
+  }
+
+  void Reset() { m_buffer.reset(); m_binding = {}; }
+  const uint8_t* Data() const { return m_buffer ? m_buffer->data : nullptr; }
+  size_t Size() const { return m_buffer ? m_buffer->size : 0; }
+  DVBRIDGE::SourceBinding Binding() const { return m_binding; }
+
+private:
+  // Bound unexpected side data before allocating; no truncation is allowed.
+  static constexpr size_t MAX_PAYLOAD_SIZE = 1024 * 1024;
+  std::shared_ptr<AVBufferRef> m_buffer;
+  DVBRIDGE::SourceBinding m_binding;
+};
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSelection.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSelection.h
new file mode 100644
index 0000000000..a7b3e9ecec
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSelection.h
@@ -0,0 +1,140 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "DVOutputSettings.h"
+#include "DVPlaybackInfo.h"
+#ifdef HAVE_DVBRIDGE
+#include <algorithm>
+#include <array>
+
+namespace DVBRIDGE
+{
+enum class OutputRoute { Vanilla, NativeDV, HDR10, SDR, PlayerLed };
+struct OutputSelection
+{
+  OutputRoute route{OutputRoute::Vanilla};
+  dvbridge_policy policy{};
+  OutputReason reason{OutputReason::None};
+  int lldvFormat{};
+  uint64_t lldvEdidGeneration{};
+  unsigned lldvRgbScanoutBits{8};
+};
+
+inline OutputSelection SelectOutput(const OutputPreferences& preferences,
+                                    const OutputCapabilities& caps)
+{
+  OutputSelection result;
+  if (caps.stereoSource)
+    return {OutputRoute::Vanilla, {}, OutputReason::SourceIneligible};
+  if (caps.sourceKnown && (caps.isHLG || caps.isHDR10) && !caps.isDV)
+  {
+    const auto source = caps.isHLG ? preferences.HLGMode() : preferences.HDR10Mode(caps.hdr10PlusSource);
+    if (source == HDR10SourceMode::Native) return result;
+    if (caps.hdr10PlusSource && source != HDR10SourceMode::HDR10PlusDV && source != HDR10SourceMode::SDR)
+      return {OutputRoute::Vanilla,{},OutputReason::SourceIneligible};
+    if (source == HDR10SourceMode::HDR10PlusDV && !caps.isHDR10Plus)
+      return {OutputRoute::Vanilla,{},OutputReason::SourceIneligible};
+    auto policy = preferences.HDR10PolicyFor(source);
+    if (policy.mode == DVBRIDGE_MODE_DISABLED)
+      return {OutputRoute::Vanilla,{},OutputReason::SourceIneligible};
+    if (policy.mode == DVBRIDGE_MODE_SDR)
+    {
+      if (!preferences.ProfileValid(policy.mode)) return {OutputRoute::Vanilla,{},OutputReason::SDRTargetInvalid};
+      if (!caps.processingKnown || !caps.processing[policy.mode].usable)
+        return {OutputRoute::Vanilla,{},!caps.processingKnown ? OutputReason::ProcessingPending : caps.processing[policy.mode].reason!=OutputReason::None ?
+            caps.processing[policy.mode].reason : OutputReason::NoGPUProcessing};
+      return {OutputRoute::SDR,policy,OutputReason::None};
+    }
+    if (policy.mode != DVBRIDGE_MODE_STANDARD && !preferences.ProfileValid(policy.mode))
+      return {OutputRoute::Vanilla,{},OutputReason::TVProfileRequired};
+    if (!caps.nativeDV)
+      return {OutputRoute::Vanilla,{},OutputReason::NoDVTransport};
+    if (!caps.processingKnown || !caps.processing[policy.mode].usable)
+      return {OutputRoute::Vanilla,{},!caps.processingKnown ? OutputReason::ProcessingPending : caps.processing[policy.mode].reason!=OutputReason::None ?
+          caps.processing[policy.mode].reason : OutputReason::NoGPUProcessing};
+    return {OutputRoute::NativeDV,policy,OutputReason::None};
+  }
+  if (!caps.sourceKnown || !caps.isDV || preferences.output == OutputMode::Disabled)
+    return result;
+  auto policy = preferences.Policy();
+  result.policy=policy;
+  if (preferences.hdr10TransportFallback)
+  {
+    if (caps.HDR10DepthLimited())
+      return {OutputRoute::Vanilla, policy, OutputReason::HDR10LinkDepthTooLow};
+    if (!caps.hdr10)
+      return {OutputRoute::Vanilla, policy, OutputReason::NoHDR10Transport};
+    auto hdr10 = preferences;
+    hdr10.output = OutputMode::HDR10;
+    hdr10.method = 0;
+    policy = hdr10.Policy();
+    if (!caps.processingKnown)
+      return {OutputRoute::Vanilla, policy, OutputReason::ProcessingPending};
+    const auto& admission = caps.processing[policy.mode];
+    if (!admission.usable)
+      return {OutputRoute::Vanilla, policy, admission.reason != OutputReason::None ?
+          admission.reason : OutputReason::NoGPUProcessing};
+    return {OutputRoute::HDR10, policy, preferences.output == OutputMode::PlayerLed ?
+        OutputReason::NoPlayerLedTransport : OutputReason::NoDVTransport};
+  }
+  if (policy.mode == DVBRIDGE_MODE_PLAYER_LED)
+  {
+    if (!caps.playerLed) result.reason = OutputReason::NoPlayerLedTransport;
+    else if (!caps.processingKnown) result.reason = OutputReason::ProcessingPending;
+    else if (const auto& mode = caps.processing[policy.mode]; !mode.usable)
+      result.reason = mode.reason == OutputReason::None ? OutputReason::NoGPUProcessing : mode.reason;
+    else
+    {
+      result.route = OutputRoute::PlayerLed;
+      const auto& display = caps.lldvDisplay;
+      result.policy.tv = {display.peak, DVBRIDGE_PANEL_UNSET, DVBRIDGE_GAMUT_BT2020};
+      result.policy.expert_black_nits = display.black;
+      result.policy.lldv_edid_generation = caps.lldvEdidGeneration;
+      result.policy.lldv_edid_version = display.sink.version;
+      std::copy(display.primaries.begin(), display.primaries.end(), result.policy.lldv_primaries);
+      result.lldvEdidGeneration = caps.lldvEdidGeneration;
+      result.lldvRgbScanoutBits = caps.lldvRgbScanoutBits;
+    }
+    result.lldvFormat = preferences.lldvFormat;
+    return result;
+  }
+  if (policy.mode == DVBRIDGE_MODE_SDR)
+  {
+    if (!preferences.ProfileValid(policy.mode)) return {OutputRoute::Vanilla,{},OutputReason::SDRTargetInvalid};
+    if (!caps.processingKnown || !caps.processing[policy.mode].usable)
+      return {OutputRoute::Vanilla,{},!caps.processingKnown ? OutputReason::ProcessingPending : caps.processing[policy.mode].reason!=OutputReason::None ?
+          caps.processing[policy.mode].reason : OutputReason::NoGPUProcessing};
+    return {OutputRoute::SDR,policy,OutputReason::None};
+  }
+  if ((policy.mode == DVBRIDGE_MODE_HDR10_BASIC || policy.mode == DVBRIDGE_MODE_HDR10_EXPERT) &&
+      caps.HDR10DepthLimited())
+    return {OutputRoute::Vanilla, policy, OutputReason::HDR10LinkDepthTooLow};
+  // Display configuration is known before the first GPU import.
+  if (preferences.output == OutputMode::HDR10 && policy.mode == DVBRIDGE_MODE_HDR10_EXPERT &&
+      !preferences.ProfileValid(policy.mode))
+    return {OutputRoute::Vanilla, {}, OutputReason::TVProfileRequired};
+  if (!caps.processingKnown)
+  {
+    result.reason = OutputReason::ProcessingPending;
+    return result;
+  }
+  if (policy.mode == DVBRIDGE_MODE_HDR10PLUS && !caps.hdr10plus)
+    return {OutputRoute::Vanilla, policy, OutputReason::NoHDR10PlusTransport};
+  const auto admission = [&](dvbridge_mode mode) {
+    if ((mode == DVBRIDGE_MODE_HDR10_EXPERT || mode == DVBRIDGE_MODE_ENHANCED_DV) &&
+        !preferences.ProfileValid(mode))
+      return ModeAdmission{false, OutputReason::TVProfileRequired};
+    auto value = caps.processing[mode];
+    if (!value.usable && value.reason == OutputReason::None)
+      value.reason = OutputReason::NoGPUProcessing;
+    return value;
+  };
+  const bool requestedDV = preferences.output != OutputMode::HDR10;
+  auto candidate = admission(policy.mode);
+  if ((requestedDV ? caps.nativeDV : caps.hdr10) && candidate.usable)
+    return {requestedDV ? OutputRoute::NativeDV : OutputRoute::HDR10, policy, OutputReason::None};
+  result.reason = !(requestedDV ? caps.nativeDV : caps.hdr10) ?
+      (requestedDV ? OutputReason::NoDVTransport : OutputReason::NoHDR10Transport) : candidate.reason;
+  return {OutputRoute::Vanilla, policy, result.reason};
+}
+} // namespace DVBRIDGE
+#endif
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h
new file mode 100644
index 0000000000..c3b7fe9569
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h
@@ -0,0 +1,371 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "ServiceBroker.h"
+#include "settings/Settings.h"
+#include "settings/SettingsComponent.h"
+#include "DVMetadataBuffer.h"
+#include <atomic>
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <mutex>
+#include <optional>
+#ifdef HAVE_DVBRIDGE
+#include "dvbridge_policy.h"
+#include "cb1_cmv40.h"
+#endif
+
+namespace DVBRIDGE
+{
+enum class OutputMode : int { Standard = 0, HDR10 = 1, Disabled = 2, EnhancedDV = 3, MasterReference = 4, AdaptiveB = 5, SDR = 6, PlayerLed = 7 };
+enum class HDR10SourceMode : int
+{
+  Native = 0, ReferenceDV = 1, EnhancedDV = 2, HDR10PlusDV = 3, SDR = 4, HDR10PlusPassthrough = 5
+};
+
+enum class HLGSourceMode : int { Native = 0, ReferenceDV = 1, SDR = 2 };
+
+// Decoder ingress sees the last complete frame-boundary preference snapshot.
+inline std::atomic<OutputMode> playbackMode{OutputMode::Standard};
+inline std::atomic<HDR10SourceMode> hdr10PlaybackMode{HDR10SourceMode::Native};
+inline std::atomic<HDR10SourceMode> hdr10PlusPlaybackMode{HDR10SourceMode::Native};
+inline std::atomic<HDR10SourceMode> hlgPlaybackMode{HDR10SourceMode::Native};
+
+#ifdef HAVE_DVBRIDGE
+inline int PolicyCode(const dvbridge_policy& policy)
+{
+  if (policy.mode==DVBRIDGE_MODE_PLAYER_LED) return 9;
+  if (policy.mode==DVBRIDGE_MODE_SDR) return 8;
+  if (policy.mode==DVBRIDGE_MODE_HDR10PLUS) return 7;
+  return policy.mode==DVBRIDGE_MODE_ENHANCED_DV && policy.adaptive!=DVBRIDGE_ADAPTIVE_A ? 6 : int(policy.mode);
+}
+#endif
+
+struct OutputPreferences
+{
+  OutputMode output{OutputMode::Standard};
+  HDR10SourceMode hdr10Source{HDR10SourceMode::Native};
+  HDR10SourceMode hdr10PlusSource{HDR10SourceMode::Native};
+  HLGSourceMode hlgSource{HLGSourceMode::Native};
+  int sdrPreset{0};
+  bool sdrBT2020{};
+  double sdrPeak{100}, sdrGamma{2.4}, sdrBlack{0};
+  int method{0}, panel{0}, gamut{0};
+  double peak{0};
+  double expertPeak{}, expertBlack{};
+  int expertGamut{};
+  int lldvFormat{};
+  bool hdr10TransportFallback{};
+  bool optimizedDV{true};
+  bool masterIPT{false};
+  bool disableL2Trims{false};
+  int cmv40Mode{}, cmv40Trigger{}, cmv40Headroom{20};
+  int felUpscaling{0};
+  bool processingOptimizations{false};
+  uint64_t revision{1};
+
+  bool ProfileValid() const
+  {
+    return std::isfinite(peak) && peak > 0 && peak <= 10000 &&
+        panel >= 0 && panel <= 2 && gamut >= 1 && gamut <= 3;
+  }
+
+  bool ExpertProfileValid() const
+  {
+    return std::isfinite(expertPeak) && expertPeak>=50 && expertPeak<=10000 &&
+        std::isfinite(expertBlack) && expertBlack>=0 && expertBlack<=0.5 &&
+        expertGamut>=1 && expertGamut<=3;
+  }
+
+  HDR10SourceMode HLGMode() const
+  {
+    switch (hlgSource)
+    {
+      case HLGSourceMode::ReferenceDV: return HDR10SourceMode::ReferenceDV;
+      case HLGSourceMode::SDR: return HDR10SourceMode::SDR;
+      default: return HDR10SourceMode::Native;
+    }
+  }
+
+  HDR10SourceMode HDR10Mode(bool hdr10Plus) const
+  {
+    if (!hdr10Plus)
+      return hdr10Source;
+    // Passthrough uses Kodi's native renderer. HDMI signalling uses the saved selector.
+    return hdr10PlusSource == HDR10SourceMode::HDR10PlusPassthrough ?
+        HDR10SourceMode::Native : hdr10PlusSource;
+  }
+
+  bool SameValues(const OutputPreferences& other) const
+  {
+    return output == other.output && hdr10TransportFallback == other.hdr10TransportFallback &&
+        hdr10Source == other.hdr10Source &&
+        hdr10PlusSource == other.hdr10PlusSource && hlgSource == other.hlgSource &&
+        sdrPreset == other.sdrPreset && sdrBT2020 == other.sdrBT2020 &&
+        std::bit_cast<uint64_t>(sdrPeak) == std::bit_cast<uint64_t>(other.sdrPeak) &&
+        std::bit_cast<uint64_t>(sdrGamma) == std::bit_cast<uint64_t>(other.sdrGamma) &&
+        std::bit_cast<uint64_t>(sdrBlack) == std::bit_cast<uint64_t>(other.sdrBlack) && method == other.method &&
+        panel == other.panel && gamut == other.gamut && optimizedDV == other.optimizedDV &&
+        masterIPT == other.masterIPT &&
+        disableL2Trims == other.disableL2Trims &&
+        cmv40Mode == other.cmv40Mode && cmv40Trigger == other.cmv40Trigger &&
+        cmv40Headroom == other.cmv40Headroom &&
+        felUpscaling == other.felUpscaling &&
+        processingOptimizations == other.processingOptimizations &&
+        ((output!=OutputMode::HDR10 || method!=1) ||
+         (expertPeak == other.expertPeak && expertBlack == other.expertBlack && expertGamut == other.expertGamut)) &&
+        (output!=OutputMode::PlayerLed || lldvFormat==other.lldvFormat) &&
+        std::bit_cast<uint64_t>(peak) == std::bit_cast<uint64_t>(other.peak);
+  }
+
+#ifdef HAVE_DVBRIDGE
+  bool ProfileValid(dvbridge_mode mode) const
+  {
+    if (mode==DVBRIDGE_MODE_SDR)
+    {
+      if (sdrPreset==0 || sdrPreset==1) return true;
+      return sdrPreset==2 && std::isfinite(sdrPeak) && sdrPeak>=20 && sdrPeak<=500 &&
+          std::isfinite(sdrGamma) && sdrGamma>=1.8 && sdrGamma<=2.8 &&
+          std::isfinite(sdrBlack) && sdrBlack>=0 && sdrBlack<=5 && sdrBlack<sdrPeak;
+    }
+    return mode==DVBRIDGE_MODE_HDR10_EXPERT ? ExpertProfileValid() : ProfileValid();
+  }
+  bool L2TrimsDisabled(dvbridge_mode mode, bool hdr10AI = false) const
+  {
+    return disableL2Trims && !hdr10AI &&
+        (mode == DVBRIDGE_MODE_STANDARD || mode == DVBRIDGE_MODE_MASTER_REFERENCE ||
+         mode == DVBRIDGE_MODE_PLAYER_LED);
+  }
+  cb1_cmv40_options CMv40Options(dvbridge_mode mode, bool hdr10AI = false) const
+  {
+    if (hdr10AI || (mode != DVBRIDGE_MODE_STANDARD && mode != DVBRIDGE_MODE_MASTER_REFERENCE &&
+                    mode != DVBRIDGE_MODE_PLAYER_LED)) return {};
+    return {static_cast<cb1_cmv40_mode>(cmv40Mode), static_cast<unsigned>(cmv40Trigger),
+        static_cast<unsigned>(cmv40Headroom), peak};
+  }
+  dvbridge_policy Policy() const
+  {
+    dvbridge_policy result{};
+    result.revision = revision;
+    result.sdr={static_cast<dvbridge_sdr_preset>(sdrPreset),sdrPeak,sdrGamma,sdrBlack,
+        sdrBT2020 ? DVBRIDGE_GAMUT_BT2020 : DVBRIDGE_GAMUT_BT709};
+    switch (output)
+    {
+      case OutputMode::PlayerLed: result.mode = DVBRIDGE_MODE_PLAYER_LED; break;
+      case OutputMode::SDR: result.mode = DVBRIDGE_MODE_SDR; break;
+      case OutputMode::Disabled: result.mode = DVBRIDGE_MODE_DISABLED; break;
+      case OutputMode::Standard: result.mode = DVBRIDGE_MODE_STANDARD; break;
+      case OutputMode::EnhancedDV:
+      case OutputMode::AdaptiveB:
+        result.mode=DVBRIDGE_MODE_ENHANCED_DV;
+        result.adaptive=DVBRIDGE_ADAPTIVE_B_FP16;
+        break;
+      case OutputMode::MasterReference:
+        result.mode = DVBRIDGE_MODE_MASTER_REFERENCE; result.master_ipt = masterIPT; break;
+      case OutputMode::HDR10:
+        result.mode = method == 2 ? DVBRIDGE_MODE_HDR10PLUS :
+            method == 1 ? DVBRIDGE_MODE_HDR10_EXPERT : DVBRIDGE_MODE_HDR10_BASIC;
+        break;
+    }
+    // Basic/native paths never consume calibration. Keep invalid user values
+    // in this snapshot, rather than silently completing the stored profile.
+    if (result.mode == DVBRIDGE_MODE_HDR10_EXPERT)
+    {
+      result.tv={expertPeak,DVBRIDGE_PANEL_OLED,static_cast<dvbridge_gamut>(expertGamut)};
+      result.expert_black_nits=expertBlack;
+    }
+    else if (result.mode == DVBRIDGE_MODE_ENHANCED_DV)
+      result.tv = {peak, static_cast<dvbridge_panel>(panel), static_cast<dvbridge_gamut>(gamut)};
+    return result;
+  }
+  dvbridge_policy HDR10Policy(bool hdr10Plus = false) const
+  {
+    return HDR10PolicyFor(HDR10Mode(hdr10Plus));
+  }
+  dvbridge_policy HDR10PolicyFor(HDR10SourceMode source) const
+  {
+    auto result = Policy();
+    result.master_ipt=false;
+    result.expert_black_nits=0;
+    result.mode = source == HDR10SourceMode::ReferenceDV ||
+        source == HDR10SourceMode::HDR10PlusDV ? DVBRIDGE_MODE_STANDARD :
+        source == HDR10SourceMode::EnhancedDV ? DVBRIDGE_MODE_ENHANCED_DV :
+        source == HDR10SourceMode::SDR ? DVBRIDGE_MODE_SDR : DVBRIDGE_MODE_DISABLED;
+    // Same scene expansion as Adaptive DV, with predicted rather than authored guidance.
+    result.adaptive = result.mode == DVBRIDGE_MODE_ENHANCED_DV ?
+        DVBRIDGE_ADAPTIVE_B_FP16 : DVBRIDGE_ADAPTIVE_A;
+    result.tv = result.mode == DVBRIDGE_MODE_ENHANCED_DV ?
+        dvbridge_tv_profile{peak,static_cast<dvbridge_panel>(panel),static_cast<dvbridge_gamut>(gamut)} : dvbridge_tv_profile{};
+    return result;
+  }
+#endif
+};
+
+inline std::mutex& OutputSettingsMutex()
+{
+  static std::mutex mutex;
+  return mutex;
+}
+
+// Protected by OutputSettingsMutex. The settings store remains the sole default owner.
+struct OutputSelectors
+{
+  OutputMode output{OutputMode::Standard};
+  HDR10SourceMode hdr10Source{HDR10SourceMode::Native}, hdr10PlusSource{HDR10SourceMode::Native};
+  HLGSourceMode hlgSource{HLGSourceMode::Native};
+  int method{};
+  bool hdr10TransportFallback{};
+  bool playerLedStartup{};
+  void Apply(OutputPreferences& preferences) const
+  {
+    preferences.output=output;
+    preferences.hdr10TransportFallback=hdr10TransportFallback;
+    preferences.method=method;
+    preferences.hdr10Source=hdr10Source;
+    preferences.hdr10PlusSource=hdr10PlusSource;
+    preferences.hlgSource=hlgSource;
+  }
+};
+inline std::optional<OutputSelectors> activeOutputSelectors;
+
+// Caller holds OutputSettingsMutex; no selector-setting callbacks take this lock.
+inline OutputSelectors ReadDefaultOutputSelectors()
+{
+  OutputSelectors result;
+  const auto component=CServiceBroker::GetSettingsComponent();
+  const auto settings=component ? component->GetSettings() : nullptr;
+  if (!settings) return result;
+  const int output=settings->GetInt("dvbridge.outputmode");
+  result.output=output==3 ? OutputMode::AdaptiveB :
+      output>=0 && output<=static_cast<int>(OutputMode::PlayerLed) ? static_cast<OutputMode>(output) : OutputMode::Standard;
+  const int method=settings->GetInt("dvbridge.hdr10method");
+  result.method=method>=0 && method<=2 ? method : 0;
+  const int hdr10=settings->GetInt("dvbridge.hdr10source");
+  result.hdr10Source=(hdr10>=0 && hdr10<=2) || hdr10==4 ?
+      static_cast<HDR10SourceMode>(hdr10) : HDR10SourceMode::Native;
+  const int plus=settings->GetInt("dvbridge.hdr10plussource");
+  result.hdr10PlusSource=plus==3 ? HDR10SourceMode::HDR10PlusDV :
+      plus==4 ? HDR10SourceMode::SDR :
+      plus==5 ? HDR10SourceMode::HDR10PlusPassthrough : HDR10SourceMode::Native;
+  const int hlg=settings->GetInt("dvbridge.hlgsource");
+  if (hlg==1 || hlg==2) result.hlgSource=static_cast<HLGSourceMode>(hlg);
+  return result;
+}
+
+#ifdef CB1_HAS_HDR10_AI
+// Protected by OutputSettingsMutex; confirmation retries without changing settings.
+inline uint64_t hdr10Reselection{};
+#endif
+
+inline OutputPreferences FrameOutputSettings(bool hdr10Plus = false, bool hlg = false)
+{
+  static OutputPreferences previous;
+#ifdef CB1_HAS_HDR10_AI
+  static uint64_t previousReselection{};
+#endif
+  std::lock_guard<std::mutex> lock(OutputSettingsMutex());
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  OutputPreferences next;
+  if (settings)
+  {
+    next.sdrPreset=settings->GetInt("dvbridge.sdrpreset");
+    next.sdrBT2020=settings->GetInt("dvbridge.sdrgamutvalue")==1;
+    next.sdrPeak=settings->GetNumber("dvbridge.sdrpeak");
+    next.sdrGamma=settings->GetNumber("dvbridge.sdrgamma");
+    next.sdrBlack=settings->GetNumber("dvbridge.sdrblack");
+    next.lldvFormat=settings->GetInt("dvbridge.lldvformatvalue");
+    {
+      next.expertPeak=settings->GetNumber("dvbridge.expertpeak");
+      next.expertGamut=settings->GetInt("dvbridge.expertgamut");
+      const int black=settings->GetInt("dvbridge.expertblack");
+      next.expertBlack=black==0 ? 0 : black==1 ? 0.005 : black==2 ? 0.05 :
+          black==3 ? settings->GetNumber("dvbridge.expertblackcustom") : -1;
+    }
+    next.peak = settings->GetNumber("dvbridge.tvpeak");
+    next.panel = settings->GetInt("dvbridge.tvpanel");
+    next.gamut = settings->GetInt("dvbridge.tvgamut");
+    next.felUpscaling = settings->GetInt("dvbridge.felupscaling");
+    next.masterIPT = settings->GetInt("dvbridge.masteroutput")==1;
+    next.disableL2Trims = settings->GetBool("dvbridge.disablel2");
+    next.cmv40Mode = settings->GetInt("dvbridge.cmv40");
+    next.cmv40Trigger = settings->GetInt("dvbridge.cmv40trigger");
+    next.cmv40Headroom = settings->GetInt("dvbridge.cmv40headroom");
+  }
+  if (next.cmv40Mode < 0 || next.cmv40Mode > 4) next.cmv40Mode = 0;
+  if (next.cmv40Trigger != 1000 && next.cmv40Trigger != 2000 &&
+      next.cmv40Trigger != 4000 && next.cmv40Trigger != 10000) next.cmv40Trigger = 0;
+  if (next.cmv40Headroom < 0 || next.cmv40Headroom > 50) next.cmv40Headroom = 20;
+  if (next.felUpscaling < 0 || next.felUpscaling > 2) next.felUpscaling = 0;
+  // Only selectors belong to the file. Calibration and tuning stay live.
+  (activeOutputSelectors ? *activeOutputSelectors : ReadDefaultOutputSelectors()).Apply(next);
+  next.revision = previous.revision;
+  bool changed = !next.SameValues(previous);
+#ifdef CB1_HAS_HDR10_AI
+  changed |= previousReselection != hdr10Reselection;
+  previousReselection = hdr10Reselection;
+#endif
+  if (changed) next.revision = NextRevision();
+  previous = next;
+  playbackMode.store(next.output);
+  hdr10PlaybackMode.store(next.hdr10Source);
+  hdr10PlusPlaybackMode.store(next.hdr10PlusSource);
+  hlgPlaybackMode.store(next.HLGMode());
+  // Resolve only the returned copy; alternating inputs must not churn revisions.
+  if (hdr10Plus) next.hdr10Source = next.HDR10Mode(true);
+  if (hlg) next.hdr10Source = next.HLGMode();
+  return next;
+}
+
+inline void UsePlayerLedStartupFallback()
+{
+  std::lock_guard lock(OutputSettingsMutex());
+  if (activeOutputSelectors && activeOutputSelectors->playerLedStartup)
+  {
+    activeOutputSelectors->hdr10TransportFallback = true;
+    activeOutputSelectors->playerLedStartup = false;
+  }
+}
+
+inline void SelectOutputSettings(bool nativeDV = true, bool playerLed = true)
+{
+  {
+    std::lock_guard lock(OutputSettingsMutex());
+    auto defaults = ReadDefaultOutputSelectors();
+    // Snapshot transport availability for the file before opening the decoder.
+    switch (defaults.output)
+    {
+      case OutputMode::PlayerLed:
+        defaults.hdr10TransportFallback = !playerLed;
+        defaults.playerLedStartup = playerLed;
+        break;
+      case OutputMode::Standard:
+      case OutputMode::EnhancedDV:
+      case OutputMode::MasterReference:
+      case OutputMode::AdaptiveB:
+        defaults.hdr10TransportFallback = !nativeDV;
+        break;
+      default:
+        break;
+    }
+    activeOutputSelectors = defaults;
+  }
+  FrameOutputSettings();
+}
+
+inline bool EnhancedInfoEnabled()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  return settings && settings->GetBool("dvbridge.enhancedinfo");
+}
+inline bool PlaybackMenuEnabled()
+{
+  return true;
+}
+inline bool FELHardwareUpscalingEnabled()
+{
+  return true;
+}
+} // namespace DVBRIDGE
