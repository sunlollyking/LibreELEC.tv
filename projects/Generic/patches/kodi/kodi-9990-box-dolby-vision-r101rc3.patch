diff --git a/xbmc/utils/DVBridgeKernelLog.h b/xbmc/utils/DVBridgeKernelLog.h
new file mode 100644
index 0000000000..386e5915ea
--- /dev/null
+++ b/xbmc/utils/DVBridgeKernelLog.h
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <charconv>
+#include <cstdint>
+#include <deque>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace DVBRIDGE
+{
+// /dev/kmsg records: priority,sequence,monotonic_us,flags;message\ncontext.
+// Only kernel-origin DV/display incidents are copied, never general system logs.
+class KernelLogFilter
+{
+public:
+  void BeginCollection() { m_lost = m_pendingLost = 0; m_truncated = false; }
+  std::optional<std::string> Accept(std::string_view record, uint64_t nowUs)
+  {
+    uint64_t priority, sequence, timestamp;
+    if (!Number(record, priority) || !Number(record, sequence) || !Number(record, timestamp))
+      return {};
+    const auto separator = record.find(';');
+    if (separator == record.npos || priority > 7)
+      return {};
+    if (m_seen && sequence <= m_sequence)
+      return {};
+    if (m_seen && sequence-m_sequence>1)
+    {
+      m_pendingLost+=sequence-m_sequence-1;
+      m_lost+=sequence-m_sequence-1;
+    }
+    m_seen = true;
+    m_sequence = sequence;
+    auto message = record.substr(separator + 1);
+    message = message.substr(0, message.find('\n'));
+    // i915/xe faults can explain a failed flip without a DV-specific rejection.
+    // Restrict these additional records to warning-or-worse display incidents.
+    const bool intel = message.find("i915 ") != message.npos ||
+                       message.find("xe ") != message.npos;
+    // Preserve boot-time bridge evidence even when Kodi starts much later.
+    // It is raw kernel evidence, NOT attribution to the selected connector or
+    // proof of an exact converter model. No generic DRM/EDID dump is allowed.
+    const bool route = intel && message.find("[drm") != message.npos &&
+        (message.find("LSPCON") != message.npos ||
+         message.find("lspcon") != message.npos ||
+         message.find("PCON") != message.npos ||
+         message.find("DP-to-HDMI") != message.npos ||
+         message.find("DP-HDMI") != message.npos);
+    const bool capability = message.find("DVBridge: AMD capability ") != message.npos;
+    if (timestamp > nowUs || (!route && !capability && nowUs - timestamp > 60000000))
+      return {};
+    const bool incident = priority <= 4 && intel &&
+        (message.find("GPU HANG") != message.npos ||
+         message.find("Resetting") != message.npos ||
+         message.find("reset failed") != message.npos ||
+         message.find("underrun") != message.npos ||
+         message.find("flip_done timed out") != message.npos ||
+         message.find("vblank wait timed out") != message.npos ||
+         message.find("link training failed") != message.npos ||
+         message.find("link-status BAD") != message.npos);
+    if (message.find("DVBridge:") == message.npos && !incident && !route)
+      return {};
+    // Kernel escapes untrusted characters. Bound the copied record as well.
+    const std::string text(message.substr(0, 640));
+    const bool truncated=message.size()>640;
+    m_truncated|=truncated;
+    for (const auto& recent : m_recent)
+      if (recent.first == text && nowUs - recent.second < 30000000)
+        return {};
+    m_recent.emplace_back(text, nowUs);
+    if (m_recent.size() > 16)
+      m_recent.pop_front();
+    auto result="boot_us=" + std::to_string(timestamp) + " seq=" + std::to_string(sequence) +
+           (m_pendingLost ? " lost="+std::to_string(m_pendingLost) : "")+
+           (route ? " route_evidence=kernel-unscoped " : " ") + text+
+           (truncated ? " [truncated]" : "");
+    m_pendingLost=0;
+    return result;
+  }
+  bool Incomplete() const { return m_lost || m_truncated; }
+
+private:
+  static bool Number(std::string_view& input, uint64_t& value)
+  {
+    const auto comma = input.find(',');
+    if (comma == input.npos || comma == 0)
+      return false;
+    const auto result = std::from_chars(input.data(), input.data() + comma, value);
+    if (result.ec != std::errc{} || result.ptr != input.data() + comma)
+      return false;
+    input.remove_prefix(comma + 1);
+    return true;
+  }
+  uint64_t m_sequence{0};
+  bool m_seen{false};
+  uint64_t m_pendingLost{},m_lost{};
+  bool m_truncated{};
+  std::deque<std::pair<std::string, uint64_t>> m_recent;
+};
+}
diff --git a/xbmc/utils/DVBridgeLldv.h b/xbmc/utils/DVBridgeLldv.h
new file mode 100644
index 0000000000..025b56a29b
--- /dev/null
+++ b/xbmc/utils/DVBridgeLldv.h
@@ -0,0 +1,418 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "DVBridgeEdid.h"
+
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace DVBRIDGE
+{
+enum class LldvEdidStatus
+{
+  Missing, Incomplete, Invalid, NoDolbyVision, UnsupportedBlock, NoLowLatency,
+  InvalidLuminance, InvalidPrimaries, Ready, UnsupportedGamut
+};
+
+inline const char* LldvEdidReason(LldvEdidStatus status)
+{
+  switch (status)
+  {
+    case LldvEdidStatus::Missing: return "edid-unavailable";
+    case LldvEdidStatus::Incomplete: return "edid-incomplete";
+    case LldvEdidStatus::Invalid: return "edid-invalid";
+    case LldvEdidStatus::NoDolbyVision: return "no-dolby-vision-block";
+    case LldvEdidStatus::UnsupportedBlock: return "dolby-block-unusable";
+    case LldvEdidStatus::NoLowLatency: return "tv-does-not-announce-lldv";
+    case LldvEdidStatus::InvalidLuminance: return "target-luminance-invalid";
+    case LldvEdidStatus::InvalidPrimaries: return "target-primaries-invalid";
+    case LldvEdidStatus::UnsupportedGamut: return "target-gamut-outside-bt2020";
+    case LldvEdidStatus::Ready: return "target-ready";
+  }
+  return "unknown";
+}
+
+struct LldvDisplay
+{
+  dvbridge_sink_caps sink{};
+  LldvEdidStatus status{LldvEdidStatus::Missing};
+  size_t received{}, expected{};
+  double peak{}, black{};
+  std::array<double, 6> reported{}, primaries{};
+};
+
+inline double LldvPqNits(unsigned code)
+{
+  const double value = std::pow(code / 4095.0, 32.0 / 2523);
+  return 10000 * std::pow(std::fmax(0, value - 3424.0 / 4096) /
+                             (2413.0 / 128 - (2392.0 / 128) * value), 16384.0 / 2610);
+}
+
+inline double LldvEdge(double x, double y, const double* a, const double* b)
+{
+  return (b[0] - a[0]) * (y - a[1]) - (b[1] - a[1]) * (x - a[0]);
+}
+
+inline bool ValidLldvPrimaries(const std::array<double, 6>& primaries)
+{
+  for (size_t i = 0; i < 3; ++i)
+    if (primaries[i * 2] <= 0 || primaries[i * 2 + 1] <= 0 ||
+        primaries[i * 2] + primaries[i * 2 + 1] > 1.0 ||
+        LldvEdge(.3127, .3290, &primaries[i * 2], &primaries[((i + 1) % 3) * 2]) <= 0.000001)
+      return false;
+  return true;
+}
+
+inline bool FitLldvPrimaries(std::array<double, 6>& primaries)
+{
+  constexpr double bt2020[][2] = {{.708, .292}, {.170, .797}, {.131, .046}};
+  for (size_t i = 0; i < primaries.size(); i += 2)
+  {
+    double& x = primaries[i];
+    double& y = primaries[i + 1];
+    double nearestDistance = 1, nearestX = x, nearestY = y;
+    bool outside = false;
+    for (size_t j = 0; j < 3; ++j)
+    {
+      const auto* a = bt2020[j];
+      const auto* b = bt2020[(j + 1) % 3];
+      outside |= LldvEdge(x, y, a, b) < 0;
+      const double dx = b[0] - a[0], dy = b[1] - a[1];
+      const double t = std::fmax(0, std::fmin(1, ((x - a[0]) * dx + (y - a[1]) * dy) /
+                                                      (dx * dx + dy * dy)));
+      const double px = a[0] + t * dx, py = a[1] + t * dy;
+      const double distance = std::hypot(x - px, y - py);
+      if (distance < nearestDistance)
+      {
+        nearestDistance = distance;
+        nearestX = px;
+        nearestY = py;
+      }
+    }
+    if (outside)
+    {
+      // Allow one 1/256 step on each xy axis at the quantized gamut boundary.
+      if (nearestDistance > std::sqrt(2.0) / 256)
+        return false;
+      x = nearestX;
+      y = nearestY;
+    }
+  }
+  return ValidLldvPrimaries(primaries);
+}
+
+inline LldvDisplay ReadLldvDisplay(const uint8_t* edid, size_t size)
+{
+  LldvDisplay display;
+  display.sink = dvbridge_parse_edid(edid, size);
+  display.received = size;
+  if (!edid || !size)
+    return display;
+  display.expected = size < 128 ? 128 : (size_t(edid[126]) + 1) * 128;
+  if (size >= 256 && edid[126] && edid[128] == 2 && edid[129] >= 3 &&
+      edid[130] >= 7 && edid[130] <= 127 && edid[132] == 0xe2 && edid[133] == 0x78 && edid[134])
+    display.expected = (size_t(edid[134]) + 1) * 128;
+  switch (display.sink.status)
+  {
+    case DV_EDID_INVALID:
+      display.status = size < display.expected ? LldvEdidStatus::Incomplete : LldvEdidStatus::Invalid;
+      return display;
+    case DV_EDID_NO_DV:
+      display.status = LldvEdidStatus::NoDolbyVision;
+      return display;
+    case DV_EDID_STANDARD:
+    case DV_EDID_LLDV_ONLY:
+      break;
+    default:
+      display.status = LldvEdidStatus::UnsupportedBlock;
+      return display;
+  }
+
+  const auto* data = edid + display.sink.offset;
+  const auto* p = data + 4;
+  if (!dvbridge_lldv_422(display.sink) ||
+      (display.sink.version == 1 && (p[3] & 3) != 1))
+  {
+    display.status = LldvEdidStatus::NoLowLatency;
+    return display;
+  }
+  if (display.sink.version == 2)
+  {
+    display.black = LldvPqNits(20 * (p[1] >> 3));
+    display.peak = LldvPqNits(2055 + 65 * (p[2] >> 3));
+    display.reported = {.625 + (p[5] >> 3) / 256.0, .25 + (p[6] >> 3) / 256.0,
+                        (p[3] >> 1) / 256.0, .5 + (p[4] >> 1) / 256.0,
+                        .125 + (p[5] & 7) / 256.0, .03125 + (p[6] & 7) / 256.0};
+  }
+  else
+  {
+    const double black = (p[2] >> 1) / 127.0;
+    display.black = black * black;
+    display.peak = 100 + 50 * (p[1] >> 1);
+    display.reported = {.625 + (p[6] >> 3) / 256.0,
+        .25 + (((p[6] & 7) << 2) | ((p[5] & 1) << 1) | (p[4] & 1)) / 256.0,
+        (p[4] >> 1) / 256.0, .5 + (p[5] >> 1) / 256.0,
+        .125 + (p[3] >> 5) / 256.0, .03125 + ((p[3] >> 2) & 7) / 256.0};
+  }
+  display.primaries = display.reported;
+  if (display.black >= display.peak || display.peak > 10000)
+    display.status = LldvEdidStatus::InvalidLuminance;
+  else if (!ValidLldvPrimaries(display.reported))
+    display.status = LldvEdidStatus::InvalidPrimaries;
+  else if (!FitLldvPrimaries(display.primaries))
+    display.status = LldvEdidStatus::UnsupportedGamut;
+  else
+    display.status = LldvEdidStatus::Ready;
+  return display;
+}
+
+// Stable preference values. A request of zero means off in the driver.
+enum class LldvFormat { Auto, Y422_10, Y422_12, Rgb10, Rgb12, Y444_10, Y444_12 };
+enum class LldvReason { Ready, Edid, Display, Driver, Timing };
+
+constexpr int LLDV_FORCE_422_10 = 7; // Saved choice, not an HDMI format or DRM enum.
+constexpr int LLDV_PACKED_422_12 = 8;
+constexpr int LLDV_CHOOSE_FORMAT_LABEL = 41340;
+
+constexpr LldvFormat LldvFormatPreference(int value)
+{
+  if (value == LLDV_FORCE_422_10)
+    return LldvFormat::Y422_10;
+  if (value == LLDV_PACKED_422_12)
+    return LldvFormat::Y422_12;
+  return value >= 0 && value <= static_cast<int>(LldvFormat::Y444_12)
+             ? static_cast<LldvFormat>(value) : LldvFormat::Auto;
+}
+
+constexpr unsigned LldvBit(LldvFormat format)
+{
+  return 1U << static_cast<unsigned>(format);
+}
+
+constexpr unsigned LLDV_422 = LldvBit(LldvFormat::Y422_10) | LldvBit(LldvFormat::Y422_12);
+constexpr unsigned LLDV_IMPLEMENTED = LLDV_422 |
+    LldvBit(LldvFormat::Rgb10) | LldvBit(LldvFormat::Rgb12) |
+    LldvBit(LldvFormat::Y444_10) | LldvBit(LldvFormat::Y444_12);
+constexpr LldvFormat LLDV_PREFERRED[] = {LldvFormat::Y422_10, LldvFormat::Rgb10,
+                                        LldvFormat::Y444_10, LldvFormat::Y422_12,
+                                        LldvFormat::Rgb12, LldvFormat::Y444_12};
+
+constexpr const char* LldvNativeEnumName(LldvFormat format)
+{
+  switch (format)
+  {
+    case LldvFormat::Y422_10: return "YCbCr 4:2:2 10 bits RGB10 lab";
+    case LldvFormat::Y422_12: return "YCbCr 4:2:2 12 bits RGB16";
+    case LldvFormat::Rgb10: return "RGB 10 bits RGB10";
+    case LldvFormat::Rgb12: return "RGB 12 bits RGB16";
+    case LldvFormat::Y444_10: return "YCbCr 4:4:4 10 bits RGB10";
+    case LldvFormat::Y444_12: return "YCbCr 4:4:4 12 bits RGB16";
+    case LldvFormat::Auto: return nullptr;
+  }
+  return nullptr;
+}
+
+constexpr bool LldvUses10Bits(LldvFormat format)
+{
+  return format == LldvFormat::Y422_10 || format == LldvFormat::Rgb10 ||
+         format == LldvFormat::Y444_10;
+}
+
+constexpr bool LldvRequiresForcing(LldvFormat format, unsigned driverFormats, bool forced42210)
+{
+  return format == LldvFormat::Y422_10 && forced42210 &&
+         !(driverFormats & LldvBit(format));
+}
+
+inline LldvReason LldvFormatReason(dvbridge_sink_caps sink, LldvFormat format,
+                                   unsigned driverFormats, bool currentTiming,
+                                   bool forced42210 = false)
+{
+  if (sink.status != DV_EDID_STANDARD && sink.status != DV_EDID_LLDV_ONLY &&
+      sink.status != DV_EDID_NO_DV)
+    return LldvReason::Edid;
+  const bool y422 = (LldvBit(format) & LLDV_422) != 0;
+  const unsigned bits = LldvUses10Bits(format) ? 10 : 12;
+  if (y422 ? !dvbridge_lldv_422(sink) : dvbridge_lldv_444_bits(sink) != bits)
+    return LldvReason::Display;
+  if (!(driverFormats & LldvBit(format)) && !LldvRequiresForcing(format, driverFormats, forced42210))
+    return LldvReason::Driver;
+  return currentTiming ? LldvReason::Ready : LldvReason::Timing;
+}
+
+inline LldvFormat ChooseLldvFormat(dvbridge_sink_caps sink, unsigned driverFormats,
+                                  bool currentTiming)
+{
+  for (const auto format : LLDV_PREFERRED)
+    if (LldvFormatReason(sink, format, driverFormats, currentTiming) == LldvReason::Ready)
+      return format;
+  return LldvFormat::Auto;
+}
+
+// The connector and transport used to pack a particular framebuffer.
+struct LldvTransport
+{
+  uint32_t connectorId{0};
+  LldvFormat format{LldvFormat::Auto};
+  bool forced{false};
+  uint64_t edidGeneration{};
+  unsigned rgbScanoutBits{8};
+  bool experimentalPacked12{false};
+
+  constexpr bool operator==(const LldvTransport& other) const
+  {
+    return connectorId == other.connectorId && format == other.format && forced == other.forced &&
+        edidGeneration == other.edidGeneration && rgbScanoutBits == other.rgbScanoutBits &&
+        experimentalPacked12 == other.experimentalPacked12;
+  }
+};
+
+constexpr unsigned LldvTransportBit(const LldvTransport& transport)
+{
+  // Distinguish packed, native deep, forced 10-bit and experimental packed 12-bit.
+  const unsigned path = transport.forced ? 2 : transport.experimentalPacked12 ? 3 :
+      transport.rgbScanoutBits > 8 ? 1 : 0;
+  return 1U << (4 * static_cast<unsigned>(transport.format) + path);
+}
+
+constexpr int LLDV_DRIVER_REJECTED_LABEL = 41298;
+
+struct LldvConnectorStatus
+{
+  dvbridge_sink_caps sink{};
+  unsigned driverFormats{0};
+  bool currentTiming{false};
+  LldvFormat active{LldvFormat::Auto};
+  bool forced42210{false};
+  bool activeForced{false};
+  bool rgb10Scanout{false};
+  unsigned activeRgbScanoutBits{8};
+  uint32_t connectorId{0};
+  bool timingCommitted{false};
+  bool availableTiming{false};
+  LldvDisplay display;
+  uint64_t edidGeneration{};
+  unsigned currentRejected{}, availableRejected{};
+  std::vector<std::pair<int, unsigned>> modeRejections;
+  bool cta93FractionalOnly{};
+  bool packed42212{};
+  bool output42212{};
+  bool activeExperimentalPacked12{};
+  bool rgb16Scanout{};
+};
+
+inline unsigned LldvScanoutBits(const LldvConnectorStatus& status, LldvFormat format)
+{
+  if (format == LldvFormat::Y422_10)
+    return status.rgb10Scanout ? 10 : 8;
+  return LldvUses10Bits(format) ? 10 : 16;
+}
+
+struct LldvChoice
+{
+  LldvTransport transport;
+  int unavailable{};
+};
+
+inline LldvChoice ResolveLldvTransport(const LldvConnectorStatus& status, int preference,
+                                       bool allowModeSwitch)
+{
+  if (status.display.status != LldvEdidStatus::Ready)
+    return {{}, status.display.status == LldvEdidStatus::UnsupportedGamut ? 41300 :
+        41280 + static_cast<int>(status.display.status)};
+  if (!status.connectorId || (!status.driverFormats && !status.forced42210)) return {{}, 41211};
+
+  const bool timing = status.currentTiming || (allowModeSwitch && status.availableTiming);
+  const unsigned rejected = allowModeSwitch && status.availableTiming ?
+      status.availableRejected : status.currentRejected;
+  const auto check = [&](LldvFormat format, unsigned bits, bool forced = false,
+                         bool packed12 = false) -> LldvChoice {
+    const auto reason = LldvFormatReason(status.sink, format, status.driverFormats, true, forced);
+    if (reason != LldvReason::Ready) return {{}, 41208 + static_cast<int>(reason)};
+    if (!(LldvBit(format) & LLDV_IMPLEMENTED)) return {{}, 41211};
+    if (format == LldvFormat::Y422_12 && (packed12 || bits == 16) &&
+        !dvbridge_lldv_422_12(status.sink))
+      return {{}, 41210};
+    if (!timing) return {{}, 41212};
+    const LldvTransport transport{status.connectorId, format, forced, status.edidGeneration,
+        bits, packed12};
+    if (rejected & LldvTransportBit(transport)) return {{}, LLDV_DRIVER_REJECTED_LABEL};
+    if (packed12 && preference != LLDV_PACKED_422_12)
+      return {{}, LLDV_CHOOSE_FORMAT_LABEL};
+    return {transport, 0};
+  };
+
+  const auto native = [&](LldvFormat format) -> LldvChoice {
+    if (format != LldvFormat::Y422_12)
+      return check(format, LldvScanoutBits(status, format));
+    const auto deep = status.rgb16Scanout ? check(format, 16) : LldvChoice{{}, 41211};
+    if (!deep.unavailable) return deep;
+    if (status.output42212)
+      return check(format, 8);
+    return deep;
+  };
+  const auto format = LldvFormatPreference(preference);
+  if (format != LldvFormat::Auto)
+  {
+    const auto choice = native(format);
+    if (preference == LLDV_FORCE_422_10 && status.forced42210 &&
+        (choice.unavailable == 41211 || choice.unavailable == LLDV_DRIVER_REJECTED_LABEL))
+      return check(format, 8, true);
+    if (format == LldvFormat::Y422_12 && status.packed42212 &&
+        (choice.unavailable == 41211 || choice.unavailable == LLDV_DRIVER_REJECTED_LABEL))
+    {
+      const auto packed = check(format, 8, false, true);
+      return preference == LLDV_PACKED_422_12 || choice.unavailable == 41211 ? packed : choice;
+    }
+    return choice;
+  }
+  // Auto only considers native driver formats. Explicit forcing remains opt-in.
+  int unavailable = 41213;
+  for (const auto candidate : LLDV_PREFERRED)
+  {
+    if (!(status.driverFormats & LldvBit(candidate))) continue;
+    const auto choice = native(candidate);
+    if (!choice.unavailable) return choice;
+    if (choice.unavailable == 41212 || choice.unavailable == LLDV_DRIVER_REJECTED_LABEL)
+      unavailable = choice.unavailable;
+  }
+  return {{}, unavailable};
+}
+
+inline int LldvUnavailableLabel(const LldvConnectorStatus& status, int preference,
+                                bool allowModeSwitch)
+{
+  return ResolveLldvTransport(status, preference, allowModeSwitch).unavailable;
+}
+
+inline LldvTransport SelectLldvTransport(const LldvConnectorStatus& status, int preference,
+                                        bool allowModeSwitch = false)
+{
+  return ResolveLldvTransport(status, preference, allowModeSwitch).transport;
+}
+
+inline bool LldvCanChooseFormat(const LldvConnectorStatus& status, bool allowModeSwitch)
+{
+  return !LldvUnavailableLabel(status, 0, allowModeSwitch) ||
+         !LldvUnavailableLabel(status, LLDV_FORCE_422_10, allowModeSwitch) ||
+         !LldvUnavailableLabel(status, LLDV_PACKED_422_12, allowModeSwitch);
+}
+
+inline const char* LldvCompatibilityReason(const LldvConnectorStatus& status, int preference)
+{
+  if (status.display.status != LldvEdidStatus::Ready) return LldvEdidReason(status.display.status);
+  switch (LldvUnavailableLabel(status, preference, true))
+  {
+    case 0: return "available";
+    case 41210: return "format-not-advertised-by-tv";
+    case 41211: return "format-not-supported-by-driver-or-port";
+    case 41212: return "hdmi-timing-unavailable";
+    case LLDV_DRIVER_REJECTED_LABEL: return "atomic-format-rejected";
+    case LLDV_CHOOSE_FORMAT_LABEL: return "experimental-format-not-selected";
+    default: return "no-common-format";
+  }
+}
+} // namespace DVBRIDGE
diff --git a/xbmc/utils/DVBridgeOutputRetry.h b/xbmc/utils/DVBridgeOutputRetry.h
new file mode 100644
index 0000000000..87cce3e599
--- /dev/null
+++ b/xbmc/utils/DVBridgeOutputRetry.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <cerrno>
+
+namespace DVBRIDGE
+{
+// Output recovery only; diagnostic counters never influence this state.
+class OutputRetry
+{
+public:
+  void Failed(int error)
+  {
+    ++m_failures;
+    m_error = error;
+  }
+  void Reset() { *this = {}; }
+  bool CanRetry(int error, bool restored) const
+  {
+    return m_failures == 1 && restored &&
+        (error == EAGAIN || error == EINTR || error == EBUSY);
+  }
+  unsigned Count() const { return m_failures; }
+  int Error() const { return m_error; }
+
+private:
+  unsigned m_failures{0};
+  int m_error{0};
+};
+} // namespace DVBRIDGE
diff --git a/xbmc/utils/DVBridgeOverlayTrace.h b/xbmc/utils/DVBridgeOverlayTrace.h
new file mode 100644
index 0000000000..72462623dd
--- /dev/null
+++ b/xbmc/utils/DVBridgeOverlayTrace.h
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "ServiceBroker.h"
+#include "utils/DVBridgeDiagnosticState.h"
+#include "utils/log.h"
+
+#include <algorithm>
+#include <array>
+
+namespace DVBRIDGE
+{
+inline bool OverlayDebugEnabled()
+{
+  return DetailedDiagnosticsEnabled() && CServiceBroker::GetLogging().IsLogLevelLogged(LOGDEBUG);
+}
+
+using OverlayClock = std::chrono::steady_clock;
+
+inline uint64_t OverlayElapsedUs(OverlayClock::time_point start)
+{
+  return std::chrono::duration_cast<std::chrono::microseconds>(OverlayClock::now() - start).count();
+}
+
+enum class OverlayStage { Refresh, Draw, Composite, Present, Commit, FenceWait, Count };
+
+// Kodi's GUI, composition and DRM calls run on the application thread.
+struct OverlayTrace
+{
+  struct Samples
+  {
+    uint64_t count{}, first{}, max{};
+    void Add(uint64_t us)
+    {
+      if (count++ == 0) first = us;
+      max = std::max(max, us);
+    }
+  };
+
+  const char* kind{};
+  uint64_t openedMs{};
+  std::array<Samples, static_cast<size_t>(OverlayStage::Count)> samples{};
+  DiagnosticInterval slowFrames;
+
+  void Observe(const char* next)
+  {
+    if (kind == next) return;
+    if (kind)
+    {
+      const auto& [refresh, draw, composite, present, commit, wait] = samples;
+      CLog::Log(LOGDEBUG, "CB1 overlay summary: kind={} opened_ms={} elapsed_ms={} "
+          "refresh_count={} refresh_first_us={} refresh_max_us={} draw_count={} draw_first_us={} draw_max_us={} "
+          "composite_count={} composite_max_us={} present_count={} present_max_us={} "
+          "commit_count={} commit_max_us={} fence_wait_count={} fence_wait_max_us={}",
+          kind, openedMs, DiagnosticNowMs() - openedMs, refresh.count, refresh.first, refresh.max,
+          draw.count, draw.first, draw.max, composite.count, composite.max, present.count,
+          present.max, commit.count, commit.max, wait.count, wait.max);
+    }
+    *this = {};
+    if (next)
+    {
+      kind = next;
+      openedMs = DiagnosticNowMs();
+      CLog::Log(LOGDEBUG, "CB1 overlay start: kind={} opened_ms={}", kind, openedMs);
+    }
+  }
+
+  void Record(OverlayStage stage, uint64_t us)
+  {
+    samples[static_cast<size_t>(stage)].Add(us);
+    if (us < 20000) return;
+    const uint64_t now = DiagnosticNowMs();
+    if (!slowFrames.Due(now)) return;
+    slowFrames.Emitted(now);
+    constexpr std::array names{"refresh", "draw", "composite", "present", "drm-commit", "drm-fence-wait"};
+    CLog::Log(LOGDEBUG, "CB1 overlay slow stage: kind={} opened_ms={} now_ms={} stage={} elapsed_us={}",
+              kind, openedMs, now, names[static_cast<size_t>(stage)], us);
+  }
+};
+
+inline thread_local OverlayTrace overlayTrace;
+inline constexpr char PLAYER_INFO_CB1[] = "player-info-cb1";
+inline constexpr char PLAYER_INFO_KODI[] = "player-info-kodi";
+inline constexpr char VIDEO_OSD[] = "video-osd";
+
+inline bool IsPlayerInfoTrace()
+{
+  return overlayTrace.kind == PLAYER_INFO_CB1 || overlayTrace.kind == PLAYER_INFO_KODI;
+}
+
+class OverlayTimer
+{
+public:
+  explicit OverlayTimer(OverlayStage stage) : m_stage(stage)
+  {
+    if (overlayTrace.kind) m_start = OverlayClock::now();
+  }
+
+  ~OverlayTimer() { Finish(); }
+
+  void Finish()
+  {
+    if (m_start == OverlayClock::time_point{}) return;
+    overlayTrace.Record(m_stage, OverlayElapsedUs(m_start));
+    m_start = {};
+  }
+
+private:
+  OverlayStage m_stage;
+  OverlayClock::time_point m_start;
+};
+} // namespace DVBRIDGE
diff --git a/xbmc/utils/DVBridgePresentation.h b/xbmc/utils/DVBridgePresentation.h
new file mode 100644
index 0000000000..603ef47f8c
--- /dev/null
+++ b/xbmc/utils/DVBridgePresentation.h
@@ -0,0 +1,137 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <cstdint>
+#include <algorithm>
+#include <array>
+#include <optional>
+#include <cmath>
+#include <ctime>
+
+namespace DVBRIDGE
+{
+inline bool ContinuousPresentationPicture(double currentUs, double previousUs)
+{
+  // Kodi picture timestamps use microseconds; seeks and repeats are excluded.
+  return std::isfinite(currentUs) && std::isfinite(previousUs) &&
+      currentUs > previousUs && currentUs - previousUs < 250000;
+}
+
+// One picture of timing per accepted fence; no quality change before a latched switch.
+class MasterSafety
+{
+public:
+  void Begin(uint64_t stream,uint64_t policy,uint64_t source,double pts,bool enabled)
+  {
+    const bool reset=!enabled || stream!=m_stream || policy!=m_policy || source!=m_source ||
+        !std::isfinite(pts) || (pts!=m_pts && !ContinuousPresentationPicture(pts,m_pts));
+    if(reset){m_warm=m_samples=m_low=0;m_active=false;}
+    m_stream=stream;m_policy=policy;m_source=source;m_pts=pts;m_enabled=enabled;
+  }
+  bool Observe(std::optional<int64_t> headroom,bool eligible)
+  {
+    if(!m_enabled || m_active || !eligible || !headroom)return false;
+    if(m_warm<60){++m_warm;return false;}
+    m_low+=*headroom<2500000;
+    if(++m_samples<60)return false;
+    const bool switchNow=m_low>=12;
+    m_samples=m_low=0;
+    m_active=switchNow;
+    return switchNow;
+  }
+  bool Active() const{return m_active;}
+  bool Active(uint64_t stream,uint64_t policy,uint64_t source) const
+  {return m_active && stream==m_stream && policy==m_policy && source==m_source;}
+private:
+  uint64_t m_stream{},m_policy{},m_source{};
+  double m_pts{};
+  unsigned m_warm{},m_samples{},m_low{};
+  bool m_enabled{},m_active{};
+};
+
+inline uint64_t MonotonicNowNs()
+{
+  timespec now{};
+  return clock_gettime(CLOCK_MONOTONIC, &now) == 0 ?
+      uint64_t(now.tv_sec) * 1000000000 + uint64_t(now.tv_nsec) : 0;
+}
+
+// Measured delay from picture selection to the start of its scanout.
+// Selection records a CLOCK_MONOTONIC time per picture; the KMS completion
+// fence of the commit that carries that picture closes the sample.
+class PresentationLatency
+{
+public:
+  static constexpr uint64_t MAX_SAMPLE_NS = 500000000;
+  static constexpr unsigned MIN_SAMPLES = 8;
+
+  void Reset() { *this = {}; }
+  void Selected(double pts, uint64_t nowNs)
+  {
+    if (!std::isfinite(pts) || !nowNs) return;
+    for (const auto& selection : m_selected)
+      if (selection.ns && selection.pts == pts) return;
+    m_selected[m_nextSelection] = {pts, nowNs};
+    m_nextSelection = (m_nextSelection + 1) % m_selected.size();
+  }
+  void Completed(double pts, uint64_t completedNs)
+  {
+    if (!completedNs || completedNs == m_lastCompletedNs) return;
+    m_lastCompletedNs = completedNs;
+    for (auto& selection : m_selected)
+    {
+      if (!selection.ns || selection.pts != pts) continue;
+      // Only the first scanout of a picture ends its selection delay.
+      if (completedNs > selection.ns && completedNs - selection.ns < MAX_SAMPLE_NS)
+      {
+        m_samples[m_nextSample] = completedNs - selection.ns;
+        m_nextSample = (m_nextSample + 1) % m_samples.size();
+        m_count = std::min<unsigned>(m_count + 1, m_samples.size());
+      }
+      selection = {};
+      return;
+    }
+  }
+  // Interquartile mean in microseconds: single stalls cannot move it, and a
+  // pipeline alternating between two depths is centred between them.
+  std::optional<double> EstimateUs() const
+  {
+    if (m_count < MIN_SAMPLES) return std::nullopt;
+    auto values = m_samples;
+    std::sort(values.begin(), values.begin() + m_count);
+    const unsigned first = m_count / 4, last = m_count - m_count / 4;
+    double sum = 0;
+    for (unsigned i = first; i < last; ++i) sum += static_cast<double>(values[i]);
+    return sum / (last - first) / 1000.0;
+  }
+
+private:
+  struct Selection
+  {
+    double pts{};
+    uint64_t ns{};
+  };
+  std::array<Selection, 8> m_selected{};
+  std::array<uint64_t, 15> m_samples{};
+  unsigned m_nextSelection{}, m_nextSample{}, m_count{};
+  uint64_t m_lastCompletedNs{};
+};
+
+inline uint64_t MasterFramePeriodNs(double fps)
+{
+  return std::isfinite(fps) && fps >= 10 && fps <= 240 ?
+      static_cast<uint64_t>(std::llround(1e9/fps)) : 0;
+}
+
+inline std::optional<int64_t> PresentationHeadroom(uint64_t previousNs, uint64_t readyNs,
+    uint64_t submittedNs, uint64_t presentedNs, uint64_t periodNs)
+{
+  if (!previousNs || !readyNs || !submittedNs || periodNs < 1000000 || periodNs > 100000000 ||
+      presentedNs <= previousNs || readyNs > presentedNs || submittedNs > presentedNs ||
+      presentedNs - previousNs > 4 * periodNs)
+    return std::nullopt;
+  // A delayed actual presentation must not move the missed deadline forward.
+  return static_cast<int64_t>(previousNs) + static_cast<int64_t>(periodNs) -
+      static_cast<int64_t>(std::max(readyNs, submittedNs));
+}
+
+}
