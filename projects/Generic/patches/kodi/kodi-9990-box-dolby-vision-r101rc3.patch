+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <array>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace DVBRIDGE
+{
+// Enabled without Kodi's global debug mode. Developers can disable the entire
+// supplement in one place; it must never change output or retry decisions.
+inline bool DiagnosticsEnabled()
+{
+  static const bool enabled = [] {
+    const char* setting = std::getenv("DVBRIDGE_DIAGNOSTICS");
+    return !setting || setting[0] != '0' || setting[1] != '\0';
+  }();
+  return enabled;
+}
+
+inline std::atomic<bool> detailedDiagnostics{false};
+
+inline void SetDetailedDiagnostics(bool enabled)
+{
+  detailedDiagnostics.store(enabled, std::memory_order_relaxed);
+}
+
+inline bool DetailedDiagnosticsEnabled()
+{
+  return DiagnosticsEnabled() && detailedDiagnostics.load(std::memory_order_relaxed);
+}
+
+inline uint64_t DiagnosticNowMs()
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+struct DiagnosticProperty
+{
+  bool inventory;
+  std::optional<uint64_t> value;
+  DiagnosticProperty(bool known, std::optional<uint64_t> cached) : inventory(known),
+      value(known ? cached : std::nullopt) {}
+  const char* Presence() const { return !inventory ? "unknown" : value ? "present" : "absent"; }
+  uint64_t Code() const { return !inventory ? 0 : value ? 2 : 1; }
+  std::string Value() const { return value ? std::to_string(*value) : "unavailable"; }
+  bool operator==(const DiagnosticProperty&) const = default;
+};
+
+enum class DiagnosticEvent { Normal, Failure, Final, Connection, Progress, RendererCounter };
+
+// One active native stream, shared by every producer. Pure observation: none of
+// these facts are consumed by output selection, retry, or GPU synchronization.
+// Callers serialize through DiagnosticLog's private diagnostic mutex.
+class DiagnosticSession
+{
+public:
+  void Open() { *this = {}; }
+  void ReserveProgress() { m_reserveProgress = true; }
+  void Candidate(uint64_t now)
+  {
+    if (!m_requested && !m_stream && !m_ended)
+    { m_requested = true; m_waitStart = now; m_stage = "stream-candidate"; }
+  }
+  void Observe(uint64_t now, uint64_t stream, uint64_t picture, uint64_t revision,
+               uint64_t policy, const char* stage, bool requested, bool paused)
+  {
+    if (!stream || stream < m_stream || (stream == m_stream && m_ended)) return;
+    if (stream != m_stream)
+    {
+      // Binding the first picture identifies the candidate already observed by
+      // this playback. It must not grant a second budget or failure exemption.
+      if (m_stream) *this = {};
+      m_stream = stream; m_waitStart = now;
+    }
+    if (revision != m_revision || policy != m_policy)
+    {
+      // A seek/policy generation may clear its reason, never the stream's line
+      // budget or first-failure exemption (oscillation cannot refill either).
+      m_failure = nullptr; m_waitStart = now; m_waited = false;
+    }
+    if (!requested || paused || !m_requested || m_paused) m_waitStart = now;
+    m_requested = requested; m_paused = paused;
+    m_picture = picture; m_revision = revision; m_policy = policy; m_stage = stage;
+  }
+  bool Admit(uint64_t now, DiagnosticEvent event)
+  {
+    // The renderer owner bounds these observations independently of Normal.
+    if (event == DiagnosticEvent::RendererCounter) return true;
+    if (event == DiagnosticEvent::Final)
+    {
+      if ((!m_stream && !m_requested) || m_ended) return false;
+      m_ended = true;
+      return true;
+    }
+    if (event == DiagnosticEvent::Failure && !m_firstFailure)
+    { m_firstFailure = true; return true; }
+    if (event == DiagnosticEvent::Connection) return true;
+    // Clamp backwards observations: no unsigned wrap can refill the budget.
+    if (now < m_lastNow) now = m_lastNow;
+    m_lastNow = now;
+    while (m_size && now >= m_lines[m_head] && now - m_lines[m_head] >= 30000)
+    {
+      m_progress -= m_progressLines[m_head];
+      m_head = (m_head + 1) % m_lines.size(); --m_size;
+    }
+    const bool progress = event == DiagnosticEvent::Progress;
+    if (m_size == m_lines.size() || (m_reserveProgress &&
+        (progress ? m_progress >= 6 : m_size - m_progress >= 18)))
+    { ++m_suppressed; return false; }
+    const auto slot = (m_head + m_size) % m_lines.size();
+    m_lines[slot] = now; m_progressLines[slot] = progress;
+    m_progress += progress;
+    ++m_size;
+    return true;
+  }
+  bool WaitDue(uint64_t now)
+  {
+    if (m_ended || !m_requested || m_paused || m_presented ||
+        now < m_waitStart || now - m_waitStart < 5000 ||
+        (m_waited && (now < m_lastWait || now - m_lastWait < 30000))) return false;
+    m_waited = true; m_lastWait = now; return true;
+  }
+  bool Presented(uint64_t stream)
+  {
+    if (!stream || stream != m_stream || m_presented || m_ended) return false;
+    m_presented = true;
+    return true;
+  }
+  void Paused(uint64_t now, bool paused)
+  {
+    if (m_paused != paused) { m_waitStart = now; m_waited = false; }
+    m_paused = paused;
+  }
+  void Failure(const char* stage) { if (!m_failure) m_failure = stage; m_stage = stage; }
+  void Stage(const char* stage) { m_stage = stage; }
+  void DisableRequest() { m_requested = false; m_stage = "not-requested"; }
+  void Truncated() { ++m_truncated; }
+  void Suppress() { ++m_suppressed; }
+  bool FailureReported() const { return m_firstFailure; }
+  uint64_t Stream() const { return m_stream; }
+  uint64_t Picture() const { return m_picture; }
+  uint64_t Revision() const { return m_revision; }
+  uint64_t Policy() const { return m_policy; }
+  uint64_t Suppressed() const { return m_suppressed; }
+  uint64_t Truncations() const { return m_truncated; }
+  bool FirstPresented() const { return m_presented; }
+  bool Ended() const { return m_ended; }
+  const char* Stage() const { return m_stage ? m_stage : "unavailable"; }
+  const char* FirstFailure() const { return m_failure ? m_failure : "none"; }
+private:
+  std::array<uint64_t, 24> m_lines{};
+  std::array<bool, 24> m_progressLines{};
+  size_t m_progress{};
+  bool m_reserveProgress{};
+  size_t m_head{}, m_size{};
+  uint64_t m_lastNow{}, m_suppressed{}, m_truncated{};
+  uint64_t m_stream{}, m_picture{}, m_revision{}, m_policy{};
+  uint64_t m_waitStart{}, m_lastWait{};
+  const char* m_stage{}, *m_failure{}; // Static labels only.
+  bool m_requested{}, m_paused{}, m_presented{}, m_firstFailure{}, m_ended{}, m_waited{};
+};
+
+// Count distinct frame transactions, independently of log admission.
+struct DiagnosticFrames
+{
+  std::array<uint64_t, 3> identity{};
+  uint64_t count{}, changes{};
+  uint32_t crc{};
+  void Observe(std::array<uint64_t, 3> frame, uint32_t fingerprint)
+  {
+    if (!frame[0] || !frame[1] || frame == identity) return;
+    if (count && fingerprint != crc) ++changes;
+    identity=frame; crc=fingerprint; ++count;
+  }
+};
+
+class DiagnosticInterval
+{
+public:
+  bool Due(uint64_t now) const
+  {
+    return !m_reported || (now>=m_last && now-m_last>=5000);
+  }
+  void Emitted(uint64_t now) { m_reported=true; m_last=now; }
+private:
+  uint64_t m_last{};
+  bool m_reported{};
+};
+
+// A bounded first-event/change budget plus a 30-second summary. Alternating
+// failures/recoveries cannot reset the budget and turn this into per-frame IO.
+class DiagnosticFailures
+{
+public:
+  bool Record(uint64_t now, const char* stage = "failure", int error = 0)
+  {
+    ++m_count;
+    if (!m_consecutive) m_firstConsecutive=now;
+    ++m_consecutive;
+    const bool changed = stage != m_stage || error != m_error;
+    m_stage = stage;
+    m_error = error;
+    if (!m_reported || now - m_window >= 30000)
+    {
+      m_window = now;
+      m_reports = 0;
+    }
+    if ((!m_reported || changed || now - m_last >= 30000) && m_reports < 4)
+    {
+      m_reported = true;
+      ++m_reports;
+      m_last = now;
+      return true;
+    }
+    return false;
+  }
+  bool Recovered(uint64_t now)
+  {
+    if (!m_consecutive)
+      return false;
+    m_consecutive = 0;
+    ++m_recoveries;
+    if (m_recoveries == 1 || now - m_lastRecovery >= 30000)
+    {
+      m_lastRecovery = now;
+      return true;
+    }
+    return false;
+  }
+  uint64_t Count() const { return m_count; }
+  uint64_t Recoveries() const { return m_recoveries; }
+  bool ReferenceDue(uint64_t now,bool eligible)
+  {
+    if (!eligible || !m_consecutive) { m_firstConsecutive=now; return false; }
+    if (m_referenceWarned || m_consecutive<30 || now<m_firstConsecutive ||
+        now-m_firstConsecutive<5000) return false;
+    m_referenceWarned=true;
+    return true;
+  }
+  void Reset() { *this = {}; }
+
+private:
+  uint64_t m_count{0}, m_consecutive{0}, m_recoveries{0};
+  uint64_t m_window{0}, m_last{0}, m_lastRecovery{0};
+  unsigned m_reports{0};
+  const char* m_stage{nullptr}; // Callers pass static stage labels.
+  int m_error{0};
+  bool m_reported{false};
+  uint64_t m_firstConsecutive{};
+  bool m_referenceWarned{};
+};
+} // namespace DVBRIDGE
diff --git a/xbmc/utils/DVBridgeEdid.h b/xbmc/utils/DVBridgeEdid.h
new file mode 100644
index 0000000000..c919789d72
--- /dev/null
+++ b/xbmc/utils/DVBridgeEdid.h
@@ -0,0 +1,164 @@
+/* SPDX-License-Identifier: MIT */
+/* Shared, side-effect-free Standard-DV eligibility. The kernel and player
+ * copies must remain identical (checked by the source tests). This only
+ * parses public display capabilities; it does not alter EDID or movie data.
+ */
+#ifndef DVBRIDGE_EDID_H
+#define DVBRIDGE_EDID_H
+#ifdef __KERNEL__
+#include <linux/types.h>
+#else
+#include <stdbool.h>
+#include <stddef.h>
+#endif
+
+enum dvbridge_edid_status {
+	DV_EDID_ABSENT, DV_EDID_INVALID, DV_EDID_NO_DV, DV_EDID_DUPLICATE,
+	DV_EDID_VERSION, DV_EDID_LENGTH, DV_EDID_LLDV_ONLY, DV_EDID_STANDARD
+};
+
+struct dvbridge_sink_caps {
+	enum dvbridge_edid_status status;
+	unsigned int version, offset, length;
+	bool legacy_vsif, supports_2160p60, lldv_422;
+	unsigned int lldv_444_bits;
+	bool lldv_422_12;
+};
+
+static inline const char *dvbridge_edid_reason(enum dvbridge_edid_status status)
+{
+	switch (status) {
+	case DV_EDID_ABSENT: return "edid-unavailable";
+	case DV_EDID_INVALID: return "edid-invalid";
+	case DV_EDID_NO_DV: return "no-dv-block";
+	case DV_EDID_DUPLICATE: return "multiple-dv-blocks";
+	case DV_EDID_VERSION: return "unknown-dv-version";
+	case DV_EDID_LENGTH: return "invalid-dv-block-length";
+	case DV_EDID_LLDV_ONLY: return "no-standard-dv-interface";
+	case DV_EDID_STANDARD: return "standard-dv";
+	}
+	return "unknown";
+}
+
+/* Capabilities are usable only after parsing the complete EDID. */
+static inline bool dvbridge_lldv_422(struct dvbridge_sink_caps caps)
+{
+	return (caps.status == DV_EDID_STANDARD || caps.status == DV_EDID_LLDV_ONLY) && caps.lldv_422;
+}
+
+static inline bool dvbridge_lldv_422_12(struct dvbridge_sink_caps caps)
+{
+	return dvbridge_lldv_422(caps) && caps.lldv_422_12;
+}
+
+static inline unsigned int dvbridge_lldv_444_bits(struct dvbridge_sink_caps caps)
+{
+	return dvbridge_lldv_422(caps) ? caps.lldv_444_bits : 0;
+}
+
+static inline struct dvbridge_sink_caps
+dvbridge_parse_edid(const unsigned char *edid, size_t size)
+{
+	static const unsigned char magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
+	struct dvbridge_sink_caps result = {DV_EDID_ABSENT, 0, 0, 0, false, false, false, 0, false};
+	unsigned int block, i, blocks, found = 0;
+
+	if (!edid || !size)
+		return result;
+	result.status = DV_EDID_INVALID;
+	if (size < 128 || size % 128 || size > 256 * 128)
+		return result;
+	for (i = 0; i < 8; i++)
+		if (edid[i] != magic[i])
+			return result;
+	/* Check every block before interpreting any capability. */
+	for (block = 0; block < size / 128; block++) {
+		unsigned char sum = 0;
+		for (i = 0; i < 128; i++)
+			sum += edid[block * 128 + i];
+		if (sum)
+			return result;
+	}
+	blocks = edid[126] + 1;
+	if (edid[126] && size >= 256) {
+		const unsigned char *cta = edid + 128;
+		/* HDMI Forum EEODB occupies bytes 4..6 of the first CTA extension. */
+		if (cta[0] == 2 && cta[1] >= 3 && cta[2] >= 7 && cta[2] <= 127 &&
+		    cta[4] == 0xe2 && cta[5] == 0x78 && cta[6])
+			blocks = cta[6] + 1;
+	}
+	if (size != (size_t)blocks * 128)
+		return result;
+	result.status = DV_EDID_NO_DV;
+	for (block = 1; block < blocks; block++) {
+		const unsigned char *b = edid + block * 128;
+		unsigned int end = b[2], pos;
+
+		if (b[0] != 2 || b[1] < 3 || !end)
+			continue;
+		if (end < 4 || end > 127) {
+			result.status = DV_EDID_INVALID;
+			return result;
+		}
+		for (pos = 4; pos < end;) {
+			unsigned int len = b[pos] & 31;
+			const unsigned char *data = b + pos + 1;
+
+			if (pos + len + 1 > end) {
+				result.status = DV_EDID_INVALID;
+				return result;
+			}
+			if ((b[pos] >> 5) == 7 && len >= 4 && data[0] == 1 &&
+			    data[1] == 0x46 && data[2] == 0xd0 && data[3] == 0) {
+				if (++found != 1) {
+					result.status = DV_EDID_DUPLICATE;
+					return result;
+				}
+				result.offset = block * 128 + pos + 1;
+				result.length = len;
+				result.status = DV_EDID_LENGTH;
+				if (len < 5)
+					return result;
+				result.version = data[4] >> 5;
+				switch (result.version) {
+				case 0:
+					if (len != 21)
+						return result;
+					result.legacy_vsif = true;
+					result.supports_2160p60 = (data[4] & 2) != 0;
+					break;
+				case 1:
+					if (len != 11 && len != 14)
+						return result;
+					/* Long V1 and short V1 without LL use HDMI-1.4b
+					 * signaling, not the modern Dolby-OUI packet. */
+					result.lldv_422 = len == 11 && (data[7] & 1);
+					result.legacy_vsif = !result.lldv_422;
+					result.supports_2160p60 = (data[4] & 2) != 0;
+					break;
+				case 2:
+					if (len < 11)
+						return result;
+					/* V2 includes LL 4:2:2. Its 4:4:4 variant also needs the
+					 * Low Latency HDMI interface bit and a defined depth. */
+					result.lldv_422 = true;
+					if (data[6] & 1) {
+						unsigned int depth = ((data[7] & 1) << 1) | (data[8] & 1);
+						result.lldv_444_bits = depth == 1 ? 10 : depth == 2 ? 12 : 0;
+					}
+					result.supports_2160p60 = true;
+					break;
+				default:
+					result.status = DV_EDID_VERSION;
+					return result;
+				}
+				result.lldv_422_12 = (data[4] & 1) != 0;
+				result.status = result.version == 2 && (data[6] & 3) < 2 ?
+					DV_EDID_LLDV_ONLY : DV_EDID_STANDARD;
+			}
+			pos += len + 1;
+		}
+	}
+	return result;
+}
+#endif
