 CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::GetPicture(VideoPicture* pVideoPicture)
+{
+#ifdef HAVE_DVBRIDGE
+  if (m_dvFel)
+  {
+    for (;;)
+    {
+      auto emit = [&]() -> VCReturn
+      {
+        while (!m_dvPending.empty())
+        {
+          auto& base = m_dvPending.front();
+          if (base->doviSourcePts == AV_NOPTS_VALUE)
+            return VC_FATAL;
+          AVFrame* enhancement = nullptr;
+          const auto& metadata = base->doviMetadata;
+          const bool ownRpu = metadata.Binding() == base->doviSourceBinding &&
+              (base->doviSourceInfo.frameRpu ||
+               ((m_hints.codecOptions & CODEC_BLURAY_NAVIGATION) && m_dvLayerEpoch));
+          const int result = ownRpu ?
+              dvbridge_fel_take_mel(m_dvFel.get(), base->doviSourcePts, &enhancement,
+                                   metadata.Data(), metadata.Size()) :
+              dvbridge_fel_take(m_dvFel.get(), base->doviSourcePts, &enhancement);
+          if (result == 2)
+          {
+            m_dvPending.pop_front();
+            continue;
+          }
+          if (result < 0)
+          {
+            CLog::Log(LOGERROR, "DV FEL: cannot pair {} pending base pictures; stopping without substitution",
+                      m_dvPending.size());
+            return VC_FATAL;
+          }
+          if (!result)
+            return VC_NONE;
+          if (m_dvLayerEpoch && (!base->doviMetadata.Data() ||
+              !(base->doviMetadata.Binding() == base->doviSourceBinding)))
+          {
+            av_frame_free(&enhancement);
+            return VC_FATAL;
+          }
+          if (result == 1)
+          {
+            ReportDVStartup(4, "el-decoded");
+#ifdef HAVE_LIBVA
+            if (base->iFlags & DVP_FLAG_DROPPED)
+            {
+              // Preroll bypasses the renderer's normal EL completion check. Consume
+              // its decode report before retiring the image, as Kodi does for BL.
+              const auto* frames = enhancement->hw_frames_ctx ?
+                  reinterpret_cast<const AVHWFramesContext*>(enhancement->hw_frames_ctx->data) : nullptr;
+              const auto* device = frames ?
+                  reinterpret_cast<const AVVAAPIDeviceContext*>(frames->device_ctx->hwctx) : nullptr;
+              if (!device || vaSyncSurface(device->display,
+                  static_cast<VASurfaceID>(reinterpret_cast<uintptr_t>(enhancement->data[3]))) != VA_STATUS_SUCCESS)
+              {
+                CLog::Log(LOGERROR, "DV FEL: discarded picture decode did not complete at {}",
+                          base->doviSourcePts);
+                av_frame_free(&enhancement);
+                return VC_FATAL;
+              }
+            }
+#endif
+            base->doviEnhancement = {enhancement, [](AVFrame* f) { av_frame_free(&f); }};
+            // The pairing owner consumed the exact EL from this stream/reset epoch.
+            base->doviEnhancementBinding = base->doviMetadata.Binding();
+          }
+          if (m_hints.preferHybridHDR10Plus)
+          {
+            m_dvPending.pop_front(); // Still probing: this was preroll or an invalid base.
+            continue;
+          }
+          pVideoPicture->CopyRef(*base);
+          m_dvPending.pop_front();
+          ReportDVStartup(8, result == 3 ? "mel-metadata-only" : "fel-paired");
+          return VC_PICTURE;
+        }
+        return VC_NONE;
+      };
+      VCReturn paired = emit();
+      if (paired == VC_FATAL)
+        break;
+      if (paired != VC_NONE)
+        return paired;
+      if (m_dvFailed || dvbridge_fel_failed(m_dvFel.get()))
+        break;
+      if (m_codecControlFlags & DVD_CODEC_CTRL_POLL)
+        return VC_BUFFER;
+      if (m_dvPending.size() >= DVEnhancementPendingPictures)
+        break;
+      auto base = std::make_shared<VideoPicture>();
+      base->Reset();
+      VCReturn result = GetBasePicture(base.get());
+      if (result == VC_PICTURE && base->hdrType == StreamHdrType::HDR_TYPE_HDR10PLUS &&
+          base->sourceSideData && base->sourceSideData->HDR10PlusIsPrimary())
+      {
+        // The first presentable BL selected authored HDR10+. Any older unpaired
+        // pictures preceded that decision (preroll or invalid input).
+        m_dvPending.clear();
+        m_dvFel.reset();
+        pVideoPicture->CopyRef(*base);
+        return VC_PICTURE;
+      }
+      if (result == VC_FATAL && m_hints.preferHybridHDR10Plus)
+        return result; // Failure decoding the base itself.
+      if (m_pCodecContext->hw_frames_ctx)
+      {
+        auto* frames = reinterpret_cast<AVHWFramesContext*>(m_pCodecContext->hw_frames_ctx->data);
+        if (!dvbridge_fel_device(m_dvFel.get(), frames->device_ref))
+          break;
+      }
+      if (result == VC_PICTURE)
+      {
+        ReportDVStartup(1, "base-decoded");
+        m_dvPending.push_back(std::move(base));
+      }
+      // Classify the last decoded BL before closing the enhancement stream.
+      paired = emit();
+      if (paired == VC_FATAL)
+        break;
+      if (paired != VC_NONE)
+        return paired;
+      if (result == VC_EOF || ((m_codecControlFlags & DVD_CODEC_CTRL_DRAIN) &&
+          ((m_hints.codecOptions & CODEC_BLURAY_NAVIGATION) || m_dvLayerEpoch ||
+           dvbridge_fel_has_enhancement(m_dvFel.get()))))
+      {
+        const char* reason = nullptr;
+        if (!dvbridge_fel_drain(m_dvFel.get(), &reason))
+        {
+          if (reason && !m_hints.preferHybridHDR10Plus)
+            CLog::Log(LOGERROR, "DV FEL: {}; choose Kodi Default to play the Profile 7 HDR10 base", reason);
+          break;
+        }
+        paired = emit();
+        if (paired == VC_FATAL)
+          break;
+        if (paired != VC_NONE)
+          return paired;
+      }
+      if (result == VC_EOF && !m_dvPending.empty())
+        break;
+      if (result == VC_PICTURE && (m_codecControlFlags & DVD_CODEC_CTRL_DRAIN))
+        continue; // Retire internal preroll until a real picture or native EOF.
+      return result == VC_PICTURE ? VC_BUFFER : result;
+    }
+    if (!m_hints.preferHybridHDR10Plus)
+      return VC_FATAL;
+    // The optional enhancement failed before a presentable BL proved the source.
+    // Its absence still makes a later Dolby Vision decision fail, including after a seek.
+    m_dvFel.reset();
+    m_dvPending.clear();
+  }
+#endif
+  auto result = GetBasePicture(pVideoPicture);
+  while (result == VC_PICTURE && m_hints.preferHybridHDR10Plus)
+  {
+    pVideoPicture->Reset();
+    result = GetBasePicture(pVideoPicture); // Discard unreadable/preroll input until a presentable BL.
+  }
+#ifdef HAVE_DVBRIDGE
+  if (result == VC_PICTURE && NeedsDVEnhancement())
