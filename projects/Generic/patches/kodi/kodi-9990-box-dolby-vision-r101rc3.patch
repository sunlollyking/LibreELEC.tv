diff --git a/xbmc/windowing/gbm/drm/DVBridgeDisplayRoute.h b/xbmc/windowing/gbm/drm/DVBridgeDisplayRoute.h
new file mode 100644
index 0000000000..b929a054d4
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/DVBridgeDisplayRoute.h
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace DVBRIDGE
+{
+namespace DISPLAY_ROUTE
+{
+inline std::string Label(std::string value)
+{
+  const bool truncated = value.size() > 128;
+  value.resize(std::min<size_t>(value.size(), 128));
+  while (!value.empty() && (value.back() == '\n' || value.back() == '\r'))
+    value.pop_back();
+  for (char& c : value)
+    if (c < 33 || c > 126)
+      c = '_';
+  return value.empty() ? "unknown" : value + (truncated ? "[truncated]" : "");
+}
+inline std::string Read(const std::filesystem::path& path)
+{
+  std::ifstream file(path);
+  std::array<char, 129> text{};
+  file.read(text.data(), text.size());
+  return Label({text.data(), static_cast<size_t>(file.gcount())});
+}
+inline std::string LinkName(const std::filesystem::path& path)
+{
+  std::error_code error;
+  const auto target = std::filesystem::read_symlink(path, error);
+  return error ? "unknown" : Label(target.filename().string());
+}
+inline bool Component(const std::string& text)
+{
+  return !text.empty() && text.size() <= 128 &&
+      std::all_of(text.begin(), text.end(), [](unsigned char c) {
+        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+               (c >= '0' && c <= '9') || c == '-' || c == '_';
+      });
+}
+}
+
+// Called only at initialization/selected-link mode events, never a flip/frame.
+// Fixed attributes + <=32 direct connector children; no global/recursive scan,
+// no debugfs, AUX device transactions, shell commands or hardware writes.
+inline std::string ReadDisplayRoute(const std::filesystem::path& sysRoot,
+                                    const std::string& card, const std::string& connector,
+                                    const std::string& type, uint32_t id)
+{
+  using namespace DISPLAY_ROUTE;
+  std::string result = "connector=" + Label(connector) + " type=" + Label(type) +
+      " id=" + std::to_string(id) + " card=" + Label(card);
+  const bool valid = card.starts_with("card") && card.size() > 4 &&
+      std::all_of(card.begin() + 4, card.end(), [](char c) { return c >= '0' && c <= '9'; }) &&
+      Component(card) && Component(connector);
+  const auto gpu = sysRoot / "class/drm" / card / "device";
+  result += " gpu_device=" + (valid ? LinkName(gpu) : "unknown");
+  result += " vendor=" + (valid ? Read(gpu / "vendor") : "unknown");
+  result += " device=" + (valid ? Read(gpu / "device") : "unknown");
+  result += " subvendor=" + (valid ? Read(gpu / "subsystem_vendor") : "unknown");
+  result += " subdevice=" + (valid ? Read(gpu / "subsystem_device") : "unknown");
+  result += " driver=" + (valid ? LinkName(gpu / "driver") : "unknown");
+  const auto selected = sysRoot / "class/drm" / (card + "-" + connector);
+  const bool matched = valid && Read(selected / "connector_id") == std::to_string(id);
+  result += " sysfs_connector=" + std::string(matched ? "matched" : "unknown-or-mismatch");
+  result += " status=" + (matched ? Read(selected / "status") : "unknown");
+  result += " enabled=" + (matched ? Read(selected / "enabled") : "unknown");
+  std::vector<std::string> aux;
+  bool limited = false;
+  if (matched)
+  {
+    std::error_code error;
+    std::filesystem::directory_iterator entry(selected, error), end;
+    unsigned int scanned = 0;
+    for (; !error && entry != end && scanned < 32; entry.increment(error), ++scanned)
+    {
+      const auto name = entry->path().filename().string();
+      if (name.starts_with("drm_dp_aux") && Component(name))
+      {
+        if (aux.size() < 4)
+          aux.push_back(Label(name) + ":" + Read(entry->path() / "name"));
+        else
+          limited = true;
+      }
+    }
+    limited |= error || entry != end;
+  }
+  std::sort(aux.begin(), aux.end());
+  result += " aux=";
+  if (aux.empty())
+    result += "unknown";
+  for (size_t i = 0; i < aux.size(); ++i)
+    result += (i ? "," : "") + aux[i];
+  if (limited)
+    result += "[incomplete]";
+  // A DRM HDMI label or AUX name does not prove physical/native HDMI or a
+  // converter model. Boot kernel evidence is forwarded separately, unscoped.
+  return result + " converter=unknown native_hdmi=unknown";
+}
+class DisplayRouteChanges
+{
+public:
+  bool Report(uint64_t now, const std::string& snapshot)
+  {
+    if (m_reported && snapshot == m_last)
+      return false;
+    if (!m_reported || now < m_window || now - m_window >= 30000)
+    {
+      m_window = now;
+      m_reports = 0;
+    }
+    if (m_reports >= 4)
+      return false;
+    ++m_reports;
+    m_reported = true;
+    m_last = snapshot;
+    return true;
+  }
+private:
+  std::string m_last;
+  uint64_t m_window{};
+  unsigned int m_reports{};
+  bool m_reported{};
+};
+}
diff --git a/xbmc/windowing/gbm/drm/DVBridgeKernelLogReader.h b/xbmc/windowing/gbm/drm/DVBridgeKernelLogReader.h
new file mode 100644
index 0000000000..1772f8ce06
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/DVBridgeKernelLogReader.h
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include "utils/DVBridgeKernelLog.h"
+#include "utils/log.h"
+#include "ServiceBroker.h"
+#include "jobs/JobManager.h"
+
+#include <array>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <mutex>
+#include <thread>
+#include <fcntl.h>
+#include <time.h>
+#include <unistd.h>
+
+namespace DVBRIDGE
+{
+// Used only by a Kodi background job after a rate-limited DV output failure
+// or selected-route change/initialization.
+// Read-only, nonblocking and bounded. No external process, new service or GPU work.
+class KernelLogReader
+{
+public:
+  ~KernelLogReader()
+  {
+    if (m_fd >= 0)
+      close(m_fd);
+  }
+
+  // True means the independent cursor still has work; callers may run a small
+  // bounded continuation after yielding. Never blocks the render thread.
+  bool Collect()
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_filter.BeginCollection();
+    if (m_fd < 0)
+    {
+      m_fd = open("/dev/kmsg", O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+      if (m_fd < 0)
+      {
+        const int error = errno;
+        if (!m_warned)
+          CLog::Log(LOGWARNING, "DVBridge kernel coverage: complete=false reason=open-error error={} interval=unavailable", error);
+        m_warned = true;
+        return false;
+      }
+    }
+    timespec now{};
+    if (clock_gettime(CLOCK_MONOTONIC, &now) != 0)
+    {
+      const int error = errno;
+      if (!m_warned)
+        CLog::Log(LOGWARNING, "DVBridge kernel coverage: complete=false reason=clock-error error={} interval=unavailable", error);
+      m_warned = true;
+      return false;
+    }
+    const uint64_t nowUs = uint64_t(now.tv_sec) * 1000000 + now.tv_nsec / 1000;
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(50);
+    std::array<char, 16384> buffer{};
+    // The output budget spans continuation batches, not just one read call.
+    if (!m_window || nowUs - m_window >= 30000000)
+    {
+      m_window = nowUs;
+      m_copied = 0;
+      m_notices = 0;
+    }
+    unsigned int suppressed = 0, overruns = 0, matched = 0;
+    bool continuation = true, complete = false;
+    int error = 0;
+    const char* reason = "scan-limit";
+    for (unsigned int records = 0; records < 4096; ++records)
+    {
+      if (std::chrono::steady_clock::now() >= deadline)
+        break;
+      const auto count = read(m_fd, buffer.data(), buffer.size());
+      if (count < 0)
+      {
+        const int readError = errno;
+        if (readError == EPIPE) { ++overruns; continue; }
+        if (readError == EINTR) continue;
+        complete = readError == EAGAIN;
+        reason = complete ? "cursor-drained" : "read-error";
+        error = complete ? 0 : readError;
+        continuation = false;
+        break;
+      }
+      if (!count) { complete = true; continuation = false; reason = "cursor-eof"; break; }
+      const auto message = m_filter.Accept({buffer.data(), static_cast<size_t>(count)}, nowUs);
+      if (!message)
+        continue;
+      ++matched;
+      if (m_copied < 8)
+      {
+        const auto level = message->find(" route_evidence=kernel-unscoped ") != std::string::npos
+                               ? LOGINFO : LOGERROR;
+        CLog::Log(level, "DVBridge kernel: {}", *message);
+        ++m_copied;
+      }
+      else
+        ++suppressed;
+    }
+    complete = complete && !overruns && !suppressed && !m_filter.Incomplete();
+    if (m_notices++ < 2)
+      CLog::Log(LOGWARNING,
+          "DVBridge kernel coverage: complete={} reason={} error={} requested_from_boot_us={} to_boot_us={} matched={} ring_overruns={} suppressed={} filter_incomplete={} coverage_scope=retained-cursor history_before_cursor=unknown route_evidence_may_precede_interval=true",
+          complete, reason, error ? std::to_string(error) : "unavailable",
+          nowUs > 60000000 ? nowUs - 60000000 : 0, nowUs, matched, overruns, suppressed,
+          m_filter.Incomplete());
+    return continuation;
+  }
+
+private:
+  std::mutex m_mutex;
+  KernelLogFilter m_filter;
+  int m_fd{-1};
+  bool m_warned{false};
+  uint64_t m_window{0};
+  unsigned m_copied{0}, m_notices{0};
+};
+
+// One cursor/job/output budget shared by route initialization and failures.
+// Keep all kmsg IO off Kodi's render thread, with the existing batch limits.
+inline void CollectKernelLog()
+{
+  static std::atomic<bool> pending{false};
+  auto jobs = CServiceBroker::GetJobManager();
+  if (!jobs || pending.exchange(true))
+    return;
+  try
+  {
+    jobs->Submit([] {
+      try
+      {
+        static KernelLogReader reader;
+        for (unsigned pass = 0; pass < 3 && reader.Collect(); ++pass)
+          std::this_thread::sleep_for(std::chrono::milliseconds(10));
+      }
+      catch (...) {}
+      pending.store(false);
+    });
+  }
+  catch (...) { pending.store(false); }
+}
+}
