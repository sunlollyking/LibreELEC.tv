From 9f717414febf099d7d452a6331d5c231556ae927 Mon Sep 17 00:00:00 2001
From: CroqueMr <CroqueMr@users.noreply.github.com>
Date: Wed, 7 Oct 2026 08:25:35 +0100
Subject: [PATCH] kodi-9993-fel-presentation-pairing

From CroqueMr/libreelec-x86-DV R1.0.0-Beta1 (kodi-9993-fel-presentation-pairing.patch).
---
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp   | 15 +++++++
 .../VideoPlayer/DVDDemuxers/CMakeLists.txt    |  3 ++
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 39 +++++++++++++++++++
 3 files changed, 57 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index be98a8d1ba..0f38caa3a1 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -721,8 +721,23 @@ CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::GetPicture(VideoPicture* pVideoPi
       AVFrame* enhancement = nullptr;
       int result = dvbridge_fel_take(m_dvFel.get(), base->doviSourcePts,
                                      &enhancement);
+      if (result == 2)
+      {
+        m_dvPending.pop_front();
+        return VC_BUFFER;
+      }
       if (result < 0)
+      {
+        if (dvbridge_fel_exhausted(m_dvFel.get()))
+        {
+          CLog::Log(LOGWARNING, "DV FEL: enhancement EOF with {} unpaired base pictures; "
+                               "ending video without substituting enhancement frames",
+                    m_dvPending.size());
+          m_dvPending.clear();
+          return VC_EOF;
+        }
         return VC_ERROR;
+      }
       if (!result)
         return VC_NONE;
       base->doviEnhancement = {enhancement, [](AVFrame* f) { av_frame_free(&f); }};
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/CMakeLists.txt b/xbmc/cores/VideoPlayer/DVDDemuxers/CMakeLists.txt
index 9a16cd320c..09798c3bd8 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/CMakeLists.txt
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/CMakeLists.txt
@@ -34,3 +34,6 @@ set(HEADERS DemuxMultiSource.h
             DVDFactoryDemuxer.h)
 
 core_add_library(dvddemuxers)
+if(ENABLE_DVBRIDGE)
+  target_include_directories(dvddemuxers PRIVATE "${DVBRIDGE_SOURCE_DIR}")
+endif()
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index e3cc4b2ba8..2810175f56 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -9,6 +9,14 @@
 #include "DVDDemuxFFmpeg.h"
 
 #include "DVDDemuxUtils.h"
+#ifdef HAVE_DVBRIDGE
+#include "cores/VideoPlayer/DVDStreamInfo.h"
+#include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h"
+extern "C"
+{
+#include "dvbridge_fel_seek.h"
+}
+#endif
 #include "DVDInputStreams/DVDInputStream.h"
 #ifdef HAVE_LIBBLURAY
 #include "DVDInputStreams/DVDInputStreamBluray.h"
@@ -1410,8 +1418,39 @@ bool CDVDDemuxFFmpeg::SeekTime(double time, bool backwards, double* startpts)
       ret = -1;
     }
     else
+    {
+#ifdef HAVE_DVBRIDGE
+      // Preserve the requested startpts while seeking to a shared layer anchor.
+      if (!m_checkTransportStream && m_seekStream == -1)
+      {
+        for (const auto& [id, stream] : m_streams)
+        {
+          if (stream->type != StreamType::VIDEO || id < 0 ||
+              static_cast<unsigned>(id) >= m_pFormatContext->nb_streams)
+            continue;
+          CDVDStreamInfo hints(*stream);
+          if (hints.dovi.dv_profile != 7 || !hints.dovi.el_present_flag ||
+              !DVBRIDGE::RetainsDVSource(hints))
+            continue;
+          AVStream* video = m_pFormatContext->streams[id];
+          const int64_t target = av_rescale_q(seek_pts, AV_TIME_BASE_Q, video->time_base);
+          const int64_t anchor = dvbridge_fel_seek_point(m_pFormatContext, id, target);
+          if (anchor != AV_NOPTS_VALUE)
+          {
+            seek_pts = av_rescale_q(anchor, video->time_base, AV_TIME_BASE_Q);
+            backwards = true;
+            CLog::Log(LOGDEBUG, "DV FEL: random-access preroll begins at {} us for {} ms seek",
+                      seek_pts, time);
+          }
+          else
+            CLog::Log(LOGWARNING, "DV FEL: no common random-access point in bounded seek probe");
+          break;
+        }
+      }
+#endif
       ret = av_seek_frame(m_pFormatContext, m_seekStream, seek_pts,
                           backwards ? AVSEEK_FLAG_BACKWARD : 0);
+    }
 
     if (ret < 0)
     {
-- 
