From c215faa69ba83269793d9b7da388e627c26a77aa Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Mon, 2 Nov 2026 16:52:50 +0000
Subject: [PATCH 2/2] [guilib] Stop a video control redrawing the screen when
 nothing plays

Since a3d2a97305 a video control marks itself dirty every frame unless
video has its own plane, and with nothing playing it has none, so a skin
that keeps one visible on an idle screen redraws that screen every
frame. Only do it while something is playing, as the check before that
change did.
---
 xbmc/guilib/GUIVideoControl.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xbmc/guilib/GUIVideoControl.cpp b/xbmc/guilib/GUIVideoControl.cpp
index 2e92b599d5..5e7b363312 100644
--- a/xbmc/guilib/GUIVideoControl.cpp
+++ b/xbmc/guilib/GUIVideoControl.cpp
@@ -38,7 +38,7 @@ void CGUIVideoControl::Process(unsigned int currentTime, CDirtyRegionList &dirty
   const auto appPlayer = components.GetComponent<CApplicationPlayer>();
   // Only fire for single-plane renderers where video draws via the GUI walk.
   // See CGUIWindowFullScreen::Process for full rationale.
-  if (!appPlayer->IsRenderingVideoLayer())
+  if (appPlayer->IsPlaying() && !appPlayer->IsRenderingVideoLayer())
     MarkDirtyRegion();
 
   CGUIControl::Process(currentTime, dirtyregions);
-- 
2.53.0

