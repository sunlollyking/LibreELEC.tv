+void CDVBridgeGLES::DebugTransport(unsigned framebuffer, int width, int height, bool flipY) noexcept try
+{
+  m_submission.debugSample = 0;
+  if (!DVBRIDGE::DiagnosticsEnabled() || !DVBRIDGE::DebugDiagnosticsEnabled() || !m_live || m_hdr10)
+    return;
+  const auto sample=m_debugProbe.Due(DVBRIDGE::DiagnosticNowMs(),m_pendingBinding.stream,
+      m_pendingBinding.picture,m_pendingIdentity.revision,m_overlayVisible);
+  if (!sample) return;
+  m_submission.debugSample=sample;
+  const auto* authored=m_advanced && m_dvPolicyActive ? dvbridge_render_dv_policy_output(m_renderer) : nullptr;
+  const auto* candidate=authored ? authored->candidate : dvbridge_render_candidate(m_renderer);
+  unsigned count=0;
+  const auto* words=dvbridge_packets(candidate,&count);
+  const auto started=std::chrono::steady_clock::now();
+  const auto read=DVBRIDGE::ReadDebugCarrier(framebuffer,width,height,flipY,
+      {words,words ? count*128 : 0},count);
+  const double elapsed=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-started).count();
+  const auto& wire=read.carrier;
+  const auto el=m_hardwareFrame.lock();
+  const bool fel=(m_pendingInfo&CDVPlaybackInfo::FEL)!=0;
+  DVBRIDGE::DiagnosticLog(LOGINFO,
+      "CB1 debug render: sample={} source={}/{} cause={} pts={:.6f} mode={} fast={} async={} direct={} osd={} inline={} overlay_revision={} source={}x{} placement={},{},{}x{} el={}x{} el_matches={} vpp={} profile={} fel={}",
+      sample,m_pendingBinding.stream,m_pendingBinding.picture,m_debugProbe.Reason(),m_debugPTS,int(m_effectiveMode),
