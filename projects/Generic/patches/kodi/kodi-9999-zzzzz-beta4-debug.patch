+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <span>
+extern "C" {
+#include <libavutil/crc.h>
+}
+
+namespace DVBRIDGE
+{
+class DebugProbe
+{
+public:
+  unsigned Due(uint64_t now, uint64_t stream, uint64_t picture, uint64_t revision, bool visible)
+  {
+    if (!stream || !picture || stream < m_stream) return 0;
+    if (stream != m_stream) { *this = {}; m_stream = stream; m_revision = revision; m_visible = visible; }
+    if (m_count >= 32 || (m_count && now < m_last)) return 0;
+    if (visible != m_visible || revision != m_revision)
+    {
+      m_reason = visible != m_visible ? "osd-edge" : "source-change";
+      m_pending = true; m_visible = visible; m_revision = revision;
+    }
+    if (m_count && (now - m_last < 500 || (!m_pending && now < m_next))) return 0;
+    const bool follow = !m_count || m_pending;
+    if (!m_count) m_reason = "start";
+    else if (!m_pending) m_reason = m_settling ? "settled" : "periodic";
+    m_next = now + (follow ? 500 : 10000);
+    m_last = now; m_pending = false; m_settling = follow;
+    return ++m_count;
+  }
+  const char* Reason() const { return m_reason; }
+private:
+  uint64_t m_stream{}, m_revision{}, m_last{}, m_next{};
+  unsigned m_count{};
+  bool m_visible{}, m_pending{}, m_settling{};
+  const char* m_reason{"start"};
+};
+
+struct DebugCarrier
+{
+  bool valid{}, l1Known{}, l5Known{};
+  unsigned packets{}, byteErrors{}, crcErrors{}, id{}, refresh{};
+  std::array<unsigned,3> l1{};
+  std::array<unsigned,4> l5{};
+};
+
+inline DebugCarrier DecodeDebugCarrier(std::span<const uint8_t> pixels, unsigned stride,
+    bool flip, std::span<const uint32_t> expected, unsigned count)
+{
+  DebugCarrier out;
+  if (!count || count > 5 || expected.size() < count*128 || stride < 3840*4 ||
+      pixels.size() < size_t(stride)*4) return out;
+  std::array<uint8_t,512> payload{};
+  unsigned size = 0, offset = 0;
+  for (unsigned packet=0;packet<count;++packet) for (unsigned copy=0;copy<3;++copy)
+  {
+    std::array<uint8_t,128> bytes{};
+    for (unsigned bit=0;bit<1024;++bit)
+    {
+      const unsigned index=packet*3072+copy*1024+bit, row=index/3840;
+      const auto* p=pixels.data()+(flip ? 3-row : row)*stride+(index%3840)*4;
+      const unsigned y=(unsigned(p[1])<<4)|(p[2]&15), c=(unsigned(p[0])<<4)|(p[2]>>4);
+      const unsigned value=(c&1)^(std::popcount(y^(c>>1))&1);
+      bytes[bit/8]|=value<<(7-bit%8);
+    }
+    out.crcErrors+=av_crc(av_crc_get_table(AV_CRC_32_IEEE),0xffffffff,bytes.data(),bytes.size())!=0;
+    for (unsigned byte=0;byte<128;++byte) out.byteErrors+=bytes[byte]!=expected[packet*128+byte];
+    if (copy) continue;
+    if (!packet) { size=(unsigned(bytes[3])<<8)|bytes[4]; out.id=bytes[1]; }
+    if (!size || size>payload.size() || offset>size) return out;
+    const unsigned take=std::min(size-offset,packet ? 121u : 119u);
+    std::copy_n(bytes.data()+(packet ? 3 : 5),take,payload.data()+offset);
+    offset+=take;
+  }
+  out.packets=count;
+  if (offset!=size || size<71) return out;
+  out.refresh=payload[1];
+  unsigned at=71;
+  for (unsigned i=0;i<payload[70];++i)
+  {
+    if (at+5>size) return out;
+    const uint32_t n=(uint32_t(payload[at])<<24)|(uint32_t(payload[at+1])<<16)|
+                     (uint32_t(payload[at+2])<<8)|payload[at+3];
+    const unsigned level=payload[at+4]; at+=5;
+    if (n>size-at) return out;
+    if (level==1 && n==6) {
+      for (unsigned j=0;j<3;++j) out.l1[j]=(unsigned(payload[at+j*2])<<8)|payload[at+j*2+1];
+      out.l1Known=true;
+    }
+    if (level==5 && n==8) {
+      for (unsigned j=0;j<4;++j) out.l5[j]=(unsigned(payload[at+j*2])<<8)|payload[at+j*2+1];
+      out.l5Known=true;
+    }
+    at+=n;
+  }
+  out.valid=at==size;
+  return out;
+}
+}
