diff -ruN a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeDebugReadback.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeDebugReadback.h
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeDebugReadback.h	1970-01-01 01:00:00.000000000 +0100
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeDebugReadback.h	2026-10-19 08:40:27.869333506 +0100
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "utils/DVBridgeDebug.h"
+#include <GLES3/gl3.h>
+
+namespace DVBRIDGE
+{
+struct DebugReadback
+{
+  bool read{}, blend{}, dither{}, scissor{};
+  unsigned priorError{}, error{}, status{}, draw{}, encoding{}, writeMask{};
+  std::array<int,4> viewport{};
+  std::array<std::array<unsigned,3>,3> ycc{};
+  DebugCarrier carrier;
+};
+
+inline DebugReadback ReadDebugCarrier(unsigned framebuffer, int width, int height, bool flip,
+    std::span<const uint32_t> expected, unsigned count)
+{
+  DebugReadback out;
+  if (width!=3840 || height!=2160) return out;
+  out.priorError=glGetError();
+  // A lost context cannot safely service an observational readback.
+  if (out.priorError==0x0507) return out; // GL_CONTEXT_LOST, also on GLES 3.0 headers.
+  GLint read=0,buffer=0,alignment=0,row=0,skipPixels=0,skipRows=0,readBuffer=0;
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING,&read);
+  glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING,&buffer);
+  glGetIntegerv(GL_PACK_ALIGNMENT,&alignment); glGetIntegerv(GL_PACK_ROW_LENGTH,&row);
+  glGetIntegerv(GL_PACK_SKIP_PIXELS,&skipPixels); glGetIntegerv(GL_PACK_SKIP_ROWS,&skipRows);
+  GLint draw=0;glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING,&draw);out.draw=draw;
+  glGetIntegerv(GL_VIEWPORT,out.viewport.data());
+  out.blend=glIsEnabled(GL_BLEND);out.dither=glIsEnabled(GL_DITHER);out.scissor=glIsEnabled(GL_SCISSOR_TEST);
+  GLboolean mask[4];glGetBooleanv(GL_COLOR_WRITEMASK,mask);
+  for(unsigned i=0;i<4;++i)if(mask[i])out.writeMask|=1u<<i;
+  glBindFramebuffer(GL_READ_FRAMEBUFFER,framebuffer);
+  glGetIntegerv(GL_READ_BUFFER,&readBuffer);
+  glReadBuffer(framebuffer ? GL_COLOR_ATTACHMENT0 : GL_BACK);
+  out.status=glCheckFramebufferStatus(GL_READ_FRAMEBUFFER);
+  GLint encoding=0;
+  glGetFramebufferAttachmentParameteriv(GL_READ_FRAMEBUFFER,framebuffer ? GL_COLOR_ATTACHMENT0 : GL_BACK,
+      GL_FRAMEBUFFER_ATTACHMENT_COLOR_ENCODING,&encoding);out.encoding=encoding;
+  glBindBuffer(GL_PIXEL_PACK_BUFFER,0);glPixelStorei(GL_PACK_ALIGNMENT,1);
+  glPixelStorei(GL_PACK_ROW_LENGTH,0);glPixelStorei(GL_PACK_SKIP_PIXELS,0);glPixelStorei(GL_PACK_SKIP_ROWS,0);
+  std::array<uint8_t,3840*4*4> pixels{};
+  glReadPixels(0,flip ? height-4 : 0,3840,4,GL_RGBA,GL_UNSIGNED_BYTE,pixels.data());
+  for(unsigned sample=0;sample<3;++sample) {
+    uint8_t pair[8]{};
+    glReadPixels(960+sample*960,height/2,2,1,GL_RGBA,GL_UNSIGNED_BYTE,pair);
+    out.ycc[sample]={(unsigned(pair[1])<<4)|(pair[2]&15),
+        (unsigned(pair[0])<<4)|(pair[2]>>4),(unsigned(pair[4])<<4)|(pair[6]>>4)};
+  }
+  out.error=glGetError();
+  glPixelStorei(GL_PACK_ALIGNMENT,alignment);glPixelStorei(GL_PACK_ROW_LENGTH,row);
+  glPixelStorei(GL_PACK_SKIP_PIXELS,skipPixels);glPixelStorei(GL_PACK_SKIP_ROWS,skipRows);
+  glBindBuffer(GL_PIXEL_PACK_BUFFER,buffer);glReadBuffer(readBuffer);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER,read);
+  out.read=out.status==GL_FRAMEBUFFER_COMPLETE && !out.error;
+  if (out.read) out.carrier=DecodeDebugCarrier(pixels,3840*4,flip,expected,count);
+  return out;
+}
+}
