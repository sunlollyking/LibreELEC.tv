+  }
   auto selectionCapabilities = capabilities;
   {
     const auto masterBinding=picture.doviSourceBinding.Valid() ?
@@ -1943,11 +1950,13 @@
           DVBRIDGE::OutputReason::SourceIneligible : m_dvSelection.reason;
     return false;
   }
