+// Count distinct frame transactions, independently of log admission.
+struct DiagnosticFrames
+{
+  std::array<uint64_t, 3> identity{};
+  uint64_t count{}, changes{};
+  uint32_t crc{};
+  void Observe(std::array<uint64_t, 3> frame, uint32_t fingerprint)
+  {
+    if (!frame[0] || !frame[1] || frame == identity) return;
+    if (count && fingerprint != crc) ++changes;
+    identity=frame; crc=fingerprint; ++count;
+  }
+};
