+
+bool CWinSystemGbmGLContext::HoldCB1Mode(RESOLUTION_INFO& res)
+{
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  const bool eligible = CB1ModeCanJoin(res);
+  if (!eligible || m_dispReset)
+    DVBRIDGE::DiagnosticLog(LOGINFO,
+        "CB1 HDMI transition: join_refused eligible={} reset_pending={} page_pending={} committed={} selected_refresh={:.3f} requested_refresh={:.3f}",
+        eligible, m_dispReset, drm && drm->HasPendingCB1Page(),
+        drm && drm->IsSelectedModeCommitted(),
+        m_DRM ? m_DRM->GetCurrentMode().fRefreshRate : 0.0f, res.fRefreshRate);
+  if (!eligible || m_dispReset || !m_DRM->SetMode(res) ||
+      !m_DRM->SetVideoMode(res,nullptr)) return false;
+  // Admission sees the staged timing. Output telemetry still requires a commit.
+  {
+    const auto status = GetLldvConnectorStatus();
+    std::lock_guard lock(m_dvCapabilityMutex);
+    m_dvLldvStatus = status;
+  }
+  m_modeAnnouncement.Held();
+  DVBRIDGE::DiagnosticLog(LOGINFO,"CB1 HDMI transition: mode_selected={}x{}@{:.3f} commit=deferred",
+      res.iScreenWidth,res.iScreenHeight,res.fRefreshRate);
+  return true;
+}
+
+bool CWinSystemGbmGLContext::HoldCB1Stop()
+{
+  if (!m_dvState.Captured() && !m_hdrConversion) return false;
+  const auto settings=CServiceBroker::GetSettingsComponent()->GetSettings();
+  if (settings->GetInt(CSettings::SETTING_VIDEOPLAYER_ADJUSTREFRESHRATE) == ADJUST_REFRESHRATE_ON_START)
+    return false;
+  auto resolution=CDisplaySettings::GetInstance().GetCurrentResolution();
+  if (resolution < RES_DESKTOP) resolution=RES_DESKTOP;
+  const auto target=CDisplaySettings::GetInstance().GetResolutionInfo(resolution);
+  if (!CB1ModeCanJoin(target)) return false;
+  m_modeHold.Stop(DVBRIDGE::DiagnosticNowMs());
+  return true;
+}
+
+void CWinSystemGbmGLContext::AnnounceCB1Mode(bool transport)
+{
+  if (!m_modeAnnouncement.Before(transport)) return;
+  glFinish();
+  OnLostDevice();
+}
+
+void CWinSystemGbmGLContext::CompleteCB1Mode(bool accepted, bool transport)
+{
+  const bool announced = m_modeAnnouncement.Pending() == CHeldModeAnnouncement::Step::TOLD;
+  m_modeAnnouncement.After(accepted,transport);
+  if (accepted && announced)
+    m_dispResetTimer.Set(std::chrono::milliseconds(
+        std::max(0,CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt("videoscreen.delayrefreshchange"))*100));
+  if (accepted && m_modeHold.Holding() == CModeChangeHold::Kind::START)
+    m_modeHold.Configured();
+}
+
+bool CWinSystemGbmGLContext::Hide()
+{
+  m_modeHold.Cancel(); AnnounceCB1Mode(false);
+  const bool result=CWinSystemGbm::Hide();
+  const auto drm=std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CompleteCB1Mode(drm && drm->LastPageAccepted(),false);
+  return result;
+}
+
+bool CWinSystemGbmGLContext::Show(bool raise)
+{
+  m_modeHold.Cancel(); AnnounceCB1Mode(false);
+  const bool result=CWinSystemGbm::Show(raise);
+  const auto drm=std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CompleteCB1Mode(drm && drm->LastPageAccepted(),false);
+  return result;
+}
+
+bool CWinSystemGbmGLContext::BeginRender()
+{
+#ifdef CB1_HAS_HDR10_AI
+  m_hdr10HandoffPicture.reset();
+#endif
+  // A prepared picture already includes its GUI; wait before drawing it again.
+  if (m_cb1FramePending && m_dvFrame)
+  {
+    if (CServiceBroker::GetGUI()->GetWindowManager().HasDirtyRegions())
+      m_guiCacheValid = false;
+    PresentFrame(false, true);
+    return false;
+  }
+  if (!CRenderSystemGL::BeginRender())
+    return false;
+  BindNativePascalHDRFramebuffer();
   return true;
 }
+#endif
 
 void CWinSystemGbmGLContext::PresentRender(bool rendered, bool videoLayer)
 {
   if (!m_bRenderCreated)
     return;
 
+  PresentFrame(rendered, videoLayer);
+#ifdef HAVE_DVBRIDGE
+  RefreshHDR10LinkDepth();
+  if (m_lldvEdidRefresh.IsTimePast())
+  {
+    m_lldvEdidRefresh.Set(m_dvSelection.route == DVBRIDGE::OutputRoute::PlayerLed ? 1000ms : 3000ms);
+    if (RefreshDisplayInfoForVideo()) RefreshDVOutputCapabilities();
+  }
+#endif
+  if (m_dispReset && m_dispResetTimer.IsTimePast()
+#ifdef HAVE_DVBRIDGE
+      && m_modeAnnouncement.Pending() == CHeldModeAnnouncement::Step::NONE
+      && !HasPendingDVOutputSurface()
+#endif
+      )
+  {
+    m_dispReset = false;
+    CWinSystemGbm::OnResetDisplay();
+  }
+}
+
+void CWinSystemGbmGLContext::PublishVideoSource(
+    bool accepted, const std::shared_ptr<const VideoSourceSideData>& source)
+{
+  if (accepted && source)
+    CServiceBroker::GetDataCacheCore().SetVideoSourceSideData(source->Generation(), source);
